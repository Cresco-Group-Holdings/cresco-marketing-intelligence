# Database (server-only)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cresco_marketing?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cresco_marketing?schema=public"

# Supabase (public values may be exposed via NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_MARKETING_ASSETS_BUCKET="marketing-assets"

# Application
APP_URL="http://localhost:3000"

# Security (server-only)
ENCRYPTION_KEY="generate-a-32-byte-hex-key-for-local-development"

# Provider integration foundation (Task 7.1, server-only)
PROVIDER_ENCRYPTION_KEY=""
PROVIDER_ENCRYPTION_KEY_VERSION="1"
OAUTH_STATE_SIGNING_KEY=""
OAUTH_CALLBACK_BASE_URL=""
WEBHOOK_BASE_URL=""
PROVIDER_CONNECTORS_ENABLED="true"
PROVIDER_LIVE_CALLS_ENABLED="false"
RESEND_PROVIDER_ENABLED="false"
EMAIL_EMERGENCY_SHUTDOWN="false"

# AI providers (server-only, optional during local development)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""

# OAuth integrations (server-only, optional during local development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
PUBLISHING_WORKER_TOKEN=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Social analytics synchronisation (server-only, all optional with safe defaults)
SOCIAL_ANALYTICS_SYNC_ENABLED="true"
SOCIAL_ANALYTICS_SYNC_INTERVAL_MINUTES="360"
SOCIAL_ANALYTICS_SYNC_LEASE_SECONDS="300"
SOCIAL_ANALYTICS_SYNC_RETRY_SECONDS="60"
SOCIAL_ANALYTICS_BACKFILL_DAYS="90"
SOCIAL_ANALYTICS_BACKFILL_MAX_PAGES="20"
SOCIAL_ANALYTICS_SCHEDULER_BATCH="100"
SOCIAL_ANALYTICS_WORKER_BATCH="10"

# Isolated PostgreSQL database used by `npm run test:database` (optional)
ANALYTICS_TEST_DATABASE_URL=""
