{
  "name": "cresco-marketing-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:ci": "npm run validate:routes && npm run validate:vercel-cron && npm run validate:rls-security && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:database": "vitest run --config vitest.database.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:foundation": "playwright test tests/e2e/stage-1-foundation.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:development": "tsx prisma/seed.ts",
    "validate:prisma": "prisma validate",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:vercel-cron": "node scripts/validate-vercel-cron.mjs",
    "validate:rls-security": "node scripts/validate-rls-security.mjs",
    "validate:vercel-build": "node scripts/validate-vercel-build.mjs",
    "measure:build-stages": "node scripts/measure-build-stages.mjs",
    "verify:rls-staging": "node scripts/verify-rls-staging.mjs",
    "audit:public-functions": "node scripts/audit-public-functions.mjs",
    "generate:rls-inventory": "node scripts/generate-rls-inventory.mjs",
    "measure:build-memory": "node scripts/measure-build-memory.mjs",
    "deploy:supabase-email-templates": "node scripts/deploy-supabase-auth-email-templates.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit:secrets": "node scripts/secret-scan.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "file-type": "^16.5.4",
    "lucide-react": "^0.555.0",
    "next": "15.5.22",
    "pdfkit": "^0.19.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.3",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.0.14"
  }
}
