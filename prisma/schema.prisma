  status              ComplianceFindingStatus  @default(OPEN)
  excerpt             String?
  message             String
  explanation         String?
  suggestedCorrection String?
  contentVariantId    String?
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  evaluation ComplianceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rule       ComplianceRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  overrides  ComplianceOverride[]

  @@index([evaluationId, status])
  @@index([riskLevel, isBlocking])
}

model ComplianceOverride {
  id               String    @id @default(cuid())
  organisationId   String
  evaluationId     String
  findingId        String
  policyId         String
  contentItemId    String
  contentVariantId String?
  reason           String
  userId           String
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evaluation   ComplianceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  finding      ComplianceFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  policy       CompliancePolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  user         UserProfile          @relation("ComplianceOverrideUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@index([findingId])
  @@index([contentItemId])
}

