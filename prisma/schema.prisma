  postalCode String?
  country    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  person  CrmPerson?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company CrmCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@index([companyId])
}

model CrmExternalReference {
  id          String   @id @default(cuid())
  leadId      String?
  personId    String?
  companyId   String?
  provider    String
  externalId  String
  externalUrl String?
  metadata    Json?
  createdAt   DateTime @default(now())

