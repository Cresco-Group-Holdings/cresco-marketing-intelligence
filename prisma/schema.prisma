  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem    ContentItem           @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant?       @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  policy         CompliancePolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  evaluator      UserProfile?          @relation("ComplianceEvaluator", fields: [evaluatedByUserId], references: [id], onDelete: SetNull)
  findings       ComplianceFinding[]
  overrides      ComplianceOverride[]

  @@index([organisationId, brandId, contentItemId])
  @@index([contentItemId, createdAt])
  @@index([policyId])
}

model ComplianceFinding {
  id                  String                  @id @default(cuid())
  evaluationId        String
  ruleId              String?
  ruleReference       String?
  source              ComplianceFindingSource
  category            CompliancePolicyCategory
  riskLevel           ComplianceRiskLevel
  isBlocking          Boolean                 @default(false)
  status              ComplianceFindingStatus @default(OPEN)
  excerpt             String?
  message             String
  explanation         String?
  suggestedCorrection String?
  contentVariantId    String?
  metadata            Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  evaluation ComplianceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rule       ComplianceRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  overrides  ComplianceOverride[]

  @@index([evaluationId, status])
  @@index([riskLevel, isBlocking])
}

model ComplianceOverride {
  id               String    @id @default(cuid())
  organisationId   String
  evaluationId     String
  findingId        String
  policyId         String
  contentItemId    String
  contentVariantId String?
  reason           String
  userId           String
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  evaluation   ComplianceEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  finding      ComplianceFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  policy       CompliancePolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  user         UserProfile          @relation("ComplianceOverrideUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([evaluationId])
  @@index([findingId])
  @@index([contentItemId])
}
