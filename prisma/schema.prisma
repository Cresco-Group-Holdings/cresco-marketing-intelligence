  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LIFECYCLE_CHANGED
  PIPELINE_STAGE_CHANGED
  EMAIL_EVENT
  WEBSITE_EVENT
  CONTENT_DOWNLOADED
  DEMO_REQUESTED
  TRIAL_STARTED
  TRIAL_ENDING
  SUBSCRIPTION_STARTED
  PAYMENT_FAILED
  SUBSCRIPTION_CANCELLED
  CUSTOMER_INACTIVE
  DATE_REACHED
  MANUAL_ENROLLMENT
  SCHEDULED_SEGMENT_CHECK
}

enum MarketingAutomationNodeType {
  TRIGGER
  CONDITION
  DELAY
  ACTION
  BRANCH
  GOAL
  EXIT
  END
