  VERIFIED
  PROCESSING
  PROCESSED
  REJECTED
  DEAD_LETTER
  DUPLICATE
}

enum ProviderSyncRunStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
  DEAD_LETTERED
}

enum ProviderSyncDirection {
  IMPORT
  EXPORT
}

enum ProviderSyncTriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
  INITIAL_IMPORT
  RETRY
}

enum ProviderSyncRecordAction {
  CREATED
  UPDATED
  SKIPPED
  FAILED
}

enum ProviderWebhookEndpointStatus {
  PENDING
  ACTIVE
  FAILED
  REVOKED
}

enum ProviderHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum ProviderAuditAction {
  CONNECTION_CREATED
  AUTHORIZATION_STARTED
  AUTHORIZATION_COMPLETED
  AUTHORIZATION_FAILED
  CREDENTIAL_REFRESHED
  CREDENTIAL_REVOKED
  CONNECTION_TESTED
  CONNECTION_DEGRADED
  CONNECTION_RESTORED
  WEBHOOK_RECEIVED
  WEBHOOK_REJECTED
  SYNC_STARTED
  SYNC_COMPLETED
  SYNC_FAILED
  RATE_LIMIT_REACHED
  PROVIDER_DISABLED
  CONFIGURATION_CHANGED
  EMAIL_SEND_ATTEMPTED
  EMAIL_SEND_ACCEPTED
  EMAIL_SEND_REJECTED
  EMAIL_SEND_SIMULATED
  SUPPRESSION_APPLIED
}

enum ProviderCredentialType {
  OAUTH_ACCESS_TOKEN
  OAUTH_REFRESH_TOKEN
  API_KEY
  CLIENT_SECRET
  WEBHOOK_SIGNING_SECRET
  SMTP_PASSWORD
  SERVICE_ACCOUNT_KEY
  BEARER_TOKEN
  BASIC_AUTH
}

enum ProviderCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum ProviderOutboundSendStatus {
  PENDING
  SUBMITTING
  ACCEPTED
  FAILED
  SIMULATED
  DUPLICATE
}

model ProviderConnection {
  id                String                   @id @default(cuid())
  organisationId    String
  projectId         String?
  brandId           String?
  userId            String?
  providerKey       String
  providerVersion   String                   @default("1.0")
  displayName       String?
  category          ProviderCategory
  authType          ProviderAuthType
  environment       ProviderEnvironment      @default(PRODUCTION)
  status            ProviderConnectionStatus @default(DRAFT)
  configuration     Json?
  grantedScopes     String[]                 @default([])
  externalAccountId String?
  externalLabel     String?
  tokenExpiresAt    DateTime?
  lastHealthCheckAt DateTime?
  lastSuccessfulAt  DateTime?
  lastErrorAt       DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  createdByUserId   String?
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  revokedAt         DateTime?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organisation     Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand?                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy        UserProfile?              @relation("ProviderConnectionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  credentials      ProviderCredential[]
  oauthStates      ProviderOAuthState[]
  webhookEndpoints ProviderWebhookEndpoint[]
  webhookEvents    ProviderWebhookEvent[]
  syncCursors      ProviderSyncCursor[]
  syncRuns         ProviderSyncRun[]
  providerAccounts ProviderAccount[]
  rateLimitStates  ProviderRateLimitState[]
  healthStates     ProviderHealthState[]
  auditEvents      ProviderAuditEvent[]
  outboundSends    ProviderOutboundSend[]
  publications     Publication[]

  @@index([organisationId, providerKey])
  @@index([organisationId, status])
  @@index([brandId, providerKey])
  @@index([projectId])
  @@index([providerKey, status])
}

model ProviderCredential {
  id             String                 @id @default(cuid())
  organisationId String
  connectionId   String
  credentialType ProviderCredentialType
  encryptedValue String
  keyVersion     Int                    @default(1)
  fingerprint    String?
  expiresAt      DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, credentialType])
  @@index([connectionId, credentialType])
  @@index([organisationId])
}

model ProviderOAuthState {
  id             String    @id @default(cuid())
  organisationId String
  connectionId   String?
  providerKey    String
  state          String    @unique
  codeVerifier   String?
  nonce          String?
  scopes         String[]  @default([])
  redirectUri    String
  returnUrl      String?
  signedPayload  String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  connection ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organisationId, providerKey])
  @@index([expiresAt])
}

model ProviderWebhookEndpoint {
  id               String                        @id @default(cuid())
  organisationId   String
  connectionId     String
  providerKey      String
  endpointKey      String                        @default("default")
  externalId       String?
  url              String
  secretDigest     String?
  status           ProviderWebhookEndpointStatus @default(PENDING)
  subscribedEvents String[]                      @default([])
  isActive         Boolean                       @default(true)
  lastReceivedAt   DateTime?
  lastVerifiedAt   DateTime?
  metadata         Json?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  connection ProviderConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events     ProviderWebhookEvent[]

  @@unique([connectionId, endpointKey])
  @@index([connectionId])
  @@index([organisationId, providerKey])
}

model ProviderWebhookEvent {
  id              String                     @id @default(cuid())
  organisationId  String
  connectionId    String?
  endpointId      String?
  providerKey     String
  externalEventId String?
  eventType       String?
  status          ProviderWebhookEventStatus @default(RECEIVED)
  payloadDigest   String?
  errorCode       String?
  errorMessage    String?
  receivedAt      DateTime                   @default(now())
  processedAt     DateTime?
  retryCount      Int                        @default(0)
  metadata        Json?

  connection ProviderConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  endpoint   ProviderWebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@unique([providerKey, externalEventId])
  @@index([organisationId, status])
  @@index([connectionId, receivedAt])
}

model ProviderSyncCursor {
  id             String   @id @default(cuid())
  organisationId String
  connectionId   String
  resourceType   String
  cursorValue    String
  metadata       Json?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resourceType])
  @@index([organisationId])
}

model ProviderSyncRun {
  id               String                  @id @default(cuid())
  organisationId   String
  connectionId     String
  capability       String?
  resourceType     String?
  direction        ProviderSyncDirection   @default(IMPORT)
  triggerType      ProviderSyncTriggerType @default(MANUAL)
  status           ProviderSyncRunStatus   @default(PENDING)
  cursor           String?
  checkpoint       Json?
  idempotencyKey   String?
  requestedByUserId String?
  startedAt        DateTime?
  completedAt      DateTime?
  recordsRead      Int                     @default(0)
  recordsWritten   Int                     @default(0)
  recordsSkipped   Int                     @default(0)
  recordsFailed    Int                     @default(0)
  recordsProcessed Int                     @default(0)
  attemptCount     Int                     @default(0)
  nextRetryAt      DateTime?
  errorCode        String?
  errorMessage     String?
  correlationId    String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  connection ProviderConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  records    ProviderSyncRecord[]

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, status])
  @@index([connectionId, capability, status])
  @@index([organisationId, createdAt])
}

model ProviderSyncRecord {
  id                   String                 @id @default(cuid())
  syncRunId            String
  externalResourceType String
  externalResourceId   String
  internalResourceType String?
  internalResourceId   String?
  action               ProviderSyncRecordAction
  checksum             String?
  errorCode            String?
  errorMessage         String?
  processedAt          DateTime               @default(now())

  syncRun ProviderSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId, processedAt])
  @@index([externalResourceType, externalResourceId])
}

model ProviderAccount {
  id               String   @id @default(cuid())
  organisationId   String
  connectionId     String
  externalId       String
  displayName      String
  accountType      String?
  parentExternalId String?
  currency         String?
  timezone         String?
  status           String?
  selected         Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([connectionId, selected])
  @@index([organisationId])
}

model ProviderRateLimitState {
  id             String    @id @default(cuid())
  organisationId String
  connectionId   String
  windowKey      String
  requestCount   Int       @default(0)
  windowStart    DateTime
  windowEnd      DateTime
  limitReachedAt DateTime?
  metadata       Json?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, windowKey])
  @@index([organisationId])
}

model ProviderHealthState {
  id                  String               @id @default(cuid())
  organisationId      String
  connectionId        String
  status              ProviderHealthStatus @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastHealthyAt       DateTime?
  consecutiveFailures Int                  @default(0)
  circuitState        ProviderCircuitState @default(CLOSED)
  errorCode           String?
  errorMessage        String?
  metadata            Json?
  updatedAt           DateTime             @updatedAt
  createdAt           DateTime             @default(now())

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId])
  @@index([organisationId, status])
}

model ProviderAuditEvent {
  id             String              @id @default(cuid())
  organisationId String
  connectionId   String?
  providerKey    String
  action         ProviderAuditAction
  actorUserId    String?
  requestId      String?
  result         String
  errorCode      String?
  metadata       Json?
  createdAt      DateTime            @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection   ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  actor        UserProfile?        @relation("ProviderAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([connectionId, action])
  @@index([providerKey, action])
}

model ProviderFeatureFlag {
  id             String   @id @default(cuid())
  organisationId String
  providerKey    String
  flagKey        String
  enabled        Boolean  @default(false)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, providerKey, flagKey])
  @@index([organisationId, providerKey])
}

model ProviderOutboundSend {
  id                String                   @id @default(cuid())
  organisationId    String
  brandId           String?
  connectionId      String
  providerKey       String
  idempotencyKey    String
  messageType       String?
  status            ProviderOutboundSendStatus @default(PENDING)
  providerMessageId String?
  safeErrorCode     String?
  requestId         String?
  approvalId        String?
  campaignId        String?
  recipientId       String?
  sentAt            DateTime?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([organisationId, connectionId, idempotencyKey])
  @@index([organisationId, providerKey])
  @@index([connectionId, status])
  @@index([providerMessageId])
}
