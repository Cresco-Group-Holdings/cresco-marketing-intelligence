}

model CrmLeadStatusHistory {
  id             String         @id @default(cuid())
  leadId         String
  previousStatus CrmLeadStatus?
  newStatus      CrmLeadStatus
  actorUserId    String?
  reason         String?
  source         String?
  createdAt      DateTime       @default(now())

  lead  CrmLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor UserProfile? @relation("CrmStatusHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model CrmLeadTag {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  color          String?
  createdAt      DateTime @default(now())

