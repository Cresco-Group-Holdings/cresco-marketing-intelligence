  POSITION_BASED
  TIME_DECAY
}

enum DirectTrafficPolicy {
  RETAIN
  IGNORE_WHEN_PRIOR_KNOWN
  SHOW_BOTH
}

enum AttributionTouchpointSource {
  WEBSITE_SESSION
  SOCIAL_POST_CLICK
  PAID_AD_CLICK
  ORGANIC_SEARCH
  EMAIL_CLICK
  REFERRAL
  DEMO_BOOKING
  CRM_ACTIVITY
  DIRECT_VISIT
