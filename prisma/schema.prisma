}

model CrmLeadTagLink {
  id     String @id @default(cuid())
  leadId String
  tagId  String

  lead CrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  CrmLeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
}

model CrmContactMethod {
  id                String                      @id @default(cuid())
  personId          String
  methodType        CrmContactMethodType
  normalisedValue   String
  displayValue      String
  verificationState CrmContactVerificationState @default(UNVERIFIED)
