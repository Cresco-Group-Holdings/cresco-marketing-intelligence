// ---------------------------------------------------------------------------
// Topic clusters and SEO content strategy (Task 4.4)
// ---------------------------------------------------------------------------

enum SeoTopicStatus {
  ACTIVE
  ARCHIVED
}

enum SeoTopicClusterStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  ARCHIVED
}

enum SeoTopicClusterMemberType {
  KEYWORD
  PAGE
  ENTITY
  COMPETITOR_GAP
}

enum SeoContentFormatType {
  PILLAR
  SUPPORTING_ARTICLE
  LANDING_PAGE
  COMPARISON
  GUIDE
  FAQ
  GLOSSARY
  CASE_STUDY
  DOCUMENTATION
  TOOL
  OTHER
}

enum SeoFunnelStage {
  AWARENESS
  CONSIDERATION
  DECISION
  ACTIVATION
  RETENTION
  SUPPORT
  UNSPECIFIED
}

enum SeoRoadmapStatus {
  IDEA
  RESEARCH
  BRIEF_REQUIRED
  BRIEF_READY
  DRAFTING
  REVIEW
  PUBLISH_READY
  PUBLISHED
  REFRESH_REQUIRED
  ARCHIVED
}

enum SeoContentStrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model SeoTopic {
  id             String         @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  slug           String
  description    String?
  funnelStage    SeoFunnelStage @default(UNSPECIFIED)
  status         SeoTopicStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  clusters     SeoTopicCluster[]

  @@unique([brandId, slug])
  @@index([organisationId, brandId, status])
}

model SeoTopicCluster {
  id             String                @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  topicId        String?
  name           String
  slug           String
  description    String?
  status         SeoTopicClusterStatus @default(DRAFT)
  confidence     Float?
  evidence       Json?
  namingSource   String                @default("deterministic")
  isAiSuggested  Boolean               @default(false)
  isConfirmed    Boolean               @default(false)
  confirmedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  topic           SeoTopic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  members         SeoTopicClusterMember[]
  entities        SeoTopicEntity[]
  pillarPages     SeoPillarPage[]
  supportingPages SeoSupportingPage[]
  gapPlans        SeoContentGapPlan[]
  priorityScores  SeoContentPriorityScore[]
  contentBriefs   SeoContentBrief[]

  @@unique([brandId, slug])
  @@index([organisationId, brandId, status])
}

model SeoTopicClusterMember {
  id                  String                    @id @default(cuid())
  organisationId      String
  clusterId           String
  memberType          SeoTopicClusterMemberType
  keywordId           String?
  pageId              String?
  entityId            String?
  contentGapId        String?
  isManuallyConfirmed Boolean                   @default(false)
  isLocked            Boolean                   @default(false)
  confidence          Float?
  evidence            Json?
  addedAt             DateTime                  @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword?       @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  page         SeoCrawlPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)
  entity       SeoTopicEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  contentGap   SeoContentGap?    @relation(fields: [contentGapId], references: [id], onDelete: SetNull)

  @@index([clusterId, memberType])
  @@index([keywordId])
  @@index([pageId])
}

model SeoTopicEntity {
  id             String               @id @default(cuid())
  organisationId String
  brandId        String
  clusterId      String?
  entityType     SeoKeywordEntityType
  canonicalValue String
  source         String               @default("clustering")
  confidence     Float?
  isConfirmed    Boolean              @default(false)
  createdAt      DateTime             @default(now())

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster?        @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  members      SeoTopicClusterMember[]

  @@index([clusterId])
  @@index([organisationId, brandId])
}

model SeoPillarPage {
  id               String              @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  clusterId        String
  formatType       SeoContentFormatType @default(PILLAR)
  title            String
  targetUrl        String?
  existingPageId   String?
  funnelStage      SeoFunnelStage       @default(UNSPECIFIED)
  isManualOverride Boolean              @default(false)
  roadmapStatus    SeoRoadmapStatus     @default(IDEA)
  contentItemId    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation    Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster         SeoTopicCluster      @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  existingPage    SeoCrawlPage?        @relation(fields: [existingPageId], references: [id], onDelete: SetNull)
  contentItem     ContentItem?         @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  supportingPages SeoSupportingPage[]
  priorityScores  SeoContentPriorityScore[]

  @@index([clusterId])
  @@index([organisationId, brandId, roadmapStatus])
}

model SeoSupportingPage {
  id               String              @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  clusterId        String
  pillarPageId     String?
  formatType       SeoContentFormatType @default(SUPPORTING_ARTICLE)
  title            String
  targetUrl        String?
  existingPageId   String?
  funnelStage      SeoFunnelStage       @default(UNSPECIFIED)
  sequenceOrder    Int                  @default(0)
  isManualOverride Boolean              @default(false)
  roadmapStatus    SeoRoadmapStatus     @default(IDEA)
  contentItemId    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  pillarPage   SeoPillarPage?  @relation(fields: [pillarPageId], references: [id], onDelete: SetNull)
  existingPage SeoCrawlPage?   @relation(fields: [existingPageId], references: [id], onDelete: SetNull)
  contentItem  ContentItem?    @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  priorityScores SeoContentPriorityScore[]

  @@index([clusterId, pillarPageId])
  @@index([organisationId, brandId, roadmapStatus])
}

model SeoContentGapPlan {
  id             String              @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  clusterId      String?
  contentGapId   String?
  title          String
  explanation    String?
  formatType     SeoContentFormatType @default(GUIDE)
  funnelStage    SeoFunnelStage       @default(UNSPECIFIED)
  roadmapStatus  SeoRoadmapStatus     @default(IDEA)
  contentItemId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster?     @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  contentGap   SeoContentGap?       @relation(fields: [contentGapId], references: [id], onDelete: SetNull)
  contentItem  ContentItem?         @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  priorityScores SeoContentPriorityScore[]

  @@index([organisationId, brandId, roadmapStatus])
  @@index([clusterId])
}

model SeoContentStrategy {
  id               String                   @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  status           SeoContentStrategyStatus @default(DRAFT)
  currentVersionId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions       SeoContentStrategyVersion[]

  @@unique([brandId, name])
  @@index([organisationId, brandId, status])
}

model SeoContentStrategyVersion {
  id              String   @id @default(cuid())
  organisationId  String
  strategyId      String
  versionNumber   Int
  summary         Json
  clusterSnapshot Json?
  aiProposals     Json?
  isApproved      Boolean  @default(false)
  approvedAt      DateTime?
  createdByUserId String
  createdAt       DateTime @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  strategy     SeoContentStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdBy    UserProfile        @relation("SeoContentStrategyVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([strategyId, versionNumber])
  @@index([strategyId, createdAt])
}

model SeoContentPriorityScore {
  id               String   @id @default(cuid())
  organisationId   String
  brandId          String
  clusterId        String?
  gapPlanId        String?
  pillarPageId     String?
  supportingPageId String?
  scoreVersion     String   @default("1.0")
  totalScore       Float?
  factors          Json
  missingFactors   String[] @default([])
  calculatedAt     DateTime @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster        SeoTopicCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  gapPlan        SeoContentGapPlan? @relation(fields: [gapPlanId], references: [id], onDelete: SetNull)
  pillarPage     SeoPillarPage?     @relation(fields: [pillarPageId], references: [id], onDelete: SetNull)
  supportingPage SeoSupportingPage? @relation(fields: [supportingPageId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, calculatedAt])
  @@index([clusterId])
}

// ---------------------------------------------------------------------------
// AI SEO content brief generator (Task 4.5)
// ---------------------------------------------------------------------------

enum SeoContentBriefStatus {
  DRAFT
  GENERATED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum SeoBriefKeywordRole {
  PRIMARY
  SECONDARY
}

enum SeoBriefApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SeoBriefCommentStatus {
  OPEN
  RESOLVED
}

model SeoContentBrief {
  id               String               @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  workingTitle     String?
  contentType      SeoContentFormatType?
  status           SeoContentBriefStatus @default(DRAFT)
  currentVersionId String?
  primaryKeywordId String?
  clusterId        String?
  targetPageId     String?
  contentItemId    String?
  audience         String?
  offer            String?
  cta              String?
  createdByUserId  String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  archivedAt       DateTime?

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  primaryKeyword SeoKeyword?               @relation("BriefPrimaryKeyword", fields: [primaryKeywordId], references: [id], onDelete: SetNull)
  cluster        SeoTopicCluster?          @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  targetPage     SeoCrawlPage?             @relation("BriefTargetPage", fields: [targetPageId], references: [id], onDelete: SetNull)
  contentItem    ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  createdBy      UserProfile               @relation("SeoContentBriefCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions       SeoContentBriefVersion[]
  keywords       SeoBriefKeyword[]
  questions      SeoBriefQuestion[]
  headings       SeoBriefHeading[]
  competitorEvidence SeoBriefCompetitorEvidence[]
  internalLinks  SeoBriefInternalLink[]
  schemaSuggestions SeoBriefSchemaSuggestion[]
  citationRequirements SeoBriefCitationRequirement[]
  approvals      SeoBriefApproval[]
  comments       SeoBriefComment[]

  @@index([organisationId, brandId, status])
  @@index([clusterId])
}

model SeoContentBriefVersion {
  id              String               @id @default(cuid())
  organisationId  String
  briefId         String
  versionNumber   Int
  status          SeoContentBriefStatus
  structuredOutput Json
  evidenceSummary Json?
  limitations     String?
  aiRequestId     String?
  aiModel         String?
  aiProvider      String?
  changeNote      String?
  createdByUserId String
  createdAt       DateTime             @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  approvals    SeoBriefApproval[]

  @@unique([briefId, versionNumber])
  @@index([briefId, createdAt])
}

model SeoBriefKeyword {
  id             String            @id @default(cuid())
  organisationId String
  briefId        String
  keywordId      String?
  keyword        String
  role           SeoBriefKeywordRole
  intent         SeoKeywordIntentType?
  source         String?
  createdAt      DateTime          @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  seoKeyword   SeoKeyword?   @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  @@index([briefId])
}

model SeoBriefQuestion {
  id             String   @id @default(cuid())
  organisationId String
  briefId        String
  question       String
  priority       Int      @default(0)
  isFaq          Boolean  @default(false)
  evidence       Json?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
}

model SeoBriefHeading {
  id             String   @id @default(cuid())
  organisationId String
  briefId        String
  level          Int
  text           String
  sortOrder      Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId, sortOrder])
}

model SeoBriefCompetitorEvidence {
  id             String   @id @default(cuid())
  organisationId String
  briefId        String
  competitorId   String?
  competitorUrl  String?
  evidenceType   String
  excerpt        String?
  coverageNote   String?
  gapNote        String?
  observedAt     DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
}

model SeoBriefInternalLink {
  id                    String   @id @default(cuid())
  organisationId        String
  briefId               String
  sourcePageId          String?
  destinationPageId     String?
  sourceUrl             String?
  destinationUrl        String?
  suggestedAnchorConcept String
  reason                String
  confidence            Float?
  createdAt             DateTime @default(now())

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief           SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  sourcePage      SeoCrawlPage? @relation("BriefLinkSource", fields: [sourcePageId], references: [id], onDelete: SetNull)
  destinationPage SeoCrawlPage? @relation("BriefLinkDestination", fields: [destinationPageId], references: [id], onDelete: SetNull)

  @@index([briefId])
}

model SeoBriefSchemaSuggestion {
  id             String   @id @default(cuid())
  organisationId String
  briefId        String
  schemaType     String
  rationale      String?
  eligibilityNote String?
  properties     Json?
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
}

model SeoBriefCitationRequirement {
  id             String   @id @default(cuid())
  organisationId String
  briefId        String
  requirement    String
  sourceType     String?
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([briefId])
}

model SeoBriefApproval {
  id                String                   @id @default(cuid())
  organisationId    String
  briefId           String
  versionId         String?
  decision          SeoBriefApprovalDecision @default(PENDING)
  requestedByUserId String
  approverUserId    String?
  decisionNote      String?
  decidedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief       @relation(fields: [briefId], references: [id], onDelete: Cascade)
  version      SeoContentBriefVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  requestedBy  UserProfile           @relation("SeoBriefApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approver     UserProfile?          @relation("SeoBriefApprovalDecider", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([briefId, decision])
}

model SeoBriefComment {
  id               String              @id @default(cuid())
  organisationId   String
  briefId          String
  versionId        String?
  authorUserId     String
  body             String
  status           SeoBriefCommentStatus @default(OPEN)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  author       UserProfile  @relation("SeoBriefCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([briefId, status])
}

// ---------------------------------------------------------------------------
