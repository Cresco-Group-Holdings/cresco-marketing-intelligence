  REVIEWING
  QUALIFIED
  UNQUALIFIED
  CONTACTED
  CONVERTED
  CLOSED
  DELETED
}

enum LeadCreationSource {
  SOCIAL_COMMENT
  SOCIAL_MESSAGE
  SOCIAL_MENTION
  LEAD_FORM
  LANDING_PAGE_FORM
  MANUAL
}

enum LeadQualificationProfile {
  CRESCO_GRANTS_INTELLIGENCE
  CAPITAL_CRESCO_TERMINAL
}

enum LeadConsentState {
  UNKNOWN
  GRANTED
  DENIED
  WITHDRAWN
}

enum LeadRetentionStatus {
  ACTIVE
  SCHEDULED_FOR_DELETION
  DELETED
  SUPPRESSED
}

enum CrmProvider {
  HUBSPOT
  SALESFORCE
  PIPEDRIVE
  CRESCO_INTERNAL
  WEBHOOK
  CSV
  FAKE
}

