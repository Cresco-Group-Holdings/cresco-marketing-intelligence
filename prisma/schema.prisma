generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MARKETER
  ANALYST
  VIEWER
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BrandStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MarketingObjectiveType {
  BRAND_AWARENESS
  WEBSITE_TRAFFIC
  LEAD_GENERATION
  DEMO_BOOKINGS
  TRIAL_SIGNUPS
  PAID_SUBSCRIPTIONS
  COMMUNITY_GROWTH
  EMAIL_LIST_GROWTH
  SEO_GROWTH
  CUSTOMER_RETENTION
}

enum MarketingObjectiveStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum BrandMarketingChannel {
  WEBSITE
  SEO
  GOOGLE_ADS
  LINKEDIN
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  X
  EMAIL

  @@map("MarketingChannel")
}

enum OnboardingStepKey {
  ACCOUNT_PROFILE
  ORGANISATION
  PROJECT
  BRAND
  BRAND_PROFILE
  MARKETING_OBJECTIVES
  CHANNEL_PREFERENCES
  REVIEW
}

enum BrandOfferAvailabilityStatus {
  AVAILABLE
  LIMITED
  COMING_SOON
  DISCONTINUED
}

enum BrandAssetType {
  LOGO
  FAVICON
  COLOUR_PALETTE
  FONT
  SCREENSHOT
  PRODUCT_IMAGE
  PRESENTATION
  VIDEO_CLIP
}

enum BrandReferenceType {
  STYLE_GUIDE
  DOCUMENTATION
  EXTERNAL_LINK
  RESEARCH
  OTHER
}

enum BrandComplianceRuleType {
  PROHIBITED_CLAIM
  REQUIRED_DISCLAIMER
  GRANT_ELIGIBILITY
  PRIVACY
  REGULATED_MARKET
  CONTENT_APPROVAL
  OTHER
}

enum BrandComplianceSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MarketingAssetStatus {
  PROCESSING
  READY
  REJECTED
  ARCHIVED
}

enum MarketingAssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum AIProviderName {
  OPENAI
  ANTHROPIC
  GOOGLE
  MOCK
}

enum AICapability {
  TEXT_GENERATION
  STRUCTURED_OUTPUT
  IMAGE_GENERATION
  AUDIO_GENERATION
  VIDEO_GENERATION
  EMBEDDINGS
}

enum AIPurpose {
  DIAGNOSTICS_TEST
  BRAND_CONTEXT_SUMMARY
  CONTENT_DRAFT
  SEO_ANALYSIS
  ANALYTICS_INSIGHT
  SALES_ASSIST
  LEAD_QUALIFICATION_SUGGEST
}

enum AIRequestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum AIExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum AIErrorCategory {
  PROVIDER_ERROR
  VALIDATION_ERROR
  RATE_LIMIT
  TIMEOUT
  CANCELLED
  CONFIGURATION_ERROR
  SAFETY_FILTER
  BUDGET_EXCEEDED
  UNKNOWN
}

enum PromptTemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model UserProfile {
  id          String   @id @default(cuid())
  authUserId  String   @unique
  email       String
  displayName String?
  firstName   String?
  lastName    String?
  avatarUrl   String?
  timezone    String?  @default("UTC")
  locale      String?  @default("en-GB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships                OrganisationMembership[]
  auditLogs                  AuditLog[]
  workspacePreference        WorkspacePreference?
  executiveDashboardPreferences ExecutiveDashboardPreference[]
  marketingAnalystRuns          MarketingAnalystRun[]
  seoDomainsVerified            SeoSiteDomain[]           @relation("SeoDomainVerifier")
  seoCrawlRunsCreated           SeoCrawlRun[]             @relation("SeoCrawlRunCreator")
  seoIssueResolutions           SeoIssueResolution[]      @relation("SeoIssueResolver")
  seoKeywordIntentsOverridden   SeoKeywordIntent[]        @relation("SeoKeywordIntentOverrider")
  seoKeywordEntitiesConfirmed   SeoKeywordEntity[]        @relation("SeoKeywordEntityConfirmer")
  seoKeywordImportsCreated      SeoKeywordImport[]        @relation("SeoKeywordImportCreator")
  seoKeywordStatusChanges       SeoKeywordStatusHistory[] @relation("SeoKeywordStatusChanger")
  seoContentStrategyVersions    SeoContentStrategyVersion[] @relation("SeoContentStrategyVersionCreator")
  seoContentBriefsCreated       SeoContentBrief[]           @relation("SeoContentBriefCreator")
  seoBriefApprovalsRequested    SeoBriefApproval[]          @relation("SeoBriefApprovalRequester")
  seoBriefApprovalsDecided      SeoBriefApproval[]          @relation("SeoBriefApprovalDecider")
  seoBriefCommentsAuthored      SeoBriefComment[]           @relation("SeoBriefCommentAuthor")
  invitationsSent            Invitation[]              @relation("InvitationsSent")
  invitationsAccepted        Invitation[]              @relation("InvitationsAccepted")
  organisationsCreated       Organisation[]            @relation("OrganisationCreator")
  projectsCreated            Project[]                 @relation("ProjectCreator")
  brandsCreated              Brand[]                   @relation("BrandCreator")
  marketingAssetsUploaded    MarketingAsset[]          @relation("MarketingAssetUploader")
  aiRequests                 AIRequest[]               @relation("AIRequestInitiator")
  promptTemplateVersions     PromptTemplateVersion[]   @relation("PromptTemplateVersionCreator")
  securityAuditLogs          SecurityAuditLog[]
  onboardingProgress         OnboardingProgress?
  connectorAccountsConnected ConnectorAccount[]        @relation("ConnectorAccountConnector")
  socialConnectionsConnected SocialConnection[]        @relation("SocialConnectionConnector")
  oauthAuthorisationStates   OAuthAuthorisationState[] @relation("OAuthAuthorisationUser")
  credentialRotationEvents   CredentialRotationEvent[] @relation("CredentialRotationActor")
  contentItemsOwned          ContentItem[]             @relation("ContentItemOwner")
  contentItemsCreated        ContentItem[]             @relation("ContentItemCreator")
  contentItemsApproved       ContentItem[]             @relation("ContentItemApprover")
  contentRevisionsEdited     ContentRevision[]         @relation("ContentRevisionEditor")
  contentApprovalsRequested  ContentApproval[]         @relation("ContentApprovalRequester")
  contentApprovalsDecided    ContentApproval[]         @relation("ContentApprovalDecider")
  contentCommentsAuthored    ContentComment[]          @relation("ContentCommentAuthor")
  contentCommentsResolved    ContentComment[]          @relation("ContentCommentResolver")
  contentStatusChanges       ContentStatusHistory[]    @relation("ContentStatusChanger")
  growthExperimentsCreated   GrowthExperiment[]        @relation("GrowthExperimentCreator")
  recommendationOutcomes     RecommendationOutcome[]   @relation("RecommendationOutcomeUser")
  marketingLeadsCreated      MarketingLead[]           @relation("MarketingLeadCreator")
  leadAssignmentsReceived    LeadAssignment[]          @relation("LeadAssignee")
  leadAssignmentsMade        LeadAssignment[]          @relation("LeadAssigner")
  leadExportsRequested       LeadExport[]              @relation("LeadExportRequester")
  leadQualificationsReviewed LeadQualification[]       @relation("LeadQualificationReviewer")
  socialExperimentsCreated   SocialExperiment[]        @relation("SocialExperimentCreator")
  experimentDecisionsMade    ExperimentDecision[]      @relation("ExperimentDecisionUser")
  experimentReuseConfirmed   ExperimentReuseRecord[]   @relation("ExperimentReuseConfirmer")
  socialReportsCreated       SocialReport[]            @relation("SocialReportCreator")
  socialReportSchedulesCreated SocialReportSchedule[]  @relation("SocialReportScheduleCreator")
  socialReportRecipients       SocialReportRecipient[]   @relation("SocialReportRecipientUser")
  manualImportJobsCreated      ManualImportJob[]         @relation("ManualImportJobCreator")
  identityLinksConfirmed       MarketingIdentityLink[]   @relation("MarketingIdentityLinkConfirmer")
  dataQualityResolutions       DataQualityResolution[]   @relation("DataQualityResolutionResolver")

  @@index([email])
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

