  STATUS_CHANGED
  ASSIGNED
  QUALIFICATION_UPDATED
  CONSENT_UPDATED
  NOTE_ADDED
  CRM_HANDOFF
  EXPORTED
  DELETED
  SUPPRESSED
}

model MarketingLead {
  id                     String              @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  status                 MarketingLeadStatus @default(NEW)
  displayName            String?
  providerUsername       String?
  providerProfileUrl     String?
  email                  String?
  phone                  String?
  company                String?
  jobRole                String?
  country                String?
  expressedInterest      String?
  sourcePlatform         SocialProvider?
  sourcePostId           String?
  sourceCampaign         String?
  originalInteraction    String?
  socialConversationId   String?
  socialAccountId        String?
  contentItemId          String?
  primaryCta             String?
  destinationUrl         String?
  conversionEventId      String?
  firstInteractionAt     DateTime?
  latestInteractionAt    DateTime?
  assignedToUserId       String?
  duplicateOfLeadId      String?
  isDuplicateWarning     Boolean             @default(false)
  retentionStatus        LeadRetentionStatus @default(ACTIVE)
  lawfulBasisPlaceholder String?
  createdByUserId        String
  deletedAt              DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount?      @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  contentItem    ContentItem?        @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  createdBy      UserProfile         @relation("MarketingLeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  duplicateOf    MarketingLead?      @relation("LeadDuplicate", fields: [duplicateOfLeadId], references: [id], onDelete: SetNull)
  duplicates     MarketingLead[]     @relation("LeadDuplicate")
  source         LeadSource?
  activities     LeadActivity[]
  qualifications LeadQualification[]
  consents       LeadConsent[]
  assignments    LeadAssignment[]
  crmHandoffs    CrmHandoff[]

  @@index([organisationId, brandId, status])
  @@index([brandId, createdAt])
  @@index([email])
  @@index([phone])
  @@index([providerUsername, sourcePlatform])
  @@index([socialConversationId])
  @@index([assignedToUserId])
  @@index([retentionStatus])
}

model LeadSource {
  id                   String             @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  marketingLeadId      String             @unique
  creationSource       LeadCreationSource
  provider             SocialProvider?
  socialAccountId      String?
  providerPostId       String?
  contentItemId        String?
  campaignName         String?
  cta                  String?
  destinationUrl       String?
  interactionReference String?
  metadata             Json?
  capturedAt           DateTime           @default(now())
  createdAt            DateTime           @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId])
  @@index([creationSource])
}

model LeadActivity {
  id              String           @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  marketingLeadId String
  activityType    LeadActivityType
  summary         String
  metadata        Json?
  actorUserId     String?
  createdAt       DateTime         @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)

  @@index([marketingLeadId, createdAt])
  @@index([organisationId, brandId])
}

model LeadQualification {
  id               String                   @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  marketingLeadId  String
  profile          LeadQualificationProfile
  answers          Json                     @default("{}")
  score            Int?
  qualified        Boolean?
  aiSuggested      Boolean                  @default(false)
  aiRequestId      String?
  requiresReview   Boolean                  @default(true)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)
  reviewedBy    UserProfile?  @relation("LeadQualificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([marketingLeadId, profile])
  @@index([marketingLeadId, profile])
  @@index([organisationId, brandId])
}

model LeadConsent {
  id               String           @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  marketingLeadId  String
  consentState     LeadConsentState @default(UNKNOWN)
  lawfulBasis      String?
  marketingOptIn   Boolean          @default(false)
  suppressed       Boolean          @default(false)
  notes            String?
  recordedByUserId String?
  recordedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)

  @@index([marketingLeadId])
  @@index([organisationId, brandId])
}

model LeadAssignment {
  id              String   @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  marketingLeadId String
  assignedToId    String
  assignedById    String
  note            String?
  createdAt       DateTime @default(now())

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)
  assignedTo    UserProfile   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy    UserProfile   @relation("LeadAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([marketingLeadId, createdAt])
  @@index([assignedToId])
}

model LeadExport {
  id             String   @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  format         String
  rowCount       Int
  filters        Json?
  requestedById  String
  fileName       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestedBy  UserProfile  @relation("LeadExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organisationId, brandId, createdAt])
}

model CrmHandoff {
  id              String           @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  marketingLeadId String
  provider        CrmProvider
  idempotencyKey  String
  status          CrmHandoffStatus @default(PENDING)
  externalId      String?
  errorMessage    String?
  payload         Json?
  response        Json?
  attemptedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation  Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingLead MarketingLead @relation(fields: [marketingLeadId], references: [id], onDelete: Cascade)

  @@unique([marketingLeadId, provider, idempotencyKey])
  @@index([organisationId, brandId, status])
}

// --- Task 2.16: Social content experiments ---

enum SocialExperimentStatus {
  DRAFT
  READY
  RUNNING
  COMPLETED
  CANCELLED
  INCONCLUSIVE
}

enum SocialExperimentTestType {
  HOOK
  CAPTION
  CTA
  VISUAL
  VIDEO_DURATION
  COVER
  CONTENT_FORMAT
  PUBLISHING_TIME
  CONTENT_PILLAR
}

enum SocialExperimentMode {
  OBSERVATIONAL
  SCHEDULED
}

enum ExperimentMetricRole {
  PRIMARY
  SECONDARY
}

enum ExperimentDecisionOutcome {
  WINNER
  LOSER
  INCONCLUSIVE
  NONE
}

enum ExperimentReuseType {
  CONTENT_PATTERN
  GROWTH_RECOMMENDATION
  BRAND_MESSAGING_NOTE
  CONTENT_STUDIO_GUIDANCE
}

model SocialExperiment {
  id                     String                   @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  title                  String
  status                 SocialExperimentStatus   @default(DRAFT)
  testType               SocialExperimentTestType
  mode                   SocialExperimentMode     @default(OBSERVATIONAL)
  targetProvider         SocialProvider
  startDate              DateTime
  endDate                DateTime
  minimumSampleThreshold Int
  decisionRule           String
  confoundingFactorNotes String?
  validityWarnings       Json                     @default("[]")
  observationalDisclaimer String                  @default("Observational comparison only. This is not a randomised controlled trial and platforms do not deliver content to equivalent audiences.")
  createdByUserId        String
  cancelledAt            DateTime?
  cancelledReason        String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    UserProfile           @relation("SocialExperimentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  hypothesis   ExperimentHypothesis?
  variants     ExperimentVariant[]
  metrics      ExperimentMetric[]
  results      ExperimentResult[]
  decision     ExperimentDecision?
  reuseRecords ExperimentReuseRecord[]

  @@index([organisationId, brandId, status])
  @@index([brandId, startDate])
  @@index([testType])
}

model ExperimentHypothesis {
  id                 String   @id @default(cuid())
  socialExperimentId String   @unique
  statement          String
  expectedDirection  String?
  rationale          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  socialExperiment SocialExperiment @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)
}

model ExperimentVariant {
  id                 String          @id @default(cuid())
  socialExperimentId String
  label              String
  contentItemId      String?
  contentVariantId   String?
  provider           SocialProvider?
  scheduledFor       DateTime?
  publishedAt        DateTime?
  hasPaidPromotion   Boolean         @default(false)
  contentTopic       String?
  hookText           String?
  captionText        String?
  ctaText            String?
  contentPillar      String?
  sortOrder          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  socialExperiment SocialExperiment   @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)
  contentItem      ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  contentVariant   ContentVariant?    @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  results          ExperimentResult[]
  winningDecisions ExperimentDecision[] @relation("WinningVariant")

  @@index([socialExperimentId, sortOrder])
  @@index([contentItemId])
}

model ExperimentMetric {
  id                  String               @id @default(cuid())
  socialExperimentId  String
  metricKey           String
  role                ExperimentMetricRole
  label               String?
  normalisationMethod String?
  createdAt           DateTime             @default(now())

  socialExperiment SocialExperiment @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)

  @@unique([socialExperimentId, metricKey, role])
  @@index([socialExperimentId, role])
}

model ExperimentResult {
  id                  String   @id @default(cuid())
  socialExperimentId  String
  experimentVariantId String
  metricKey           String
  rawValue            Decimal  @db.Decimal(24, 6)
  normalisedValue     Decimal? @db.Decimal(24, 6)
  sampleSize          Int      @default(0)
  dataSufficient      Boolean  @default(false)
  computedAt          DateTime @default(now())

  socialExperiment  SocialExperiment  @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)
  experimentVariant ExperimentVariant @relation(fields: [experimentVariantId], references: [id], onDelete: Cascade)

  @@unique([experimentVariantId, metricKey])
  @@index([socialExperimentId])
}

model ExperimentDecision {
  id                   String                    @id @default(cuid())
  socialExperimentId   String                    @unique
  outcome              ExperimentDecisionOutcome
  winningVariantId     String?
  absoluteDifference   Decimal?                  @db.Decimal(24, 6)
  percentageDifference Decimal?                  @db.Decimal(24, 6)
  limitations          String
  confidenceNote       String                    @default("Observational comparison only; not a randomised controlled trial.")
  decidedByUserId      String
  decidedAt            DateTime                  @default(now())

  socialExperiment SocialExperiment  @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)
  winningVariant   ExperimentVariant? @relation("WinningVariant", fields: [winningVariantId], references: [id], onDelete: SetNull)
  decidedBy        UserProfile       @relation("ExperimentDecisionUser", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([outcome])
}

model ExperimentReuseRecord {
  id                 String              @id @default(cuid())
  socialExperimentId String
  reuseType          ExperimentReuseType
  targetResourceType String
  targetResourceId   String
  summary            String?
  confirmedByUserId  String
  createdAt          DateTime            @default(now())

  socialExperiment SocialExperiment @relation(fields: [socialExperimentId], references: [id], onDelete: Cascade)
  confirmedBy      UserProfile      @relation("ExperimentReuseConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@index([socialExperimentId, reuseType])
}

// --- Task 2.19: Social media reporting ---

enum SocialReportType {
  WEEKLY_PERFORMANCE
  MONTHLY_PERFORMANCE
  CAMPAIGN_REPORT
  CHANNEL_REPORT
  CONTENT_REPORT
  EXECUTIVE_SUMMARY
  CLIENT_REPORT
}

enum SocialReportStatus {
  DRAFT
  GENERATING
  READY
  FAILED
  ARCHIVED
}

enum SocialReportSectionType {
  OVERVIEW
  PUBLISHING
  REACH_IMPRESSIONS
  ENGAGEMENT
  VIDEO_PERFORMANCE
  FOLLOWER_GROWTH
  TOP_CONTENT
  WEAK_CONTENT
  LEADS
  CAMPAIGN_OUTCOMES
  RECOMMENDATIONS
  DATA_LIMITATIONS
  CUSTOM_NOTES
  AI_NARRATIVE
}

enum SocialReportExportFormat {
  PDF
  CSV
  JSON
}

enum SocialReportExportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SocialReportScheduleCadence {
  WEEKLY
  MONTHLY
  CAMPAIGN_END
}

enum SocialReportShareStatus {
  DISABLED
  ACTIVE
  REVOKED
  EXPIRED
}

model SocialReport {
  id                     String                 @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  reportType             SocialReportType
  title                  String
  status                 SocialReportStatus     @default(DRAFT)
  periodStart            DateTime
  periodEnd              DateTime
  timezone               String
  accountIds             String[]               @default([])
  enabledSections        SocialReportSectionType[] @default([])
  selectedMetrics        String[]               @default([])
  customNotes            String?
  includeRecommendations Boolean                @default(true)
  includeCrescoBranding  Boolean                @default(true)
  narrative              Json?
  narrativeSource        String?
  aiRequestId            String?
  dataLimitations        String[]               @default([])
  shareToken             String?                @unique
  shareStatus            SocialReportShareStatus @default(DISABLED)
  shareExpiresAt         DateTime?
  createdByUserId        String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  archivedAt             DateTime?

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    UserProfile            @relation("SocialReportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sections     SocialReportSection[]
  snapshots    SocialReportSnapshot[]
  exports      SocialReportExport[]
  recipients   SocialReportRecipient[]

  @@index([organisationId, brandId, status])
  @@index([createdByUserId])
  @@index([periodStart, periodEnd])
  @@index([shareToken])
}

model SocialReportSection {
  id             String                  @id @default(cuid())
  socialReportId String
  sectionType    SocialReportSectionType
  title          String
  sortOrder      Int                     @default(0)
  content        Json
  notes          String?

  socialReport SocialReport @relation(fields: [socialReportId], references: [id], onDelete: Cascade)

  @@unique([socialReportId, sectionType])
  @@index([socialReportId, sortOrder])
}

model SocialReportSnapshot {
  id             String   @id @default(cuid())
  socialReportId String
  snapshotData   Json
  generatedAt    DateTime @default(now())

  socialReport SocialReport @relation(fields: [socialReportId], references: [id], onDelete: Cascade)

  @@index([socialReportId, generatedAt])
}

model SocialReportSchedule {
  id              String                      @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  reportType      SocialReportType
  cadence         SocialReportScheduleCadence
  timezone        String
  accountIds      String[]                    @default([])
  enabledSections SocialReportSectionType[]   @default([])
  includeRecommendations Boolean              @default(true)
  includeCrescoBranding  Boolean             @default(true)
  isActive        Boolean                     @default(true)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdByUserId String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    UserProfile             @relation("SocialReportScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipients   SocialReportRecipient[]

  @@index([organisationId, brandId, isActive])
  @@index([nextRunAt])
}

model SocialReportRecipient {
  id         String   @id @default(cuid())
  scheduleId String?
  reportId   String?
  userId     String?
  email      String
  addedAt    DateTime @default(now())
  removedAt  DateTime?

  schedule SocialReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  report   SocialReport?         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user     UserProfile?          @relation("SocialReportRecipientUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([scheduleId])
  @@index([reportId])
  @@index([email])
}

model SocialReportExport {
  id             String                   @id @default(cuid())
  socialReportId String
  format         SocialReportExportFormat
  status         SocialReportExportStatus @default(PENDING)
  fileName       String?
  mimeType       String?
  rowCount       Int?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  completedAt    DateTime?

  socialReport SocialReport @relation(fields: [socialReportId], references: [id], onDelete: Cascade)

  @@index([socialReportId, createdAt])
}
