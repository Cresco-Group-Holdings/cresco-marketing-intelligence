  updatedAt              DateTime              @updatedAt
  archivedAt             DateTime?

  organisation                   Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                        Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                          Brand                           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  person                         CrmPerson?                      @relation(fields: [personId], references: [id], onDelete: SetNull)
  company                        CrmCompany?                     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source                         CrmLeadSource?                  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  owner                          UserProfile?                    @relation("CrmLeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy                      UserProfile                     @relation("CrmLeadCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  productInterests               CrmLeadProductInterest[]
  assignments                    CrmLeadAssignment[]
  lifecycleHistory               CrmLeadLifecycleHistory[]
  statusHistory                  CrmLeadStatusHistory[]
  tagLinks                       CrmLeadTagLink[]
  timelineItems                  CrmActivityTimelineItem[]
  customFieldValues              CrmCustomFieldValue[]
  externalReferences             CrmExternalReference[]
  opportunities                  CrmOpportunity[]
  tasks                          CrmTask[]
  activities                     CrmActivity[]
  marketingAutomationEnrollments MarketingAutomationEnrollment[]
  leadScoreSnapshots             LeadScoreSnapshot[]
  leadQualificationResults       LeadQualificationResult[]
  lifecycleAgentFindings         LifecycleAgentFinding[]         @relation("LifecycleAgentFindingLead")
  lifecycleAgentEvidence         LifecycleAgentEvidence[]        @relation("LifecycleAgentEvidenceLead")

  @@index([organisationId, brandId, status])
  @@index([ownerUserId])
  @@index([lifecycleStage])
  @@index([marketingLeadId])
}

model CrmLeadSource {
  id                   String             @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  sourceType           CrmLeadSourceType
  originalSourceType   CrmLeadSourceType
  latestSourceType     CrmLeadSourceType?
