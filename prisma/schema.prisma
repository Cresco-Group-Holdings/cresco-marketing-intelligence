generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MARKETER
  ANALYST
  VIEWER
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BrandStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MarketingObjectiveType {
  BRAND_AWARENESS
  WEBSITE_TRAFFIC
  LEAD_GENERATION
  DEMO_BOOKINGS
  TRIAL_SIGNUPS
  PAID_SUBSCRIPTIONS
  COMMUNITY_GROWTH
  EMAIL_LIST_GROWTH
  SEO_GROWTH
  CUSTOMER_RETENTION
}

enum MarketingObjectiveStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MarketingChannel {
  WEBSITE
  SEO
  GOOGLE_ADS
  LINKEDIN
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  X
  EMAIL
}

enum OnboardingStepKey {
  ACCOUNT_PROFILE
  ORGANISATION
  PROJECT
  BRAND
  BRAND_PROFILE
  MARKETING_OBJECTIVES
  CHANNEL_PREFERENCES
  REVIEW
}

enum BrandOfferAvailabilityStatus {
  AVAILABLE
  LIMITED
  COMING_SOON
  DISCONTINUED
}

enum BrandAssetType {
  LOGO
  FAVICON
  COLOUR_PALETTE
  FONT
  SCREENSHOT
  PRODUCT_IMAGE
  PRESENTATION
  VIDEO_CLIP
}

enum BrandReferenceType {
  STYLE_GUIDE
  DOCUMENTATION
  EXTERNAL_LINK
  RESEARCH
  OTHER
}

enum BrandComplianceRuleType {
  PROHIBITED_CLAIM
  REQUIRED_DISCLAIMER
  GRANT_ELIGIBILITY
  PRIVACY
  REGULATED_MARKET
  CONTENT_APPROVAL
  OTHER
}

enum BrandComplianceSeverity {
  INFO
  WARNING
  CRITICAL
}

model UserProfile {
  id          String   @id @default(cuid())
  authUserId  String   @unique
  email       String
  displayName String?
  firstName   String?
  lastName    String?
  avatarUrl   String?
  timezone    String?  @default("UTC")
  locale      String?  @default("en-GB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          OrganisationMembership[]
  auditLogs            AuditLog[]
  workspacePreference  WorkspacePreference?
  invitationsSent      Invitation[]             @relation("InvitationsSent")
  invitationsAccepted  Invitation[]             @relation("InvitationsAccepted")
  organisationsCreated Organisation[]           @relation("OrganisationCreator")
  projectsCreated      Project[]                @relation("ProjectCreator")
  brandsCreated        Brand[]                  @relation("BrandCreator")
  securityAuditLogs    SecurityAuditLog[]
  onboardingProgress   OnboardingProgress?

  @@index([email])
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Organisation {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  legalName        String?
  website          String?
  logoUrl          String?
  industry         String?
  countryCode      String?
  defaultTimezone  String?            @default("UTC")
  status           OrganisationStatus @default(ACTIVE)
  createdByUserId  String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?

  createdBy     UserProfile              @relation("OrganisationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships   OrganisationMembership[]
  projects      Project[]
  brands        Brand[]
  brandProfiles BrandProfile[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  brandAudiences      BrandAudience[]
  brandPersonas       BrandPersona[]
  brandOffers         BrandOffer[]
  brandMessages       BrandMessage[]
  brandVoiceRules     BrandVoiceRule[]
  brandCompetitors    BrandCompetitor[]
  brandAssets         BrandAsset[]
  brandReferences     BrandReference[]
  brandComplianceRules BrandComplianceRule[]

  @@index([status])
  @@index([archivedAt])
  @@index([createdAt])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
  @@index([status])
}

model Project {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  slug            String
  description     String?
  website         String?
  status          ProjectStatus @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy     UserProfile    @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  brands        Brand[]
  brandProfiles BrandProfile[]
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  brandAudiences      BrandAudience[]
  brandPersonas       BrandPersona[]
  brandOffers         BrandOffer[]
  brandMessages       BrandMessage[]
  brandVoiceRules     BrandVoiceRule[]
  brandCompetitors    BrandCompetitor[]
  brandAssets         BrandAsset[]
  brandReferences     BrandReference[]
  brandComplianceRules BrandComplianceRule[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([status])
  @@index([archivedAt])
}

model Brand {
  id              String      @id @default(cuid())
  organisationId  String
  projectId       String
  name            String
  slug            String
  description     String?
  website         String?
  primaryDomain   String?
  logoUrl         String?
  faviconUrl      String?
  primaryColour   String?
  secondaryColour String?
  accentColour    String?
  status          BrandStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  archivedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    UserProfile  @relation("BrandCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  profile      BrandProfile?
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  audiences           BrandAudience[]
  personas            BrandPersona[]
  offers              BrandOffer[]
  message             BrandMessage?
  voiceRule           BrandVoiceRule?
  competitors         BrandCompetitor[]
  assets              BrandAsset[]
  references          BrandReference[]
  complianceRules     BrandComplianceRule[]

  @@unique([projectId, slug])
  @@index([organisationId])
  @@index([projectId])
  @@index([status])
  @@index([archivedAt])
}

model BrandProfile {
  id                  String   @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String   @unique
  shortDescription    String?
  longDescription     String?
  mission             String?
  valueProposition    String?
  targetAudience      String?
  customerProblems    String?
  keyBenefits         String?
  productsAndServices String?
  preferredTone       String?
  prohibitedTone      String?
  preferredLanguage   String?
  targetCountries     String[] @default([])
  targetIndustries    String[] @default([])
  competitors         String[] @default([])
  complianceNotes     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model WorkspacePreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  currentOrganisationId String?
  currentProjectId      String?
  currentBrandId        String?
  onboardingCompletedAt DateTime?
  onboardingStep        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentOrganisationId])
  @@index([currentProjectId])
  @@index([currentBrandId])
}

model Invitation {
  id              String           @id @default(cuid())
  organisationId  String
  email           String
  role            OrganisationRole @default(VIEWER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    UserProfile  @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   UserProfile? @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  projectId      String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([projectId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

model MarketingObjective {
  id             String                   @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  objectiveType  MarketingObjectiveType
  description    String
  priority       Int                      @default(1)
  targetValue    Decimal                  @db.Decimal(18, 4)
  targetPeriod   String
  status         MarketingObjectiveStatus @default(PLANNED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, objectiveType])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
}

model BrandChannelPreference {
  id             String           @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  channel        MarketingChannel
  enabled        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, channel])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
}

model BrandAudience {
  id               String    @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  description      String?
  countries        String[]  @default([])
  industries       String[]  @default([])
  organisationType String?
  companySize      String?
  jobRoles         String[]  @default([])
  painPoints       String[]  @default([])
  motivations      String[]  @default([])
  objections       String[]  @default([])
  buyingTriggers   String[]  @default([])
  preferredChannels String[] @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandPersona {
  id                String    @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  name              String
  description       String?
  roleTitle         String?
  goals             String[]  @default([])
  painPoints        String[]  @default([])
  motivations       String[]  @default([])
  objections        String[]  @default([])
  buyingTriggers    String[]  @default([])
  preferredChannels String[]  @default([])
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandOffer {
  id                      String                       @id @default(cuid())
  organisationId          String
  projectId               String
  brandId                 String
  name                    String
  shortDescription        String?
  features                String[]                     @default([])
  benefits                String[]                     @default([])
  priceDescription        String?
  trialAvailable          Boolean                      @default(false)
  primaryCta              String?
  landingPageUrl          String?
  eligibilityRestrictions String?
  availabilityStatus      BrandOfferAvailabilityStatus @default(AVAILABLE)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  archivedAt              DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandMessage {
  id                  String   @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String   @unique
  elevatorPitch       String?
  coreMessage         String?
  supportingMessages  String[] @default([])
  proofPoints         String[] @default([])
  differentiators     String[] @default([])
  objectionResponses  Json?
  ctaLibrary          String[] @default([])
  prohibitedClaims    String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model BrandVoiceRule {
  id                    String   @id @default(cuid())
  organisationId        String
  projectId             String
  brandId               String   @unique
  preferredTone         String?
  vocabulary            String[] @default([])
  prohibitedVocabulary  String[] @default([])
  sentenceStyle         String?
  emojiPolicy           String?
  humourPolicy          String?
  preferredSpelling     String?
  languageVariants      String[] @default([])
  approvedExamples      String[] @default([])
  unacceptableExamples  String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model BrandCompetitor {
  id             String    @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  website        String?
  description    String?
  strengths      String[]  @default([])
  weaknesses     String[]  @default([])
  positioning    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandAsset {
  id             String         @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  assetType      BrandAssetType
  name           String
  description    String?
  fileUrl        String?
  mimeType       String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([assetType])
  @@index([archivedAt])
}

model BrandReference {
  id             String             @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  referenceType  BrandReferenceType @default(OTHER)
  title          String
  url            String?
  description    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandComplianceRule {
  id             String                  @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  ruleType       BrandComplianceRuleType
  title          String
  description    String?
  ruleText       String
  severity       BrandComplianceSeverity @default(WARNING)
  appliesTo      String[]                @default([])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([ruleType])
  @@index([archivedAt])
}

model OnboardingProgress {
  id             String            @id @default(cuid())
  userId         String            @unique
  organisationId String?
  projectId      String?
  brandId        String?
  currentStep    OnboardingStepKey @default(ACCOUNT_PROFILE)
  completedSteps OnboardingStepKey[] @default([])
  stepData       Json?
  templateKey    String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([currentStep])
}
