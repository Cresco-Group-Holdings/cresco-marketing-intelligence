  CAPITAL_TERMINAL
  ENTERPRISE_SALES
  PARTNERSHIPS
  MANAGED_MARKETING
  CUSTOM
}

enum CrmPipelineStageCategory {
  OPEN
  QUALIFICATION
  DISCOVERY
  EVALUATION
  PROPOSAL
  NEGOTIATION
  TRIAL
  WON
  LOST
}

enum CrmOpportunityStatus {
  OPEN
  WON
  LOST
  ARCHIVED
}

enum CrmOpportunityContactRoleType {
  DECISION_MAKER
  CHAMPION
  INFLUENCER
  ECONOMIC_BUYER
  TECHNICAL_EVALUATOR
  OTHER
}

enum CrmOpportunityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CrmWonEvidenceType {
  SUBSCRIPTION_CONFIRMED
  PAYMENT_COMPLETED
  AGREEMENT_SIGNED
  AUTHORISED_CONFIRMATION
}

model CrmPipeline {
  id               String          @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  slug             String
  pipelineType     CrmPipelineType @default(CUSTOM)
  description      String?
  currentVersionId String?
  isDefault        Boolean         @default(false)
  createdByUserId  String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime?

  organisation  Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy     UserProfile          @relation("CrmPipelineCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions      CrmPipelineVersion[]
  opportunities CrmOpportunity[]

  @@unique([brandId, slug])
  @@index([organisationId, brandId])
}

model CrmPipelineVersion {
  id            String    @id @default(cuid())
  pipelineId    String
  versionNumber Int
  label         String?
  isActive      Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  pipeline      CrmPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stages        CrmPipelineStage[]
  opportunities CrmOpportunity[]

  @@unique([pipelineId, versionNumber])
  @@index([pipelineId, isActive])
}

model CrmPipelineStage {
  id                 String                   @id @default(cuid())
  versionId          String
  name               String
  sortOrder          Int                      @default(0)
  category           CrmPipelineStageCategory
  probability        Decimal                  @default(0) @db.Decimal(5, 2)
  entryCriteria      Json?
  exitCriteria       Json?
  requiredFields     Json?
  maxDurationDays    Int?
  automationEligible Boolean                  @default(false)
  requiresApproval   Boolean                  @default(false)
  isArchived         Boolean                  @default(false)
  createdAt          DateTime                 @default(now())

  version       CrmPipelineVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]
  stageHistory  CrmOpportunityStageHistory[]

  @@index([versionId, sortOrder])
}

model CrmOpportunity {
  id                   String               @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  pipelineId           String
  pipelineVersionId    String
  currentStageId       String
  leadId               String?
  companyId            String?
  ownerUserId          String?
  name                 String
  status               CrmOpportunityStatus @default(OPEN)
  product              String?
  plan                 String?
  expectedCloseDate    DateTime?
  probability          Decimal              @default(0) @db.Decimal(5, 2)
  currency             String               @default("GBP")
  campaign             String?
  attributionJourneyId String?
  nextAction           String?
  notes                String?
  lossReasonId         String?
  lossNotes            String?
  reEngagementEligible Boolean              @default(false)
  wonEvidenceType      CrmWonEvidenceType?
  wonEvidenceReference String?
  stageEnteredAt       DateTime             @default(now())
  lastActivityAt       DateTime             @default(now())
  createdByUserId      String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  archivedAt           DateTime?

  organisation           Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                  Brand                        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  pipeline               CrmPipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  pipelineVersion        CrmPipelineVersion           @relation(fields: [pipelineVersionId], references: [id], onDelete: Restrict)
  currentStage           CrmPipelineStage             @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  lead                   CrmLead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company                CrmCompany?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner                  UserProfile?                 @relation("CrmOpportunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy              UserProfile                  @relation("CrmOpportunityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lossReason             CrmOpportunityLossReason?    @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)
  products               CrmOpportunityProduct[]
  contactRoles           CrmOpportunityContactRole[]
  values                 CrmOpportunityValue[]
  probabilityHistory     CrmOpportunityProbability[]
  stageHistory           CrmOpportunityStageHistory[]
  competitors            CrmOpportunityCompetitor[]
  approvals              CrmOpportunityApproval[]
  tasks                  CrmTask[]
  activities             CrmActivity[]
  lifecycleAgentFindings LifecycleAgentFinding[]      @relation("LifecycleAgentFindingOpportunity")
  lifecycleAgentEvidence LifecycleAgentEvidence[]     @relation("LifecycleAgentEvidenceOpportunity")

  @@index([organisationId, brandId, status])
  @@index([pipelineId, currentStageId])
  @@index([ownerUserId])
  @@index([expectedCloseDate])
  @@index([leadId])
}

model CrmOpportunityStageHistory {
  id               String                    @id @default(cuid())
  opportunityId    String
  previousStageId  String?
  newStageId       String
  previousCategory CrmPipelineStageCategory?
  newCategory      CrmPipelineStageCategory
  actorUserId      String?
  reason           String?
  source           String?
  createdAt        DateTime                  @default(now())

  opportunity CrmOpportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  newStage    CrmPipelineStage @relation(fields: [newStageId], references: [id], onDelete: Restrict)
  actor       UserProfile?     @relation("CrmOpportunityStageActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
}

model CrmOpportunityProduct {
  id            String   @id @default(cuid())
  opportunityId String
  product       String
  plan          String?
  quantity      Int      @default(1)
  notes         String?
  createdAt     DateTime @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model CrmOpportunityContactRole {
  id            String                        @id @default(cuid())
  opportunityId String
  personId      String
  roleType      CrmOpportunityContactRoleType @default(OTHER)
  isPrimary     Boolean                       @default(false)
  createdAt     DateTime                      @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  person      CrmPerson      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, personId, roleType])
  @@index([opportunityId])
}

model CrmOpportunityValue {
  id              String   @id @default(cuid())
  opportunityId   String
  valueType       String   @default("EXPECTED")
  amount          Decimal  @db.Decimal(24, 6)
  currency        String   @default("GBP")
  isRecurring     Boolean  @default(false)
  recurringPeriod String?
  effectiveFrom   DateTime @default(now())
  createdAt       DateTime @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, valueType])
}

model CrmOpportunityProbability {
  id            String   @id @default(cuid())
  opportunityId String
  probability   Decimal  @db.Decimal(5, 2)
  reason        String?
  source        String?
  createdAt     DateTime @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, createdAt])
}

model CrmOpportunityLossReason {
  id                  String   @id @default(cuid())
  organisationId      String
  brandId             String?
  label               String
  reEngagementDefault Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  organisation  Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand         Brand?           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@unique([organisationId, label])
  @@index([organisationId, brandId])
}

model CrmOpportunityCompetitor {
  id            String   @id @default(cuid())
  opportunityId String
  name          String
  notes         String?
  createdAt     DateTime @default(now())

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

model CrmOpportunityApproval {
  id                String                       @id @default(cuid())
  opportunityId     String
  stageId           String?
  status            CrmOpportunityApprovalStatus @default(PENDING)
  requestedByUserId String
  actorUserId       String?
  reason            String?
  notes             String?
  requestedAt       DateTime                     @default(now())
  resolvedAt        DateTime?

  opportunity CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor       UserProfile?   @relation("CrmOpportunityApprovalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([opportunityId, status])
}

// ---------------------------------------------------------------------------
// Task 6.4 — CRM Tasks, Activities and Follow-Up Management
// ---------------------------------------------------------------------------

enum CrmTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DEFERRED
  OVERDUE
}

enum CrmTaskTypeCode {
  CALL
  EMAIL
  MEETING
  REVIEW
  RESEARCH
  FOLLOW_UP
  PROPOSAL
  DEMO
  ONBOARDING
  RENEWAL
  DATA_FIX
  OTHER
}

enum CrmActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  FORM_SUBMISSION
  STATUS_CHANGE
  OTHER
}

enum CrmActivityVisibility {
  STANDARD
  RESTRICTED
  PRIVATE
}

enum CrmFollowUpRuleTrigger {
  NEW_LEAD_NO_OWNER
  QUALIFIED_LEAD_NO_TASK
  DEMO_REQUEST_NOT_CONTACTED
  MEETING_NO_NEXT_STEP
  PROPOSAL_NO_FOLLOW_UP
  TRIAL_ENDING
  OPPORTUNITY_INACTIVE
  RENEWAL_APPROACHING
  PAYMENT_FAILED
  LEAD_REPLIED_NO_TASK
}

enum CrmFollowUpSuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
  EXPIRED
}

enum CrmCalendarProvider {
  GOOGLE
  MICROSOFT
  SCHEDULING_PROVIDER
}

model CrmTaskType {
  id             String          @id @default(cuid())
  organisationId String
  brandId        String?
  code           CrmTaskTypeCode
  label          String
  description    String?
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tasks        CrmTask[]

  @@unique([organisationId, code])
  @@index([brandId])
}

model CrmTask {
  id                String          @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  taskTypeId        String?
  taskTypeCode      CrmTaskTypeCode @default(OTHER)
  status            CrmTaskStatus   @default(OPEN)
  title             String
  description       String?
  ownerUserId       String?
  createdByUserId   String
  dueDate           DateTime?
  dueTime           String?
  timezone          String?
  priority          Int             @default(0)
  leadId            String?
  contactId         String?
  companyId         String?
  opportunityId     String?
  formSubmissionId  String?
  campaignId        String?
  relatedEntityType String?
  relatedEntityId   String?
  deferredUntil     DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  archivedAt        DateTime?

  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  taskType       CrmTaskType?            @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)
  owner          UserProfile?            @relation("CrmTaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy      UserProfile             @relation("CrmTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lead           CrmLead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        CrmContact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        CrmCompany?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity    CrmOpportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  formSubmission LeadCaptureSubmission?  @relation(fields: [formSubmissionId], references: [id], onDelete: SetNull)
  assignments    CrmTaskAssignment[]
  reminders      CrmTaskReminder[]
  dependencies   CrmTaskDependency[]     @relation("CrmTaskDependent")
  dependents     CrmTaskDependency[]     @relation("CrmTaskPrerequisite")
  completion     CrmTaskCompletion?
  activities     CrmActivity[]
  suggestions    CrmFollowUpSuggestion[]

  @@index([organisationId, brandId, status])
  @@index([ownerUserId, status])
  @@index([dueDate])
  @@index([opportunityId])
  @@index([leadId])
}

model CrmTaskAssignment {
  id           String   @id @default(cuid())
  taskId       String
  assigneeId   String
  assignedById String
  reason       String?
  assignedAt   DateTime @default(now())

  task       CrmTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee   UserProfile @relation("CrmTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy UserProfile @relation("CrmTaskAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model CrmTaskReminder {
  id            String    @id @default(cuid())
  taskId        String
  remindAt      DateTime
  reminderType  String    @default("BEFORE_DUE")
  minutesBefore Int?
  timezone      String?
  notifiedAt    DateTime?
  escalatedAt   DateTime?
  createdAt     DateTime  @default(now())

  task CrmTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, remindAt])
}

model CrmTaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task          CrmTask @relation("CrmTaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask CrmTask @relation("CrmTaskPrerequisite", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model CrmTaskCompletion {
  id            String   @id @default(cuid())
  taskId        String   @unique
  completedById String
  outcome       String?
  notes         String?
  nextAction    String?
  completedAt   DateTime @default(now())

  task        CrmTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy UserProfile @relation("CrmTaskCompleter", fields: [completedById], references: [id], onDelete: Restrict)
}

model CrmActivity {
  id               String                @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  activityType     CrmActivityType
  title            String
  summary          String?
  outcome          String?
  nextAction       String?
  durationMinutes  Int?
  visibility       CrmActivityVisibility @default(STANDARD)
  loggedByUserId   String
  leadId           String?
  companyId        String?
  opportunityId    String?
  taskId           String?
  formSubmissionId String?
  campaignId       String?
  occurredAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())

  organisation  Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  loggedBy      UserProfile              @relation("CrmActivityLogger", fields: [loggedByUserId], references: [id], onDelete: Restrict)
  lead          CrmLead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company       CrmCompany?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunity   CrmOpportunity?          @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  task          CrmTask?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)
  participants  CrmActivityParticipant[]
  note          CrmNote?
  callLog       CrmCallLog?
  meetingRecord CrmMeetingRecord?

  @@index([organisationId, brandId, occurredAt])
  @@index([leadId])
  @@index([opportunityId])
}

model CrmActivityParticipant {
  id         String  @id @default(cuid())
  activityId String
  personId   String?
  userId     String?
  name       String?
  role       String?

  activity CrmActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  person   CrmPerson?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  user     UserProfile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([activityId])
}

model CrmNote {
  id         String   @id @default(cuid())
  activityId String   @unique
  content    String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity CrmActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author   UserProfile @relation("CrmNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
}

model CrmCallLog {
  id              String   @id @default(cuid())
  activityId      String   @unique
  direction       String   @default("OUTBOUND")
  phoneNumber     String?
  durationMinutes Int?
  disposition     String?
  loggedById      String
  createdAt       DateTime @default(now())

  activity CrmActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  loggedBy UserProfile @relation("CrmCallLogger", fields: [loggedById], references: [id], onDelete: Restrict)
}

model CrmMeetingRecord {
  id               String               @id @default(cuid())
  activityId       String               @unique
  scheduledAt      DateTime?
  durationMinutes  Int?
  location         String?
  calendarProvider CrmCalendarProvider?
  externalEventId  String?
  outcome          String?
  followUpTaskId   String?
  loggedById       String
  createdAt        DateTime             @default(now())

  activity CrmActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  loggedBy UserProfile @relation("CrmMeetingLogger", fields: [loggedById], references: [id], onDelete: Restrict)

  @@index([externalEventId])
}

model CrmFollowUpRule {
  id             String                 @id @default(cuid())
  organisationId String
  brandId        String?
  name           String
  trigger        CrmFollowUpRuleTrigger
  conditions     Json?
  taskTypeCode   CrmTaskTypeCode        @default(FOLLOW_UP)
  dueOffsetHours Int                    @default(24)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId, trigger])
}

model CrmFollowUpSuggestion {
  id                  String                      @id @default(cuid())
  organisationId      String
  brandId             String
  ruleId              String?
  taskId              String?
  leadId              String?
  opportunityId       String?
  status              CrmFollowUpSuggestionStatus @default(PENDING)
  suggestionType      String
  title               String
  description         String?
  recommendedTaskType CrmTaskTypeCode?
  recommendedDueAt    DateTime?
  aiEvidence          Json?
  aiGrounded          Boolean                     @default(true)
  autoSendBlocked     Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  resolvedAt          DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  task         CrmTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, status])
}

// ---------------------------------------------------------------------------
// Task 6.5 — Email Marketing Infrastructure and Deliverability Controls
// ---------------------------------------------------------------------------

enum EmailProviderType {
  AMAZON_SES
  SENDGRID
  MAILGUN
  POSTMARK
  RESEND
  CUSTOM_SMTP
}

enum EmailMessageCategory {
  ESSENTIAL_TRANSACTIONAL
  ACCOUNT
  SERVICE_OPERATIONAL
  SALES_ONE_TO_ONE
  MARKETING
  NURTURE
  NEWSLETTER
  EVENT
  CUSTOMER_SUCCESS
  OTHER
}

enum EmailDomainSendingStatus {
  PENDING
  VERIFYING
  READY
  SUSPENDED
  FAILED
}

enum EmailDnsRecordStatus {
  UNKNOWN
  PENDING
  PASS
  FAIL
}

enum EmailSenderVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REVOKED
}

enum EmailTemplateVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

enum EmailMessageStatus {
  QUEUED
  SCHEDULED
  SENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SUPPRESSED
}

enum EmailRecipientStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
}

enum EmailDeliveryEventType {
  ACCEPTED
  QUEUED
  SENT
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  OPENED
  CLICKED
  UNSUBSCRIBED
  REJECTED
  FAILED
}

enum EmailSuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  LEGAL_DELETION
  INVALID_ADDRESS
  PROVIDER_SUPPRESSION
  TENANT_BLOCK
}

enum EmailBounceType {
  HARD
  SOFT
}

model EmailProviderConnection {
  id                 String            @id @default(cuid())
  organisationId     String
  brandId            String?
  providerType       EmailProviderType
  name               String
  credentialsRef     String?
  config             Json?
  isActive           Boolean           @default(true)
  isDefault          Boolean           @default(false)
  rateLimitPerMinute Int?
  dailyQuota         Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domains      EmailSendingDomain[]
  messages     EmailMessage[]
  webhooks     EmailProviderWebhook[]

  @@index([organisationId, providerType])
  @@index([brandId])
}

model EmailSendingDomain {
  id                   String                   @id @default(cuid())
  organisationId       String
  brandId              String?
  providerConnectionId String
  domain               String
  sendingStatus        EmailDomainSendingStatus @default(PENDING)
  spfStatus            EmailDnsRecordStatus     @default(UNKNOWN)
  dkimStatus           EmailDnsRecordStatus     @default(UNKNOWN)
  dmarcStatus          EmailDnsRecordStatus     @default(UNKNOWN)
  customReturnPath     String?
  providerVerified     Boolean                  @default(false)
  lastCheckedAt        DateTime?
  configInstructions   Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organisation            Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand                   Brand?                        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  providerConnection      EmailProviderConnection       @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  verifications           EmailDomainVerification[]
  senderIdentities        EmailSenderIdentity[]
  deliverabilitySnapshots EmailDeliverabilitySnapshot[]

  @@unique([organisationId, domain])
  @@index([brandId])
  @@index([sendingStatus])
}

model EmailDomainVerification {
  id                String               @id @default(cuid())
  domainId          String
  verificationType  String
  status            EmailDnsRecordStatus @default(PENDING)
  recordName        String?
  recordValue       String?
  checkedAt         DateTime?
  providerReference String?

  domain EmailSendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
}

model EmailSenderIdentity {
  id                 String                        @id @default(cuid())
  organisationId     String
  brandId            String?
  domainId           String
  displayName        String
  emailAddress       String
  replyTo            String?
  purpose            String?
  verificationStatus EmailSenderVerificationStatus @default(PENDING)
  isDefault          Boolean                       @default(false)
  allowedCategories  EmailMessageCategory[]
  verifiedAt         DateTime?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain       EmailSendingDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  messages     EmailMessage[]

  @@unique([organisationId, emailAddress])
  @@index([brandId])
  @@index([verificationStatus])
}

model EmailTemplate {
  id               String               @id @default(cuid())
  organisationId   String
  brandId          String?
  name             String
  slug             String
  category         EmailMessageCategory
  currentVersionId String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions     EmailTemplateVersion[]
  messages     EmailMessage[]

  @@unique([organisationId, slug])
  @@index([brandId])
}

model EmailTemplateVersion {
  id                  String                     @id @default(cuid())
  templateId          String
  versionNumber       Int
  status              EmailTemplateVersionStatus @default(DRAFT)
  subject             String
  preheader           String?
  htmlBody            String
  plainTextBody       String?
  variables           Json?
  language            String                     @default("en")
  requiresUnsubscribe Boolean                    @default(false)
  complianceFooter    String?
  approvedByUserId    String?
  approvedAt          DateTime?
  createdByUserId     String
  createdAt           DateTime                   @default(now())

  template   EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  approvedBy UserProfile?   @relation("EmailTemplateApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdBy  UserProfile    @relation("EmailTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages   EmailMessage[]

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
}

model EmailMessage {
  id                   String               @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  providerConnectionId String?
  senderIdentityId     String
  templateId           String?
  templateVersionId    String?
  category             EmailMessageCategory
  status               EmailMessageStatus   @default(QUEUED)
  subject              String
  preheader            String?
  htmlBody             String?
  plainTextBody        String?
  idempotencyKey       String?
  scheduledAt          DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  providerMessageId    String?
  failureReason        String?
  retryCount           Int                  @default(0)
  createdByUserId      String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organisation       Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand              Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  providerConnection EmailProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  senderIdentity     EmailSenderIdentity      @relation(fields: [senderIdentityId], references: [id], onDelete: Restrict)
  template           EmailTemplate?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion    EmailTemplateVersion?    @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  createdBy          UserProfile              @relation("EmailMessageCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  recipients         EmailMessageRecipient[]
  deliveryEvents     EmailDeliveryEvent[]
  bounces            EmailBounce[]
  complaints         EmailComplaint[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId, brandId, status])
  @@index([scheduledAt])
  @@index([senderIdentityId])
}

model EmailMessageRecipient {
  id                  String               @id @default(cuid())
  messageId           String
  emailAddress        String
  displayName         String?
  status              EmailRecipientStatus @default(PENDING)
  leadId              String?
  contactId           String?
  variables           Json?
  providerRecipientId String?

  message        EmailMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deliveryEvents EmailDeliveryEvent[]
  bounces        EmailBounce[]
  complaints     EmailComplaint[]

  @@index([messageId])
  @@index([emailAddress])
}

model EmailDeliveryEvent {
  id              String                 @id @default(cuid())
  messageId       String
  recipientId     String?
  eventType       EmailDeliveryEventType
  providerEventId String?
  occurredAt      DateTime
  receivedAt      DateTime               @default(now())
  metadata        Json?
  idempotencyKey  String?

  message   EmailMessage           @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient EmailMessageRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([providerEventId, eventType])
  @@index([messageId, occurredAt])
}

model EmailSuppression {
  id             String                 @id @default(cuid())
  organisationId String
  brandId        String?
  emailAddress   String
  reason         EmailSuppressionReason
  source         String?
  suppressedAt   DateTime               @default(now())
  expiresAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([organisationId, emailAddress])
  @@index([brandId])
}

model EmailBounce {
  id                String          @id @default(cuid())
  organisationId    String
  messageId         String?
  recipientId       String?
  emailAddress      String
  bounceType        EmailBounceType
  reason            String?
  providerReference String?
  occurredAt        DateTime        @default(now())

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  message      EmailMessage?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipient    EmailMessageRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([organisationId, emailAddress])
  @@index([messageId])
}

model EmailComplaint {
  id                String   @id @default(cuid())
  organisationId    String
  messageId         String?
  recipientId       String?
  emailAddress      String
  reason            String?
  providerReference String?
  occurredAt        DateTime @default(now())

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  message      EmailMessage?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  recipient    EmailMessageRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([organisationId, emailAddress])
  @@index([messageId])
}

model EmailUnsubscribe {
  id             String                @id @default(cuid())
  organisationId String
  brandId        String?
  emailAddress   String
  category       EmailMessageCategory?
  source         String?
  unsubscribedAt DateTime              @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([organisationId, emailAddress, category])
  @@index([brandId])
}

model EmailTrackingPolicy {
  id                        String   @id @default(cuid())
  organisationId            String
  brandId                   String?
  openTrackingEnabled       Boolean  @default(false)
  clickTrackingEnabled      Boolean  @default(false)
  utmParameters             Json?
  firstPartyRedirectEnabled Boolean  @default(true)
  requireConsent            Boolean  @default(true)
  restrictedRegions         String[] @default([])
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId])
}

model EmailProviderWebhook {
  id                   String    @id @default(cuid())
  organisationId       String
  providerConnectionId String
  endpointSecretRef    String?
  isActive             Boolean   @default(true)
  lastReceivedAt       DateTime?
  createdAt            DateTime  @default(now())

  organisation       Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  providerConnection EmailProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([providerConnectionId])
}

model EmailDeliverabilitySnapshot {
  id               String   @id @default(cuid())
  organisationId   String
  brandId          String?
  domainId         String?
  periodStart      DateTime
  periodEnd        DateTime
  sentCount        Int      @default(0)
  deliveredCount   Int      @default(0)
  bounceCount      Int      @default(0)
  hardBounceCount  Int      @default(0)
  complaintCount   Int      @default(0)
  unsubscribeCount Int      @default(0)
  rejectionCount   Int      @default(0)
  deliveryRate     Decimal?
  bounceRate       Decimal?
  complaintRate    Decimal?
  warnings         Json?
  computedAt       DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand        Brand?              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain       EmailSendingDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, computedAt])
}

