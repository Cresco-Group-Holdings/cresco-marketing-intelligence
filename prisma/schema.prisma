  finding              String?
  explanation          String?
  explanationSource    String?
  recommendedAction    String?
  evidenceSummary      Json                          @default("[]")
  expectedHypothesis   String?
  measurementPlan      String?
  aiGenerated          Boolean                       @default(false)
  aiRequestId          String?
  draftContentItemId   String?
  draftExperimentId    String?
  latestFeedbackStatus RecommendationFeedbackStatus?
  latestOutcomeId      String?
  expiresAt            DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  organisation  Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  analysisRun   GrowthAnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  growthInsight GrowthInsight?          @relation(fields: [growthInsightId], references: [id], onDelete: SetNull)
  outcomes      RecommendationOutcome[]
  experiments   GrowthExperiment[]

  @@index([organisationId, brandId, status])
  @@index([brandId, createdAt])
  @@index([brandId, idempotencyKey])
  @@index([growthInsightId])
  @@index([analysisRunId])
}

model RecommendationOutcome {
  id                     String                       @id @default(cuid())
  organisationId         String
  brandId                String
  growthRecommendationId String
  userProfileId          String
  feedbackStatus         RecommendationFeedbackStatus
  reason                 String?
  outcomeNotes           String?
  measuredOutcome        Json?
  linkedExperimentId     String?
  isEffective            Boolean                      @default(true)
  createdAt              DateTime                     @default(now())

  organisation         Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand                Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  growthRecommendation GrowthRecommendation @relation(fields: [growthRecommendationId], references: [id], onDelete: Cascade)
  user                 UserProfile          @relation("RecommendationOutcomeUser", fields: [userProfileId], references: [id], onDelete: Restrict)

  @@index([growthRecommendationId, isEffective])
  @@index([organisationId, brandId])
  @@index([feedbackStatus])
}

model GrowthExperiment {
  id                     String                 @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  growthRecommendationId String?
  title                  String
  hypothesis             String
  status                 GrowthExperimentStatus @default(PLANNED)
  measurementPlan        String?
  startDate              DateTime?
  endDate                DateTime?
  resultSummary          String?
  linkedContentItemId    String?
  createdByUserId        String
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  growthRecommendation GrowthRecommendation? @relation(fields: [growthRecommendationId], references: [id], onDelete: SetNull)
  createdBy            UserProfile           @relation("GrowthExperimentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId, brandId, status])
  @@index([growthRecommendationId])
}

// --- Task 2.14: Marketing leads ---

enum MarketingLeadStatus {
