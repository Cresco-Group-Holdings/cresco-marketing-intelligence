  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionModel AttributionModel    @relation(fields: [attributionModelId], references: [id], onDelete: Cascade)
  results          AttributionResult[]
  runs             AttributionRun[]

  @@unique([attributionModelId, versionNumber])
  @@index([organisationId, brandId])
}

