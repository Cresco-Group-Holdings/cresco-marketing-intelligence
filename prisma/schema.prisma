  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem    ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant?      @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  policy         CompliancePolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  evaluator      UserProfile?         @relation("ComplianceEvaluator", fields: [evaluatedByUserId], references: [id], onDelete: SetNull)
