  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  verifiedBy   UserProfile? @relation("SeoDomainVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([seoSiteId, hostname])
  @@index([organisationId, brandId])
  @@index([verificationStatus])
}

model SeoCrawlConfiguration {
  id                  String   @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String
  seoSiteId           String   @unique
  startUrls           String[] @default([])
  allowedDomains      String[] @default([])
  allowedSubdomains   Boolean  @default(true)
  includeRules        String[] @default([])
  excludeRules        String[] @default([])
  maxPages            Int      @default(500)
  maxDepth            Int      @default(5)
  requestConcurrency  Int      @default(2)
  requestDelayMs      Int      @default(500)
  requestTimeoutMs    Int      @default(15000)
  redirectLimit       Int      @default(5)
  userAgent           String   @default("CrescoSEOBot/1.0")
  respectRobotsTxt    Boolean  @default(true)
  followCanonical     Boolean  @default(true)
  queryParamRules     Json?
  ignoredExtensions   String[] @default([".pdf", ".zip", ".jpg", ".jpeg", ".png", ".gif", ".svg", ".css", ".js", ".woff", ".woff2"])
  customHeaders       Json?
  crawlSchedule       String?
  configVersion       Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
