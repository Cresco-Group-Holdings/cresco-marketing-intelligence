// ---------------------------------------------------------------------------
// Marketing attribution engine (Task 3.6)
// ---------------------------------------------------------------------------

enum AttributionModelType {
  FIRST_TOUCH
  LAST_TOUCH
  LINEAR
  POSITION_BASED
  TIME_DECAY
}

enum DirectTrafficPolicy {
  RETAIN
  IGNORE_WHEN_PRIOR_KNOWN
  SHOW_BOTH
}

enum AttributionTouchpointSource {
  WEBSITE_SESSION
  SOCIAL_POST_CLICK
  PAID_AD_CLICK
  ORGANIC_SEARCH
  EMAIL_CLICK
  REFERRAL
  DEMO_BOOKING
  CRM_ACTIVITY
  DIRECT_VISIT
}

enum AttributionRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum AttributionJourneyStatus {
  OPEN
  CONVERTED
  REFUNDED
  UNATTRIBUTED
}

enum AttributionExclusionRuleType {
  CHANNEL
  SOURCE
  CAMPAIGN
  TOUCHPOINT_SOURCE
  CONSENT_MISSING
  CUSTOM
}

enum AttributionRunTrigger {
  MODEL_CHANGE
  LATE_EVENT
  IDENTITY_CONFIRMED
  REFUND
  CAMPAIGN_MAPPING_CHANGE
  EXCLUSION_RULE_CHANGE
  MANUAL
  SCHEDULED
}

model AttributionModel {
  id                   String               @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  name                 String
  modelType            AttributionModelType
  directTrafficPolicy  DirectTrafficPolicy  @default(RETAIN)
  lookbackWindowDays   Int                  @default(90)
  isDefault            Boolean              @default(false)
  isActive             Boolean              @default(true)
  currentVersionId     String?
  config               Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions        AttributionModelVersion[]
  results         AttributionResult[]
  runs            AttributionRun[]

  @@unique([brandId, name])
  @@index([organisationId, brandId])
  @@index([isDefault])
}

model AttributionModelVersion {
  id                  String               @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String
  attributionModelId  String
  versionNumber       Int
  modelType           AttributionModelType
  directTrafficPolicy DirectTrafficPolicy
  lookbackWindowDays  Int
  config              Json?
  changelog           String?
  createdByUserId     String?
  createdAt           DateTime             @default(now())

  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionModel AttributionModel   @relation(fields: [attributionModelId], references: [id], onDelete: Cascade)
  results          AttributionResult[]
  runs             AttributionRun[]

  @@unique([attributionModelId, versionNumber])
  @@index([organisationId, brandId])
}

model AttributionJourney {
  id                         String                   @id @default(cuid())
  organisationId             String
  projectId                  String
  brandId                    String
  identityId                 String?
  conversionEventId          String?
  conversionDefinitionId     String?
  revenueRecordId            String?
  conversionType             String
  conversionKey                String?
  journeyStart               DateTime
  journeyEnd                 DateTime?
  status                     AttributionJourneyStatus @default(OPEN)
  revenueValue               Decimal?                 @db.Decimal(24, 6)
  revenueCurrency            String?
  lookbackWindowDays         Int
  directTrafficPolicy        DirectTrafficPolicy
  limitations                Json?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  identity     MarketingIdentity?    @relation(fields: [identityId], references: [id], onDelete: SetNull)
  touchpoints  AttributionTouchpoint[]
  results      AttributionResult[]

  @@index([organisationId, brandId, journeyEnd])
  @@index([identityId])
  @@index([status])
}

model AttributionTouchpoint {
  id                       String                      @id @default(cuid())
  organisationId           String
  projectId                String
  brandId                  String
  attributionJourneyId     String?
  touchpointSource         AttributionTouchpointSource
  identityId               String?
  marketingSessionId       String?
  marketingEventId         String?
  marketingCampaignId      String?
  marketingChannelId       String?
  marketingContentItemId   String?
  marketingLandingPageId   String?
  provider                 MarketingDataProvider?
  channel                  String?
  campaign                 String?
  contentKey               String?
  occurredAt               DateTime
  sessionKey               String?
  landingPage              String?
  utmSource                String?
  utmMedium                String?
  utmCampaign              String?
  utmTerm                  String?
  utmContent               String?
  clickId                  String?
  clickIdProvider          String?
  consentState             Json?
  evidenceStrength         Decimal?                    @db.Decimal(5, 4)
  isExcluded               Boolean                     @default(false)
  exclusionReason          String?
  position                 Int?
  providerMetadata         Json?
  createdAt                DateTime                    @default(now())

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionJourney AttributionJourney? @relation(fields: [attributionJourneyId], references: [id], onDelete: SetNull)
  identity           MarketingIdentity?  @relation(fields: [identityId], references: [id], onDelete: SetNull)
  credits              AttributionCredit[]

  @@index([organisationId, brandId, occurredAt])
  @@index([attributionJourneyId])
  @@index([identityId])
  @@index([touchpointSource])
}

model AttributionResult {
  id                        String   @id @default(cuid())
  organisationId            String
  projectId                 String
  brandId                   String
  attributionJourneyId      String
  attributionModelId        String
  attributionModelVersionId String
  attributionRunId          String?
  conversionEventId         String?
  revenueValue              Decimal  @db.Decimal(24, 6)
  revenueCurrency           String?
  totalCreditPercent        Decimal  @db.Decimal(8, 4)
  calculatedAt              DateTime
  limitations               Json?
  metadata                  Json?
  createdAt                 DateTime @default(now())

  organisation            Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                   Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionJourney      AttributionJourney      @relation(fields: [attributionJourneyId], references: [id], onDelete: Cascade)
  attributionModel        AttributionModel        @relation(fields: [attributionModelId], references: [id], onDelete: Cascade)
  attributionModelVersion AttributionModelVersion @relation(fields: [attributionModelVersionId], references: [id], onDelete: Cascade)
  attributionRun          AttributionRun?         @relation(fields: [attributionRunId], references: [id], onDelete: SetNull)
  credits                 AttributionCredit[]

  @@index([organisationId, brandId, calculatedAt])
  @@index([attributionJourneyId])
  @@index([attributionModelId])
}

model AttributionCredit {
  id                      String   @id @default(cuid())
  organisationId          String
  projectId               String
  brandId                 String
  attributionResultId     String
  attributionTouchpointId String
  creditPercent           Decimal  @db.Decimal(8, 4)
  creditValue             Decimal? @db.Decimal(24, 6)
  channel                 String?
  campaign                String?
  contentKey              String?
  position                Int?
  wasExcluded             Boolean  @default(false)
  metadata                Json?
  createdAt               DateTime @default(now())

  organisation          Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                 Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionResult     AttributionResult     @relation(fields: [attributionResultId], references: [id], onDelete: Cascade)
  attributionTouchpoint AttributionTouchpoint @relation(fields: [attributionTouchpointId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId])
  @@index([attributionResultId])
  @@index([channel])
}

model AttributionRun {
  id                        String                @id @default(cuid())
  organisationId            String
  projectId                 String
  brandId                   String
  attributionModelId        String
  attributionModelVersionId   String
  status                    AttributionRunStatus  @default(PENDING)
  triggerReason             AttributionRunTrigger
  journeysProcessed         Int                   @default(0)
  resultsCreated            Int                   @default(0)
  startedAt                 DateTime?
  completedAt               DateTime?
  errorMessage              String?
  idempotencyKey            String                @unique
  metadata                  Json?
  createdAt                 DateTime              @default(now())

  organisation            Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                 Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                   Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attributionModel        AttributionModel        @relation(fields: [attributionModelId], references: [id], onDelete: Cascade)
  attributionModelVersion AttributionModelVersion @relation(fields: [attributionModelVersionId], references: [id], onDelete: Cascade)
  results                 AttributionResult[]

  @@index([organisationId, brandId, createdAt])
  @@index([status])
}

model AttributionExclusionRule {
  id             String                       @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  ruleType       AttributionExclusionRuleType
  matchField     String
  matchValue     String
  isActive       Boolean                      @default(true)
  reason         String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, name])
  @@index([organisationId, brandId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Funnel and conversion intelligence (Task 3.7)
// ---------------------------------------------------------------------------

enum FunnelCountingMethod {
  USER
  SESSION
  EVENT
}

enum FunnelStepType {
  EVENT
  CONVERSION
  PAGE
  CAMPAIGN
  LEAD_STATUS
  CRM_STAGE
  SUBSCRIPTION_STATUS
  PAYMENT_STATUS
}

enum FunnelStepRequirement {
  REQUIRED
  OPTIONAL
}

enum FunnelTemplateType {
  CRESCO_GRANTS
  CAPITAL_CRESCO_TERMINAL
}

enum FunnelAnalysisRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FunnelSegmentDimension {
  CHANNEL
  CAMPAIGN
  PROVIDER
  LANDING_PAGE
  DEVICE
  COUNTRY
  NEW_VS_RETURNING
  BRAND
  AUDIENCE
  CONTENT
  DATE_COHORT
}

enum FunnelDropOffInsightType {
  LARGEST_DROP_OFF
  SLOW_TRANSITION
  WORSENING_CONVERSION
  STRONG_TRAFFIC_WEAK_ACTIVATION
  HIGH_SIGNUP_LOW_COMPLETION
  LOW_QUALITY_CONVERSIONS
}

model MarketingFunnel {
  id               String               @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  description      String?
  countingMethod   FunnelCountingMethod @default(USER)
  templateType     FunnelTemplateType?
  isTemplate       Boolean              @default(false)
  isActive         Boolean              @default(true)
  currentVersionId String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions     MarketingFunnelVersion[]
  runs         FunnelAnalysisRun[]

  @@unique([brandId, name])
  @@index([organisationId, brandId])
  @@index([isActive])
}

model MarketingFunnelVersion {
  id             String               @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  funnelId       String
  versionNumber  Int
  countingMethod FunnelCountingMethod
  config         Json?
  changelog      String?
  createdByUserId String?
  createdAt      DateTime             @default(now())

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  funnel       MarketingFunnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  steps        MarketingFunnelStep[]
  runs         FunnelAnalysisRun[]

  @@unique([funnelId, versionNumber])
  @@index([organisationId, brandId])
}

model MarketingFunnelStep {
  id                  String                @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String
  funnelVersionId     String
  stepOrder           Int
  name                String
  stepType            FunnelStepType
  matchingRules       Json
  maxTimeToNextStepMs Int?
  requirement         FunnelStepRequirement @default(REQUIRED)
  createdAt           DateTime              @default(now())

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  funnelVersion MarketingFunnelVersion @relation(fields: [funnelVersionId], references: [id], onDelete: Cascade)
  stepResults   FunnelStepResult[]

  @@unique([funnelVersionId, stepOrder])
  @@index([organisationId, brandId])
}

model FunnelAnalysisRun {
  id                String                  @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  funnelId          String
  funnelVersionId   String
  status            FunnelAnalysisRunStatus @default(PENDING)
  countingMethod    FunnelCountingMethod
  cohortDate        DateTime?
  dateFrom          DateTime
  dateTo            DateTime
  segmentDimension  FunnelSegmentDimension?
  segmentValue      String?
  entrants          Int                     @default(0)
  totalConversions  Int                     @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  errorMessage      String?
  idempotencyKey    String                  @unique
  journeySamples    Json?
  dataQualityWarnings Json?
  metadata          Json?
  createdAt         DateTime                @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  funnel       MarketingFunnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  funnelVersion MarketingFunnelVersion @relation(fields: [funnelVersionId], references: [id], onDelete: Cascade)
  stepResults  FunnelStepResult[]
  segments     FunnelSegment[]
  insights     FunnelDropOffInsight[]

  @@index([organisationId, brandId, createdAt])
  @@index([funnelId])
  @@index([status])
}

model FunnelStepResult {
  id                   String   @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  funnelAnalysisRunId  String
  funnelStepId         String
  stepOrder            Int
  stepName             String
  entrants             Int
  completions          Int
  stepConversion       Decimal  @db.Decimal(8, 4)
  cumulativeConversion Decimal  @db.Decimal(8, 4)
  dropOffCount         Int
  dropOffRate          Decimal  @db.Decimal(8, 4)
  medianTimeToNextMs   Int?
  metadata             Json?
  createdAt            DateTime @default(now())

  organisation      Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
