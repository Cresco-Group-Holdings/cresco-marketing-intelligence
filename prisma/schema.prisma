}

model MarketingChannelRule {
  id             String   @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  description    String?
  priority       Int      @default(100)
  matchPattern   String
  matchField     String
  targetChannel  String
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organisation                   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  classifications  MarketingChannelClassification[]

  @@index([organisationId, brandId, isActive])
  @@index([priority])
}

model MarketingChannelClassification {
  id                     String   @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  marketingChannelId     String
  marketingChannelRuleId String?
  classifiedChannel      String
