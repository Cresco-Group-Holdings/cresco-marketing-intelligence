  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  verifiedBy   UserProfile? @relation("SeoDomainVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([seoSiteId, hostname])
  @@index([organisationId, brandId])
  @@index([verificationStatus])
}

model SeoCrawlConfiguration {
  id                 String   @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  seoSiteId          String   @unique
  startUrls          String[] @default([])
  allowedDomains     String[] @default([])
  allowedSubdomains  Boolean  @default(true)
  includeRules       String[] @default([])
  excludeRules       String[] @default([])
  maxPages           Int      @default(500)
  maxDepth           Int      @default(5)
  requestConcurrency Int      @default(2)
  requestDelayMs     Int      @default(500)
  requestTimeoutMs   Int      @default(15000)
  redirectLimit      Int      @default(5)
  userAgent          String   @default("CrescoSEOBot/1.0")
  respectRobotsTxt   Boolean  @default(true)
  followCanonical    Boolean  @default(true)
  queryParamRules    Json?
  ignoredExtensions  String[] @default([".pdf", ".zip", ".jpg", ".jpeg", ".png", ".gif", ".svg", ".css", ".js", ".woff", ".woff2"])
  customHeaders      Json?
  crawlSchedule      String?
  configVersion      Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
}

model SeoCrawlRun {
  id              String            @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  seoSiteId       String
  status          SeoCrawlRunStatus @default(QUEUED)
  idempotencyKey  String            @unique
  pagesDiscovered Int               @default(0)
  pagesCrawled    Int               @default(0)
  pagesBlocked    Int               @default(0)
  issuesFound     Int               @default(0)
  attemptCount    Int               @default(0)
  maxAttempts     Int               @default(3)
  nextRetryAt     DateTime?
  startedAt       DateTime?
  heartbeatAt     DateTime?
  leaseExpiresAt  DateTime?
  workerId        String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  lastError       String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite            SeoSite             @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  createdBy          UserProfile?        @relation("SeoCrawlRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  queueItems         SeoCrawlQueueItem[]
  snapshots          SeoPageSnapshot[]
  links              SeoCrawlLink[]
  resources          SeoCrawlResource[]
  issues             SeoCrawlIssue[]
  internalLinkGraphs InternalLinkGraph[]

  @@index([organisationId, brandId, createdAt])
  @@index([seoSiteId, status])
  @@index([status, nextRetryAt])
}

model SeoCrawlQueueItem {
  id             String                  @id @default(cuid())
  organisationId String
  seoSiteId      String
  crawlRunId     String
  url            String
  normalisedUrl  String
  depth          Int                     @default(0)
  status         SeoCrawlQueueItemStatus @default(PENDING)
  idempotencyKey String                  @unique
  attemptCount   Int                     @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime                @default(now())

  crawlRun SeoCrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId, status])
  @@index([normalisedUrl, crawlRunId])
}

model SeoCrawlPage {
  id                String   @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  seoSiteId         String
  normalisedUrl     String
  path              String?
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  lastStatusCode    Int?
  isOrphanCandidate Boolean  @default(false)

  organisation                  Organisation                     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                       Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                         Brand                            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite                       SeoSite                          @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  snapshots                     SeoPageSnapshot[]
  outboundLinks                 SeoCrawlLink[]                   @relation("SourcePage")
  inboundLinks                  SeoCrawlLink[]                   @relation("DestinationPage")
  structuredData                SeoStructuredDataItem[]
  issues                        SeoCrawlIssue[]
  keywordPageMappings           SeoKeywordPageMapping[]
  competitorComparisons         SeoCompetitorComparison[]        @relation("BrandPageComparison")
  pillarPages                   SeoPillarPage[]
  supportingPages               SeoSupportingPage[]
  topicClusterMembers           SeoTopicClusterMember[]
  briefTargetPages              SeoContentBrief[]                @relation("BriefTargetPage")
  briefInternalLinkSources      SeoBriefInternalLink[]           @relation("BriefLinkSource")
  briefInternalLinkDestinations SeoBriefInternalLink[]           @relation("BriefLinkDestination")
  onPageSeoAudits               OnPageSeoAudit[]
  internalLinkNodes             InternalLinkNode[]
  trackedKeywordTargets         SeoTrackedKeyword[]
  rankingUrls                   SeoRankingUrl[]
  contentRefreshCandidates      SeoContentRefreshCandidate[]
  advertisingDestinations       AdvertisingCampaignDestination[]

  @@unique([seoSiteId, normalisedUrl])
  @@index([organisationId, brandId])
}

model SeoPageSnapshot {
  id              String   @id @default(cuid())
  organisationId  String
  seoSiteId       String
  crawlRunId      String
  pageId          String
  requestedUrl    String
  finalUrl        String
  statusCode      Int
  contentType     String?
  responseTimeMs  Int?
  contentHash     String?
  title           String?
  description     String?
  canonicalUrl    String?
  robotsDirective String?
  lang            String?
  wordCount       Int?
  headings        Json?
  openGraph       Json?
  twitterCard     Json?
  redirectChain   Json?
  extractedAt     DateTime @default(now())
  parserVersion   String   @default("1.0")
  rawReference    String?
  createdAt       DateTime @default(now())

  organisation    Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  crawlRun        SeoCrawlRun             @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  page            SeoCrawlPage            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  links           SeoCrawlLink[]
  structuredData  SeoStructuredDataItem[]
  issues          SeoCrawlIssue[]
  onPageSeoAudits OnPageSeoAudit[]

  @@index([crawlRunId])
  @@index([pageId, createdAt])
}

model SeoCrawlLink {
  id                String      @id @default(cuid())
  organisationId    String
  seoSiteId         String
  crawlRunId        String
  snapshotId        String?
  sourcePageId      String
  destinationPageId String?
  sourceUrl         String
  destinationUrl    String
  linkType          SeoLinkType
  anchorText        String?
  rel               String?
  isFollowed        Boolean     @default(true)
  isImageLink       Boolean     @default(false)
  statusCode        Int?
  firstSeenAt       DateTime    @default(now())
  lastSeenAt        DateTime    @default(now())

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  crawlRun        SeoCrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  snapshot        SeoPageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  sourcePage      SeoCrawlPage     @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  destinationPage SeoCrawlPage?    @relation("DestinationPage", fields: [destinationPageId], references: [id], onDelete: SetNull)

  @@index([crawlRunId, linkType])
  @@index([sourcePageId])
}

model SeoCrawlResource {
  id             String   @id @default(cuid())
  organisationId String
  crawlRunId     String
  url            String
  resourceType   String
  statusCode     Int?
  contentLength  Int?
  contentType    String?
  fetchedAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  crawlRun     SeoCrawlRun  @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  @@index([crawlRunId])
}

model SeoIssueDefinition {
  id          String           @id @default(cuid())
  ruleId      String           @unique
  version     Int              @default(1)
  name        String
  description String
  severity    SeoIssueSeverity
  category    String
  isActive    Boolean          @default(true)
  thresholds  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  issues SeoCrawlIssue[]
}

model SeoCrawlIssue {
  id                String           @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  seoSiteId         String
  crawlRunId        String
  pageId            String?
  snapshotId        String?
  ruleId            String
  ruleVersion       Int
  severity          SeoIssueSeverity
  status            SeoIssueStatus   @default(OPEN)
  affectedUrl       String
  evidence          Json
  explanation       String
  recommendedAction String?
  detectedAt        DateTime         @default(now())
  resolvedAt        DateTime?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite              @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  crawlRun     SeoCrawlRun          @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  page         SeoCrawlPage?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  snapshot     SeoPageSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  definition   SeoIssueDefinition   @relation(fields: [ruleId], references: [ruleId])
  resolutions  SeoIssueResolution[]

  @@index([organisationId, brandId, status])
  @@index([crawlRunId, severity])
  @@index([seoSiteId, ruleId])
}

model SeoIssueResolution {
  id               String         @id @default(cuid())
  organisationId   String
  issueId          String
  status           SeoIssueStatus
  note             String?
  resolvedByUserId String?
  createdAt        DateTime       @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  issue        SeoCrawlIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  resolvedBy   UserProfile?  @relation("SeoIssueResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([issueId])
}

model SeoRobotsSnapshot {
  id              String   @id @default(cuid())
  organisationId  String
  seoSiteId       String
  fetchedUrl      String
  httpStatus      Int
  contentHash     String?
  content         String?
  crawlDelay      Int?
  sitemapUrls     String[] @default([])
  applicableRules Json?
  parsingWarnings String[] @default([])
  fetchedAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  seoSite      SeoSite      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)

  @@index([seoSiteId, fetchedAt])
}

model SeoSitemap {
  id              String    @id @default(cuid())
  organisationId  String
  seoSiteId       String
  sitemapUrl      String
  sitemapType     String    @default("urlset")
  httpStatus      Int?
  lastModified    DateTime?
  discoveredCount Int       @default(0)
  parsingErrors   String[]  @default([])
  contentHash     String?
  fetchedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  seoSite      SeoSite         @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  urls         SeoSitemapUrl[]

  @@unique([seoSiteId, sitemapUrl])
  @@index([organisationId])
}

model SeoSitemapUrl {
  id         String    @id @default(cuid())
  sitemapId  String
  loc        String
  lastmod    DateTime?
  changefreq String?
  priority   Float?
  createdAt  DateTime  @default(now())

  sitemap SeoSitemap @relation(fields: [sitemapId], references: [id], onDelete: Cascade)

  @@unique([sitemapId, loc])
  @@index([sitemapId])
}

model SeoStructuredDataItem {
  id               String   @id @default(cuid())
  organisationId   String
  seoSiteId        String
  pageId           String
  snapshotId       String?
  schemaType       String
  format           String   @default("json-ld")
  parsedContent    Json?
  validationStatus String   @default("UNKNOWN")
  parsingError     String?
  createdAt        DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  page         SeoCrawlPage     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot     SeoPageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([seoSiteId, schemaType])
}

// ---------------------------------------------------------------------------
// Keyword intelligence (Task 4.2)
// ---------------------------------------------------------------------------

enum SeoKeywordStatus {
  ACTIVE
  WATCHING
  EXCLUDED
  ARCHIVED
}

enum SeoKeywordSourceType {
  SEARCH_CONSOLE
  MANUAL
  CSV_IMPORT
  SITE_CONTENT
  INTERNAL_SEARCH
  PROVIDER_EXTENSION
  AI_SUGGESTION
}

enum SeoKeywordIntentType {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
  LOCAL
  SUPPORT
  MIXED
  UNKNOWN
}

enum SeoKeywordPageRelationType {
  PRIMARY_TARGET
  SECONDARY_TARGET
  CURRENTLY_RANKING
  POTENTIAL_TARGET
  CONFLICTING_TARGET
  NOT_RELEVANT
}

enum SeoCannibalisationStatus {
  POSSIBLE
  LIKELY
  CONFIRMED
  DISMISSED
}

enum SeoKeywordMetricType {
  IMPRESSIONS
  CLICKS
  CTR
  AVERAGE_POSITION
  SEARCH_VOLUME
  CPC
  COMPETITION
  DIFFICULTY
  TREND
  RESULT_COUNT
  RANKING_URL
  RANK_POSITION
}

enum SeoKeywordOpportunityType {
  HIGH_IMPRESSIONS_LOW_CTR
  POSITION_4_TO_20
  INCREASING_IMPRESSIONS
  DECLINING_POSITION
  NO_TARGET_PAGE
  WEAK_TARGET_PAGE
  BRANDED_NO_RESULT
  INCOMPLETE_CLUSTER
}

enum SeoKeywordEntityType {
  PRODUCT
  ORGANISATION
  LOCATION
  SECTOR
  SERVICE
  PROBLEM
  AUDIENCE
  REGULATION
  TECHNOLOGY
  OTHER
}

enum SeoKeywordImportStatus {
  VALIDATING
  PREVIEW
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model SeoKeyword {
  id                String               @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  seoSiteId         String?
  normalisedKeyword String
  displayKeyword    String
  language          String               @default("en")
  country           String?
  locale            String?
  status            SeoKeywordStatus     @default(ACTIVE)
  primaryIntent     SeoKeywordIntentType @default(UNKNOWN)
  sourceCount       Int                  @default(0)
  firstSeenAt       DateTime             @default(now())
  lastSeenAt        DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organisation        Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand               Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite             SeoSite?                   @relation(fields: [seoSiteId], references: [id], onDelete: SetNull)
  sources             SeoKeywordSource[]
  metrics             SeoKeywordMetric[]
  metricSnapshots     SeoKeywordMetricSnapshot[]
  intents             SeoKeywordIntent[]
  entities            SeoKeywordEntity[]
  pageMappings        SeoKeywordPageMapping[]
  tags                SeoKeywordTag[]
  groupMembers        SeoKeywordGroupMember[]
  opportunities       SeoKeywordOpportunity[]
  statusHistory       SeoKeywordStatusHistory[]
  keywordOverlaps     SeoKeywordOverlap[]
  topicClusterMembers SeoTopicClusterMember[]
  briefKeywords       SeoBriefKeyword[]
  primaryBriefs       SeoContentBrief[]          @relation("BriefPrimaryKeyword")
  onPageSeoAudits     OnPageSeoAudit[]
  onPageSeoTargets    OnPageSeoTarget[]
  trackedKeywords     SeoTrackedKeyword[]

  @@unique([brandId, normalisedKeyword, language, country])
  @@index([organisationId, brandId, status])
  @@index([seoSiteId])
  @@index([primaryIntent])
}

model SeoKeywordSource {
  id             String               @id @default(cuid())
  organisationId String
  keywordId      String
  sourceType     SeoKeywordSourceType
  provider       String?
  externalId     String?
  isSuggestion   Boolean              @default(false)
  confidence     Float?
  metadata       Json?
  firstSeenAt    DateTime             @default(now())
  lastSeenAt     DateTime             @default(now())
  createdAt      DateTime             @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, sourceType, externalId])
  @@index([keywordId, sourceType])
}

model SeoKeywordMetric {
  id                 String               @id @default(cuid())
  organisationId     String
  keywordId          String
  metricType         SeoKeywordMetricType
  provider           String
  source             SeoKeywordSourceType
  location           String?
  language           String?
  value              Float?
  stringValue        String?
  measuredAt         DateTime
  periodStart        DateTime?
  periodEnd          DateTime?
  confidence         Float?
  freshness          String?
  providerDefinition String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword                 @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  snapshots    SeoKeywordMetricSnapshot[]

  @@unique([keywordId, metricType, provider, source, location, language, measuredAt])
  @@index([keywordId, metricType])
}

model SeoKeywordMetricSnapshot {
  id             String               @id @default(cuid())
  organisationId String
  keywordId      String
  metricId       String
  metricType     SeoKeywordMetricType
  value          Float?
  stringValue    String?
  measuredAt     DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  idempotencyKey String               @unique
  createdAt      DateTime             @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword       @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  metric       SeoKeywordMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@index([keywordId, measuredAt])
}

model SeoKeywordGroup {
  id             String   @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  description    String?
  groupType      String   @default("topic")
  isAiSuggested  Boolean  @default(false)
  isConfirmed    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  members          SeoKeywordGroupMember[]
  onPageSeoAudits  OnPageSeoAudit[]
  onPageSeoTargets OnPageSeoTarget[]

  @@unique([brandId, name])
  @@index([organisationId, brandId])
}

model SeoKeywordGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  keywordId String
  addedAt   DateTime @default(now())

  group   SeoKeywordGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  keyword SeoKeyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([groupId, keywordId])
  @@index([keywordId])
}

model SeoKeywordIntent {
  id                 String               @id @default(cuid())
  organisationId     String
  keywordId          String
  intent             SeoKeywordIntentType
  confidence         Float?
  source             String               @default("deterministic")
  evidence           Json?
  isManualOverride   Boolean              @default(false)
  overriddenByUserId String?
  modelId            String?
  promptVersion      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  overriddenBy UserProfile? @relation("SeoKeywordIntentOverrider", fields: [overriddenByUserId], references: [id], onDelete: SetNull)

  @@index([keywordId, createdAt])
}

model SeoKeywordEntity {
  id                String               @id @default(cuid())
  organisationId    String
  keywordId         String
  entityType        SeoKeywordEntityType
  canonicalValue    String
  confidence        Float?
  source            String               @default("ai")
  isConfirmed       Boolean              @default(false)
  confirmedByUserId String?
  createdAt         DateTime             @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  confirmedBy  UserProfile? @relation("SeoKeywordEntityConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([keywordId, entityType])
}

model SeoKeywordPageMapping {
  id             String                     @id @default(cuid())
  organisationId String
  keywordId      String
  pageId         String?
  intendedUrl    String?
  relationType   SeoKeywordPageRelationType
  confidence     Float?
  evidence       Json?
  isManual       Boolean                    @default(false)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword    @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  page         SeoCrawlPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([keywordId, relationType])
  @@index([pageId])
}

model SeoKeywordTag {
  id        String   @id @default(cuid())
  keywordId String
  tag       String
  createdAt DateTime @default(now())

  keyword SeoKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, tag])
  @@index([tag])
}

model SeoKeywordImport {
  id              String                 @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  seoSiteId       String?
  status          SeoKeywordImportStatus @default(VALIDATING)
  fileName        String
  provider        String                 @default("CSV_IMPORT")
  rowCount        Int                    @default(0)
  acceptedCount   Int                    @default(0)
  rejectedCount   Int                    @default(0)
  idempotencyKey  String                 @unique
  columnMappings  Json?
  preview         Json?
  rejectedRows    Json?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy    UserProfile? @relation("SeoKeywordImportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, status])
}

model SeoKeywordOpportunity {
  id                String                    @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  keywordId         String
  opportunityType   SeoKeywordOpportunityType
  severity          String                    @default("MEDIUM")
  title             String
  explanation       String
  evidence          Json
  recommendedAction String?
  status            String                    @default("OPEN")
  detectedAt        DateTime                  @default(now())
  dismissedAt       DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId, status])
  @@index([keywordId, opportunityType])
}

model SeoKeywordStatusHistory {
  id              String            @id @default(cuid())
  organisationId  String
  keywordId       String
  fromStatus      SeoKeywordStatus?
  toStatus        SeoKeywordStatus
  note            String?
  changedByUserId String?
  createdAt       DateTime          @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword   @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  changedBy    UserProfile? @relation("SeoKeywordStatusChanger", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([keywordId, createdAt])
}

// ---------------------------------------------------------------------------
// Competitor search intelligence (Task 4.3)
// ---------------------------------------------------------------------------

enum SeoCompetitorType {
  DIRECT
  INDIRECT
  SEARCH_COMPETITOR
  CONTENT_COMPETITOR
  ASPIRATIONAL
  OTHER
}

enum SeoCompetitorStatus {
  ACTIVE
  ARCHIVED
}

enum SeoCompetitorSnapshotStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  BLOCKED
  CANCELLED
}

enum SeoContentGapType {
  TOPIC_COVERAGE
  MISSING_PAGE
  WEAK_PAGE
  MISSING_FORMAT
  MISSING_FUNNEL_STAGE
  MISSING_FAQ_GLOSSARY
}

enum SeoContentGapStatus {
  OPEN
  ACKNOWLEDGED
  PLANNED
  DISMISSED
}

enum SeoKeywordOverlapType {
  SHARED
  BRAND_UNIQUE
  COMPETITOR_UNIQUE
}

model SeoCompetitor {
  id             String              @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  competitorType SeoCompetitorType   @default(DIRECT)
  status         SeoCompetitorStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  archivedAt     DateTime?

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domains         SeoCompetitorDomain[]
  snapshots       SeoCompetitorSnapshot[]
  pages           SeoCompetitorPage[]
  keywords        SeoCompetitorKeyword[]
  topics          SeoCompetitorTopic[]
  comparisons     SeoCompetitorComparison[]
  keywordOverlaps SeoKeywordOverlap[]
  contentGaps     SeoContentGap[]

  @@unique([brandId, name])
  @@index([organisationId, brandId, status])
}

model SeoCompetitorDomain {
  id             String   @id @default(cuid())
  organisationId String
  competitorId   String
  hostname       String
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, hostname])
  @@index([hostname])
}

model SeoCompetitorSnapshot {
  id              String                      @id @default(cuid())
  organisationId  String
  competitorId    String
  status          SeoCompetitorSnapshotStatus @default(QUEUED)
  pagesDiscovered Int                         @default(0)
  pagesCrawled    Int                         @default(0)
  pagesBlocked    Int                         @default(0)
  idempotencyKey  String                      @unique
  startedAt       DateTime?
  completedAt     DateTime?
  lastError       String?
  createdAt       DateTime                    @default(now())

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  pages        SeoCompetitorPage[]
  evidence     SeoCompetitorEvidence[]

  @@index([competitorId, createdAt])
  @@index([status])
}

model SeoCompetitorPage {
  id                String    @id @default(cuid())
  organisationId    String
  competitorId      String
  snapshotId        String?
  url               String
  normalisedUrl     String
  statusCode        Int?
  title             String?
  description       String?
  canonicalUrl      String?
  headings          Json?
  wordCount         Int?
  structuredData    Json?
  internalLinkCount Int?
  detectedTopics    String[]  @default([])
  contentType       String?
  contentHash       String?
  ctaType           String?
  observedAt        DateTime  @default(now())
  previousHash      String?
  changedAt         DateTime?

  organisation Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor             @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  snapshot     SeoCompetitorSnapshot?    @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  evidence     SeoCompetitorEvidence[]
  comparisons  SeoCompetitorComparison[] @relation("CompetitorPageComparison")

  @@unique([competitorId, normalisedUrl])
  @@index([competitorId, observedAt])
}

model SeoCompetitorKeyword {
  id                String   @id @default(cuid())
  organisationId    String
  competitorId      String
  keyword           String
  normalisedKeyword String
  source            String
  observedAt        DateTime
  position          Float?
  rankingUrl        String?
  provider          String?
  isManual          Boolean  @default(false)
  createdAt         DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor       @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  overlaps     SeoKeywordOverlap[]

  @@unique([competitorId, normalisedKeyword, source, observedAt])
  @@index([competitorId])
}

model SeoKeywordOverlap {
  id                  String                @id @default(cuid())
  organisationId      String
  brandId             String
  competitorId        String
  brandKeywordId      String?
  competitorKeywordId String?
  keyword             String
  overlapType         SeoKeywordOverlapType
  brandPosition       Float?
  competitorPosition  Float?
  brandUrl            String?
  competitorUrl       String?
  sourceCoverage      Json?
  evidence            Json?
  calculatedAt        DateTime              @default(now())

  organisation      Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand             Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competitor        SeoCompetitor         @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  brandKeyword      SeoKeyword?           @relation(fields: [brandKeywordId], references: [id], onDelete: SetNull)
  competitorKeyword SeoCompetitorKeyword? @relation(fields: [competitorKeywordId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, competitorId])
  @@index([overlapType])
}

model SeoContentGap {
  id                  String              @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String
  competitorId        String
  gapType             SeoContentGapType
  status              SeoContentGapStatus @default(OPEN)
  topic               String?
  keyword             String?
  title               String
  explanation         String
  evidence            Json
  recommendedAction   String?
  originalityGuidance String?
  detectedAt          DateTime            @default(now())

  organisation   Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competitor     SeoCompetitor           @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  gapPlans       SeoContentGapPlan[]
  clusterMembers SeoTopicClusterMember[]

  @@index([organisationId, brandId, status])
  @@index([competitorId, gapType])
}

model SeoCompetitorTopic {
  id             String   @id @default(cuid())
  organisationId String
  competitorId   String
  topic          String
  pageCount      Int      @default(0)
  evidence       Json?
  detectedAt     DateTime @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  competitor   SeoCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, topic])
  @@index([competitorId])
}

model SeoCompetitorComparison {
  id               String   @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  competitorId     String
  brandPageId      String?
  competitorPageId String?
  brandUrl         String?
  competitorUrl    String?
  comparison       Json
  aiSummary        Json?
  limitations      String?
  createdAt        DateTime @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  competitor     SeoCompetitor      @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  brandPage      SeoCrawlPage?      @relation("BrandPageComparison", fields: [brandPageId], references: [id], onDelete: SetNull)
  competitorPage SeoCompetitorPage? @relation("CompetitorPageComparison", fields: [competitorPageId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, competitorId])
}

model SeoCompetitorEvidence {
  id             String   @id @default(cuid())
  organisationId String
  snapshotId     String?
  pageId         String?
  evidenceType   String
  url            String?
  excerpt        String?
  metadata       Json?
  collectedAt    DateTime @default(now())

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  snapshot     SeoCompetitorSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  page         SeoCompetitorPage?     @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([snapshotId])
  @@index([pageId])
}

// ---------------------------------------------------------------------------
// Topic clusters and SEO content strategy (Task 4.4)
// ---------------------------------------------------------------------------

enum SeoTopicStatus {
  ACTIVE
  ARCHIVED
}

enum SeoTopicClusterStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  ARCHIVED
}

enum SeoTopicClusterMemberType {
  KEYWORD
  PAGE
  ENTITY
  COMPETITOR_GAP
}

enum SeoContentFormatType {
  PILLAR
  SUPPORTING_ARTICLE
  LANDING_PAGE
  COMPARISON
  GUIDE
  FAQ
  GLOSSARY
  CASE_STUDY
  DOCUMENTATION
  TOOL
  OTHER
}

enum SeoFunnelStage {
  AWARENESS
  CONSIDERATION
  DECISION
  ACTIVATION
  RETENTION
  SUPPORT
  UNSPECIFIED
}

enum SeoRoadmapStatus {
  IDEA
  RESEARCH
  BRIEF_REQUIRED
  BRIEF_READY
  DRAFTING
  REVIEW
  PUBLISH_READY
  PUBLISHED
  REFRESH_REQUIRED
  ARCHIVED
}

enum SeoContentStrategyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model SeoTopic {
  id             String         @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  slug           String
  description    String?
  funnelStage    SeoFunnelStage @default(UNSPECIFIED)
  status         SeoTopicStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  clusters     SeoTopicCluster[]

  @@unique([brandId, slug])
  @@index([organisationId, brandId, status])
}

model SeoTopicCluster {
  id             String                @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  topicId        String?
  name           String
  slug           String
  description    String?
  status         SeoTopicClusterStatus @default(DRAFT)
  confidence     Float?
  evidence       Json?
  namingSource   String                @default("deterministic")
  isAiSuggested  Boolean               @default(false)
  isConfirmed    Boolean               @default(false)
  confirmedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organisation      Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand             Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  topic             SeoTopic?                 @relation(fields: [topicId], references: [id], onDelete: SetNull)
  members           SeoTopicClusterMember[]
  entities          SeoTopicEntity[]
  pillarPages       SeoPillarPage[]
  supportingPages   SeoSupportingPage[]
  gapPlans          SeoContentGapPlan[]
  priorityScores    SeoContentPriorityScore[]
  contentBriefs     SeoContentBrief[]
  onPageSeoAudits   OnPageSeoAudit[]
  onPageSeoTargets  OnPageSeoTarget[]
  internalLinkNodes InternalLinkNode[]

  @@unique([brandId, slug])
  @@index([organisationId, brandId, status])
}

model SeoTopicClusterMember {
  id                  String                    @id @default(cuid())
  organisationId      String
  clusterId           String
  memberType          SeoTopicClusterMemberType
  keywordId           String?
  pageId              String?
  entityId            String?
  contentGapId        String?
  isManuallyConfirmed Boolean                   @default(false)
  isLocked            Boolean                   @default(false)
  confidence          Float?
  evidence            Json?
  addedAt             DateTime                  @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  keyword      SeoKeyword?     @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  page         SeoCrawlPage?   @relation(fields: [pageId], references: [id], onDelete: SetNull)
  entity       SeoTopicEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  contentGap   SeoContentGap?  @relation(fields: [contentGapId], references: [id], onDelete: SetNull)

  @@index([clusterId, memberType])
  @@index([keywordId])
  @@index([pageId])
}

model SeoTopicEntity {
  id             String               @id @default(cuid())
  organisationId String
  brandId        String
  clusterId      String?
  entityType     SeoKeywordEntityType
  canonicalValue String
  source         String               @default("clustering")
  confidence     Float?
  isConfirmed    Boolean              @default(false)
  createdAt      DateTime             @default(now())

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster      SeoTopicCluster?        @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  members      SeoTopicClusterMember[]

  @@index([clusterId])
  @@index([organisationId, brandId])
}

model SeoPillarPage {
  id               String               @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  clusterId        String
  formatType       SeoContentFormatType @default(PILLAR)
  title            String
  targetUrl        String?
  existingPageId   String?
  funnelStage      SeoFunnelStage       @default(UNSPECIFIED)
  isManualOverride Boolean              @default(false)
  roadmapStatus    SeoRoadmapStatus     @default(IDEA)
  contentItemId    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster         SeoTopicCluster           @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  existingPage    SeoCrawlPage?             @relation(fields: [existingPageId], references: [id], onDelete: SetNull)
  contentItem     ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  supportingPages SeoSupportingPage[]
  priorityScores  SeoContentPriorityScore[]

  @@index([clusterId])
  @@index([organisationId, brandId, roadmapStatus])
}

model SeoSupportingPage {
  id               String               @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  clusterId        String
  pillarPageId     String?
  formatType       SeoContentFormatType @default(SUPPORTING_ARTICLE)
  title            String
  targetUrl        String?
  existingPageId   String?
  funnelStage      SeoFunnelStage       @default(UNSPECIFIED)
  sequenceOrder    Int                  @default(0)
  isManualOverride Boolean              @default(false)
  roadmapStatus    SeoRoadmapStatus     @default(IDEA)
  contentItemId    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster        SeoTopicCluster           @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  pillarPage     SeoPillarPage?            @relation(fields: [pillarPageId], references: [id], onDelete: SetNull)
  existingPage   SeoCrawlPage?             @relation(fields: [existingPageId], references: [id], onDelete: SetNull)
  contentItem    ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  priorityScores SeoContentPriorityScore[]

  @@index([clusterId, pillarPageId])
  @@index([organisationId, brandId, roadmapStatus])
}

model SeoContentGapPlan {
  id             String               @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  clusterId      String?
  contentGapId   String?
  title          String
  explanation    String?
  formatType     SeoContentFormatType @default(GUIDE)
  funnelStage    SeoFunnelStage       @default(UNSPECIFIED)
  roadmapStatus  SeoRoadmapStatus     @default(IDEA)
  contentItemId  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  cluster        SeoTopicCluster?          @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  contentGap     SeoContentGap?            @relation(fields: [contentGapId], references: [id], onDelete: SetNull)
  contentItem    ContentItem?              @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  priorityScores SeoContentPriorityScore[]

  @@index([organisationId, brandId, roadmapStatus])
  @@index([clusterId])
}

model SeoContentStrategy {
  id               String                   @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  status           SeoContentStrategyStatus @default(DRAFT)
  currentVersionId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions     SeoContentStrategyVersion[]

  @@unique([brandId, name])
  @@index([organisationId, brandId, status])
}

model SeoContentStrategyVersion {
  id              String    @id @default(cuid())
  organisationId  String
  strategyId      String
  versionNumber   Int
  summary         Json
  clusterSnapshot Json?
  aiProposals     Json?
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  strategy     SeoContentStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  createdBy    UserProfile        @relation("SeoContentStrategyVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([strategyId, versionNumber])
  @@index([strategyId, createdAt])
}

model SeoContentPriorityScore {
  id               String   @id @default(cuid())
  organisationId   String
  brandId          String
  clusterId        String?
  gapPlanId        String?
  pillarPageId     String?
  supportingPageId String?
  scoreVersion     String   @default("1.0")
  totalScore       Float?
  factors          Json
  missingFactors   String[] @default([])
  calculatedAt     DateTime @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  cluster        SeoTopicCluster?   @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  gapPlan        SeoContentGapPlan? @relation(fields: [gapPlanId], references: [id], onDelete: SetNull)
  pillarPage     SeoPillarPage?     @relation(fields: [pillarPageId], references: [id], onDelete: SetNull)
  supportingPage SeoSupportingPage? @relation(fields: [supportingPageId], references: [id], onDelete: SetNull)

  @@index([organisationId, brandId, calculatedAt])
  @@index([clusterId])
}

// ---------------------------------------------------------------------------
// AI SEO content brief generator (Task 4.5)
// ---------------------------------------------------------------------------

enum SeoContentBriefStatus {
  DRAFT
  GENERATED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum SeoBriefKeywordRole {
  PRIMARY
  SECONDARY
}

enum SeoBriefApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum SeoBriefCommentStatus {
  OPEN
  RESOLVED
}

model SeoContentBrief {
  id               String                @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  workingTitle     String?
  contentType      SeoContentFormatType?
  status           SeoContentBriefStatus @default(DRAFT)
  currentVersionId String?
  primaryKeywordId String?
  clusterId        String?
  targetPageId     String?
  contentItemId    String?
  audience         String?
  offer            String?
  cta              String?
  createdByUserId  String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  archivedAt       DateTime?

  organisation         Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project              Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                Brand                         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  primaryKeyword       SeoKeyword?                   @relation("BriefPrimaryKeyword", fields: [primaryKeywordId], references: [id], onDelete: SetNull)
  cluster              SeoTopicCluster?              @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  targetPage           SeoCrawlPage?                 @relation("BriefTargetPage", fields: [targetPageId], references: [id], onDelete: SetNull)
  contentItem          ContentItem?                  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  createdBy            UserProfile                   @relation("SeoContentBriefCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions             SeoContentBriefVersion[]
  keywords             SeoBriefKeyword[]
  questions            SeoBriefQuestion[]
  headings             SeoBriefHeading[]
  competitorEvidence   SeoBriefCompetitorEvidence[]
  internalLinks        SeoBriefInternalLink[]
  schemaSuggestions    SeoBriefSchemaSuggestion[]
  citationRequirements SeoBriefCitationRequirement[]
  approvals            SeoBriefApproval[]
  comments             SeoBriefComment[]
  longFormDocuments    LongFormContentDocument[]
  onPageSeoAudits      OnPageSeoAudit[]

  @@index([organisationId, brandId, status])
  @@index([clusterId])
}

model SeoContentBriefVersion {
  id               String                @id @default(cuid())
  organisationId   String
  briefId          String
  versionNumber    Int
  status           SeoContentBriefStatus
  structuredOutput Json
  evidenceSummary  Json?
  limitations      String?
  aiRequestId      String?
  aiModel          String?
  aiProvider       String?
  changeNote       String?
  createdByUserId  String
  createdAt        DateTime              @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brief        SeoContentBrief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  approvals    SeoBriefApproval[]

