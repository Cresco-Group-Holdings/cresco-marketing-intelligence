generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MARKETER
  ANALYST
  VIEWER
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum BrandStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MarketingObjectiveType {
  BRAND_AWARENESS
  WEBSITE_TRAFFIC
  LEAD_GENERATION
  DEMO_BOOKINGS
  TRIAL_SIGNUPS
  PAID_SUBSCRIPTIONS
  COMMUNITY_GROWTH
  EMAIL_LIST_GROWTH
  SEO_GROWTH
  CUSTOMER_RETENTION
}

enum MarketingObjectiveStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum MarketingChannel {
  WEBSITE
  SEO
  GOOGLE_ADS
  LINKEDIN
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  X
  EMAIL
}

enum OnboardingStepKey {
  ACCOUNT_PROFILE
  ORGANISATION
  PROJECT
  BRAND
  BRAND_PROFILE
  MARKETING_OBJECTIVES
  CHANNEL_PREFERENCES
  REVIEW
}

enum BrandOfferAvailabilityStatus {
  AVAILABLE
  LIMITED
  COMING_SOON
  DISCONTINUED
}

enum BrandAssetType {
  LOGO
  FAVICON
  COLOUR_PALETTE
  FONT
  SCREENSHOT
  PRODUCT_IMAGE
  PRESENTATION
  VIDEO_CLIP
}

enum BrandReferenceType {
  STYLE_GUIDE
  DOCUMENTATION
  EXTERNAL_LINK
  RESEARCH
  OTHER
}

enum BrandComplianceRuleType {
  PROHIBITED_CLAIM
  REQUIRED_DISCLAIMER
  GRANT_ELIGIBILITY
  PRIVACY
  REGULATED_MARKET
  CONTENT_APPROVAL
  OTHER
}

enum BrandComplianceSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MarketingAssetStatus {
  PROCESSING
  READY
  REJECTED
  ARCHIVED
}

enum MarketingAssetType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum AIProviderName {
  OPENAI
  ANTHROPIC
  GOOGLE
  MOCK
}

enum AICapability {
  TEXT_GENERATION
  STRUCTURED_OUTPUT
  IMAGE_GENERATION
  AUDIO_GENERATION
  VIDEO_GENERATION
  EMBEDDINGS
}

enum AIPurpose {
  DIAGNOSTICS_TEST
  BRAND_CONTEXT_SUMMARY
  CONTENT_DRAFT
  SEO_ANALYSIS
  ANALYTICS_INSIGHT
  SALES_ASSIST
}

enum AIRequestStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum AIExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum AIErrorCategory {
  PROVIDER_ERROR
  VALIDATION_ERROR
  RATE_LIMIT
  TIMEOUT
  CANCELLED
  CONFIGURATION_ERROR
  SAFETY_FILTER
  BUDGET_EXCEEDED
  UNKNOWN
}

enum PromptTemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model UserProfile {
  id          String   @id @default(cuid())
  authUserId  String   @unique
  email       String
  displayName String?
  firstName   String?
  lastName    String?
  avatarUrl   String?
  timezone    String?  @default("UTC")
  locale      String?  @default("en-GB")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          OrganisationMembership[]
  auditLogs            AuditLog[]
  workspacePreference  WorkspacePreference?
  invitationsSent      Invitation[]             @relation("InvitationsSent")
  invitationsAccepted  Invitation[]             @relation("InvitationsAccepted")
  organisationsCreated Organisation[]           @relation("OrganisationCreator")
  projectsCreated      Project[]                @relation("ProjectCreator")
  brandsCreated        Brand[]                  @relation("BrandCreator")
  marketingAssetsUploaded MarketingAsset[]      @relation("MarketingAssetUploader")
  aiRequests              AIRequest[]             @relation("AIRequestInitiator")
  promptTemplateVersions  PromptTemplateVersion[] @relation("PromptTemplateVersionCreator")
  securityAuditLogs    SecurityAuditLog[]
  onboardingProgress   OnboardingProgress?
  connectorAccountsConnected ConnectorAccount[] @relation("ConnectorAccountConnector")

  @@index([email])
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  requestId    String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Organisation {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  legalName        String?
  website          String?
  logoUrl          String?
  industry         String?
  countryCode      String?
  defaultTimezone  String?            @default("UTC")
  status           OrganisationStatus @default(ACTIVE)
  createdByUserId  String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  archivedAt       DateTime?

  createdBy     UserProfile              @relation("OrganisationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships   OrganisationMembership[]
  projects      Project[]
  brands        Brand[]
  brandProfiles BrandProfile[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  brandAudiences      BrandAudience[]
  brandPersonas       BrandPersona[]
  brandOffers         BrandOffer[]
  brandMessages       BrandMessage[]
  brandVoiceRules     BrandVoiceRule[]
  brandCompetitors    BrandCompetitor[]
  brandAssets         BrandAsset[]
  brandReferences     BrandReference[]
  brandComplianceRules BrandComplianceRule[]
  marketingAssets      MarketingAsset[]
  aiRequests           AIRequest[]
  aiUsageRecords       AIUsageRecord[]
  promptTemplates      PromptTemplate[]
  connectorAccounts    ConnectorAccount[]
  connectorSyncs       ConnectorSync[]
  connectorErrors      ConnectorError[]
  webhookEndpoints     WebhookEndpoint[]
  connectorOAuthStates ConnectorOAuthState[]

  @@index([status])
  @@index([archivedAt])
  @@index([createdAt])
}

model OrganisationMembership {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(VIEWER)
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         UserProfile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([organisationId])
  @@index([userId])
  @@index([status])
}

model Project {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  slug            String
  description     String?
  website         String?
  status          ProjectStatus @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy     UserProfile    @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  brands        Brand[]
  brandProfiles BrandProfile[]
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  brandAudiences      BrandAudience[]
  brandPersonas       BrandPersona[]
  brandOffers         BrandOffer[]
  brandMessages       BrandMessage[]
  brandVoiceRules     BrandVoiceRule[]
  brandCompetitors    BrandCompetitor[]
  brandAssets         BrandAsset[]
  brandReferences     BrandReference[]
  brandComplianceRules BrandComplianceRule[]
  marketingAssets      MarketingAsset[]
  aiRequests           AIRequest[]
  connectorAccounts    ConnectorAccount[]
  connectorSyncs       ConnectorSync[]
  connectorErrors      ConnectorError[]
  webhookEndpoints     WebhookEndpoint[]
  connectorOAuthStates ConnectorOAuthState[]

  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([status])
  @@index([archivedAt])
}

model Brand {
  id              String      @id @default(cuid())
  organisationId  String
  projectId       String
  name            String
  slug            String
  description     String?
  website         String?
  primaryDomain   String?
  logoUrl         String?
  faviconUrl      String?
  primaryColour   String?
  secondaryColour String?
  accentColour    String?
  status          BrandStatus @default(DRAFT)
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  archivedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    UserProfile  @relation("BrandCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  profile      BrandProfile?
  marketingObjectives MarketingObjective[]
  channelPreferences  BrandChannelPreference[]
  audiences           BrandAudience[]
  personas            BrandPersona[]
  offers              BrandOffer[]
  message             BrandMessage?
  voiceRule           BrandVoiceRule?
  competitors         BrandCompetitor[]
  assets              BrandAsset[]
  references          BrandReference[]
  complianceRules     BrandComplianceRule[]
  marketingAssets       MarketingAsset[]
  aiRequests            AIRequest[]
  connectorAccounts     ConnectorAccount[]
  connectorSyncs        ConnectorSync[]
  connectorErrors       ConnectorError[]
  webhookEndpoints      WebhookEndpoint[]
  connectorOAuthStates  ConnectorOAuthState[]

  @@unique([projectId, slug])
  @@index([organisationId])
  @@index([projectId])
  @@index([status])
  @@index([archivedAt])
}

model BrandProfile {
  id                  String   @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String   @unique
  shortDescription    String?
  longDescription     String?
  mission             String?
  valueProposition    String?
  targetAudience      String?
  customerProblems    String?
  keyBenefits         String?
  productsAndServices String?
  preferredTone       String?
  prohibitedTone      String?
  preferredLanguage   String?
  targetCountries     String[] @default([])
  targetIndustries    String[] @default([])
  competitors         String[] @default([])
  complianceNotes     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model WorkspacePreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  currentOrganisationId String?
  currentProjectId      String?
  currentBrandId        String?
  onboardingCompletedAt DateTime?
  onboardingStep        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentOrganisationId])
  @@index([currentProjectId])
  @@index([currentBrandId])
}

model Invitation {
  id              String           @id @default(cuid())
  organisationId  String
  email           String
  role            OrganisationRole @default(VIEWER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    UserProfile  @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   UserProfile? @relation("InvitationsAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organisationId String
  projectId      String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        UserProfile? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([projectId])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([action])
}

model MarketingObjective {
  id             String                   @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  objectiveType  MarketingObjectiveType
  description    String
  priority       Int                      @default(1)
  targetValue    Decimal                  @db.Decimal(18, 4)
  targetPeriod   String
  status         MarketingObjectiveStatus @default(PLANNED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, objectiveType])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
}

model BrandChannelPreference {
  id             String           @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  channel        MarketingChannel
  enabled        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, channel])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
}

model BrandAudience {
  id               String    @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  name             String
  description      String?
  countries        String[]  @default([])
  industries       String[]  @default([])
  organisationType String?
  companySize      String?
  jobRoles         String[]  @default([])
  painPoints       String[]  @default([])
  motivations      String[]  @default([])
  objections       String[]  @default([])
  buyingTriggers   String[]  @default([])
  preferredChannels String[] @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandPersona {
  id                String    @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  name              String
  description       String?
  roleTitle         String?
  goals             String[]  @default([])
  painPoints        String[]  @default([])
  motivations       String[]  @default([])
  objections        String[]  @default([])
  buyingTriggers    String[]  @default([])
  preferredChannels String[]  @default([])
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  archivedAt        DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandOffer {
  id                      String                       @id @default(cuid())
  organisationId          String
  projectId               String
  brandId                 String
  name                    String
  shortDescription        String?
  features                String[]                     @default([])
  benefits                String[]                     @default([])
  priceDescription        String?
  trialAvailable          Boolean                      @default(false)
  primaryCta              String?
  landingPageUrl          String?
  eligibilityRestrictions String?
  availabilityStatus      BrandOfferAvailabilityStatus @default(AVAILABLE)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  archivedAt              DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandMessage {
  id                  String   @id @default(cuid())
  organisationId      String
  projectId           String
  brandId             String   @unique
  elevatorPitch       String?
  coreMessage         String?
  supportingMessages  String[] @default([])
  proofPoints         String[] @default([])
  differentiators     String[] @default([])
  objectionResponses  Json?
  ctaLibrary          String[] @default([])
  prohibitedClaims    String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model BrandVoiceRule {
  id                    String   @id @default(cuid())
  organisationId        String
  projectId             String
  brandId               String   @unique
  preferredTone         String?
  vocabulary            String[] @default([])
  prohibitedVocabulary  String[] @default([])
  sentenceStyle         String?
  emojiPolicy           String?
  humourPolicy          String?
  preferredSpelling     String?
  languageVariants      String[] @default([])
  approvedExamples      String[] @default([])
  unacceptableExamples  String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
}

model BrandCompetitor {
  id             String    @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  name           String
  website        String?
  description    String?
  strengths      String[]  @default([])
  weaknesses     String[]  @default([])
  positioning    String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandAsset {
  id             String         @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  assetType      BrandAssetType
  name           String
  description    String?
  fileUrl        String?
  mimeType       String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([assetType])
  @@index([archivedAt])
}

model BrandReference {
  id             String             @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  referenceType  BrandReferenceType @default(OTHER)
  title          String
  url            String?
  description    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([archivedAt])
}

model BrandComplianceRule {
  id             String                  @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  ruleType       BrandComplianceRuleType
  title          String
  description    String?
  ruleText       String
  severity       BrandComplianceSeverity @default(WARNING)
  appliesTo      String[]                @default([])
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  archivedAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([ruleType])
  @@index([archivedAt])
}

model MarketingAsset {
  id                   String               @id @default(cuid())
  organisationId       String
  projectId            String
  brandId              String
  filename             String
  originalFilename     String
  storageKey           String               @unique
  mimeType             String
  sizeBytes            Int
  width                Int?
  height               Int?
  durationSeconds      Decimal?             @db.Decimal(10, 3)
  assetType            MarketingAssetType
  title                String
  description          String?
  tags                 String[]             @default([])
  status               MarketingAssetStatus @default(PROCESSING)
  uploadedByUserId     String
  approvedForMarketing Boolean              @default(false)
  approvedPlatforms    String[]             @default([])
  licenceOwner         String?
  licenceNotes         String?
  licenceExpiresAt     DateTime?
  attributionRequired  Boolean              @default(false)
  consentNotes         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  archivedAt           DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  uploadedBy   UserProfile  @relation("MarketingAssetUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([assetType])
  @@index([archivedAt])
  @@index([uploadedByUserId])
}

model AIRequest {
  id               String          @id @default(cuid())
  organisationId   String
  projectId        String?
  brandId          String?
  userProfileId    String
  purpose          AIPurpose
  provider         AIProviderName
  model            String
  status           AIRequestStatus @default(PENDING)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Decimal?        @db.Decimal(12, 6)
  latencyMs        Int?
  requestId        String?
  errorCategory    AIErrorCategory?
  inputDigest      String?
  inputPreview     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  initiatedBy  UserProfile  @relation("AIRequestInitiator", fields: [userProfileId], references: [id], onDelete: Restrict)
  executions   AIExecution[]
  usageRecords AIUsageRecord[]

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([userProfileId])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
  @@index([requestId])
}

model AIExecution {
  id               String            @id @default(cuid())
  aiRequestId      String
  provider         AIProviderName
  model            String
  status           AIExecutionStatus @default(PENDING)
  attemptNumber    Int               @default(1)
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  estimatedCostUsd Decimal?          @db.Decimal(12, 6)
  outputDigest     String?
  outputPreview    String?
  structuredOutput Json?
  errorCategory    AIErrorCategory?
  errorMessage     String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?

  aiRequest    AIRequest      @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  usageRecords AIUsageRecord[]

  @@index([aiRequestId])
  @@index([status])
  @@index([startedAt])
}

model AIUsageRecord {
  id               String         @id @default(cuid())
  organisationId   String
  projectId        String?
  userProfileId    String?
  aiRequestId      String?
  aiExecutionId    String?
  provider         AIProviderName
  model            String
  purpose          AIPurpose
  promptTokens     Int            @default(0)
  completionTokens Int            @default(0)
  totalTokens      Int            @default(0)
  estimatedCostUsd Decimal?       @db.Decimal(12, 6)
  recordedAt       DateTime       @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  aiRequest    AIRequest?   @relation(fields: [aiRequestId], references: [id], onDelete: SetNull)
  aiExecution  AIExecution? @relation(fields: [aiExecutionId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([userProfileId])
  @@index([recordedAt])
  @@index([purpose])
}

model PromptTemplate {
  id              String   @id @default(cuid())
  organisationId  String?
  key             String   @unique
  name            String
  description     String?
  purpose         AIPurpose
  activeVersionId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation  Organisation?           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  versions      PromptTemplateVersion[] @relation("TemplateVersions")
  activeVersion PromptTemplateVersion?  @relation("ActiveTemplateVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([purpose])
}

model PromptTemplateVersion {
  id               String                      @id @default(cuid())
  promptTemplateId String
  version          Int
  systemPrompt     String
  outputSchemaKey  String?
  status           PromptTemplateVersionStatus @default(DRAFT)
  createdByUserId  String?
  createdAt        DateTime                    @default(now())

  promptTemplate  PromptTemplate  @relation("TemplateVersions", fields: [promptTemplateId], references: [id], onDelete: Cascade)
  createdBy       UserProfile?    @relation("PromptTemplateVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  activeForTemplate PromptTemplate? @relation("ActiveTemplateVersion")

  @@unique([promptTemplateId, version])
  @@index([promptTemplateId])
  @@index([status])
}

model OnboardingProgress {
  id             String            @id @default(cuid())
  userId         String            @unique
  organisationId String?
  projectId      String?
  brandId        String?
  currentStep    OnboardingStepKey @default(ACCOUNT_PROFILE)
  completedSteps OnboardingStepKey[] @default([])
  stepData       Json?
  templateKey    String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([currentStep])
}

enum ConnectorType {
  GOOGLE_ANALYTICS_4
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_ADS
  META
  INSTAGRAM
  LINKEDIN
  TIKTOK
  YOUTUBE
  X
  STRIPE
  EMAIL_PROVIDER
  CRM_PROVIDER
}

enum ConnectorPlatformAvailability {
  COMING_SOON
  AVAILABLE
}

enum ConnectorStatus {
  NOT_CONFIGURED
  AVAILABLE
  CONNECTING
  CONNECTED
  ERROR
  REAUTH_REQUIRED
  DISABLED
}

enum ConnectorSyncType {
  INITIAL
  INCREMENTAL
}

enum ConnectorSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum ConnectorErrorCategory {
  AUTHENTICATION
  AUTHORIZATION
  RATE_LIMIT
  NETWORK
  VALIDATION
  PROVIDER
  INTERNAL
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
}

model ConnectorDefinition {
  id                    String                      @id @default(cuid())
  key                   ConnectorType               @unique
  name                  String
  description           String
  category              String
  requiredScopes        String[]                    @default([])
  optionalScopes        String[]                    @default([])
  supportsOAuth         Boolean                     @default(true)
  platformAvailability  ConnectorPlatformAvailability @default(COMING_SOON)
  documentationUrl      String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  accounts ConnectorAccount[]

  @@index([platformAvailability])
}

model ConnectorAccount {
  id                     String          @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  connectorDefinitionId  String
  connectorType          ConnectorType
  status                 ConnectorStatus @default(NOT_CONFIGURED)
  displayName            String?
  externalAccountId      String?
  externalAccountLabel   String?
  grantedScopes          String[]        @default([])
  connectedByUserId      String?
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  lastSuccessfulSyncAt   DateTime?
  lastSyncAttemptAt      DateTime?
  lastErrorAt            DateTime?
  lastErrorMessage       String?
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  organisation  Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand         Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  definition    ConnectorDefinition @relation(fields: [connectorDefinitionId], references: [id], onDelete: Restrict)
  connectedBy   UserProfile?        @relation("ConnectorAccountConnector", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  credential    ConnectorCredential?
  syncs         ConnectorSync[]
  errors        ConnectorError[]
  syncCursors   ConnectorSyncCursor[]
  webhookEndpoints WebhookEndpoint[]

  @@unique([brandId, connectorType])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([connectorType])
}

model ConnectorCredential {
  id                      String   @id @default(cuid())
  connectorAccountId      String   @unique
  encryptionKeyVersion    Int      @default(1)
  encryptedAccessToken    String?
  encryptedRefreshToken   String?
  tokenExpiresAt          DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  connectorAccount ConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)

  @@index([tokenExpiresAt])
}

model ConnectorSync {
  id                 String              @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  connectorAccountId String
  syncType           ConnectorSyncType
  status             ConnectorSyncStatus @default(PENDING)
  idempotencyKey     String
  recordsProcessed   Int                 @default(0)
  recordsFailed      Int                 @default(0)
  partialFailure     Boolean             @default(false)
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectorAccount ConnectorAccount      @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  cursors          ConnectorSyncCursor[]
  errors           ConnectorError[]

  @@unique([connectorAccountId, idempotencyKey])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

model ConnectorSyncCursor {
  id                 String   @id @default(cuid())
  connectorAccountId String
  connectorSyncId    String?
  cursorKey          String
  cursorValue        String
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  connectorAccount ConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  connectorSync    ConnectorSync?   @relation(fields: [connectorSyncId], references: [id], onDelete: SetNull)

  @@unique([connectorAccountId, cursorKey])
  @@index([connectorSyncId])
}

model ConnectorError {
  id                 String                 @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  connectorAccountId String
  connectorSyncId    String?
  category           ConnectorErrorCategory
  message            String
  retryable          Boolean                @default(false)
  metadata           Json?
  occurredAt         DateTime               @default(now())

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectorAccount ConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  connectorSync    ConnectorSync?   @relation(fields: [connectorSyncId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([connectorAccountId])
  @@index([occurredAt])
}

model WebhookEndpoint {
  id                 String                @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  connectorAccountId String?
  path               String
  secretDigest       String
  status             WebhookEndpointStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectorAccount ConnectorAccount? @relation(fields: [connectorAccountId], references: [id], onDelete: SetNull)
  events           WebhookEvent[]

  @@unique([brandId, path])
  @@index([organisationId])
  @@index([status])
}

model WebhookEvent {
  id                String             @id @default(cuid())
  webhookEndpointId String
  idempotencyKey    String
  payloadDigest     String
  status            WebhookEventStatus @default(PENDING)
  errorMessage      String?
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?

  webhookEndpoint WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@unique([webhookEndpointId, idempotencyKey])
  @@index([status])
  @@index([receivedAt])
}

model ConnectorOAuthState {
  id             String        @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  connectorType  ConnectorType
  state          String        @unique
  codeVerifier   String?
  scopes         String[]      @default([])
  redirectUri    String
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([brandId])
  @@index([expiresAt])
}
