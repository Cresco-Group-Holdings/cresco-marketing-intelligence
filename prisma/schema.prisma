  socialConnectionId String
  provider           SocialProvider
  providerAccountId  String
  accountType        SocialAccountType
  username           String?
  displayName        String?
  profileUrl         String?
  avatarUrl          String?
  status             SocialConnectionStatus @default(CONNECTED)
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organisation     Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection          @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  capabilities     SocialAccountCapability[]
  contentVariants  ContentVariant[]
  schedules        ContentSchedule[]

  @@unique([socialConnectionId, providerAccountId])
  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([provider])
  @@index([status])
}

model SocialAccountCapability {
  id              String           @id @default(cuid())
  socialAccountId String
  capability      SocialCapability
  createdAt       DateTime         @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, capability])
  @@index([capability])
}

model OAuthAuthorisationState {
  id                 String         @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  userId             String
  socialConnectionId String
  provider           SocialProvider
  state              String         @unique
  codeVerifier       String?
  scopes             String[]       @default([])
  redirectUri        String
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime       @default(now())

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user             UserProfile      @relation("OAuthAuthorisationUser", fields: [userId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([brandId])
  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model CredentialRotationEvent {
  id                 String                   @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  socialConnectionId String
  fromKeyVersion     Int
  toKeyVersion       Int
  reason             CredentialRotationReason
  rotatedByUserId    String?
  createdAt          DateTime                 @default(now())

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  rotatedBy        UserProfile?     @relation("CredentialRotationActor", fields: [rotatedByUserId], references: [id], onDelete: SetNull)

  @@index([socialConnectionId])
  @@index([createdAt])
}

enum ContentType {
  TEXT_POST
  IMAGE_POST
  CAROUSEL
  SHORT_VIDEO
  LONG_VIDEO
  STORY
  ARTICLE_LINK
  POLL
  THREAD
}

enum ContentStatus {
  IDEA
  DRAFT
  AI_GENERATED
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
  ARCHIVED
}

enum ContentScheduleStatus {
  DRAFT
  READY
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

model ContentSchedule {
  id               String                @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  contentItemId    String
  contentVariantId String
  socialAccountId  String
  scheduledFor     DateTime
  timezone         String
  status           ContentScheduleStatus @default(DRAFT)
  recurrence       Json?
  occurrenceIndex  Int                   @default(1)
  createdByUserId  String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cancelledAt      DateTime?

  contentItem    ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant       @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  socialAccount  SocialAccount        @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  jobs           PublishingJob[]
  conflicts      SchedulingConflict[]

  @@unique([contentVariantId, scheduledFor])
  @@index([organisationId])
  @@index([brandId])
  @@index([scheduledFor])
}

enum TikTokPrivacyLevel {
  PUBLIC_TO_EVERYONE
  MUTUAL_FOLLOW_FRIENDS
  FOLLOWER_OF_CREATOR
  SELF_ONLY
}

/// User-selected TikTok posting settings. Stored per variant so a publish never
/// infers privacy or interaction defaults on the creator's behalf.
model TikTokPublishSetting {
  id                     String             @id @default(cuid())
  organisationId         String
  projectId              String
  brandId                String
  contentVariantId       String             @unique
  privacyLevel           TikTokPrivacyLevel
  disableComment         Boolean            @default(false)
  disableDuet            Boolean            @default(false)
  disableStitch          Boolean            @default(false)
  commercialContent      Boolean            @default(false)
  brandOrganicToggle     Boolean            @default(false)
  brandedContentToggle   Boolean            @default(false)
  videoCoverTimestampMs  Int?
  creatorOptionsSnapshot Json
  selectedByUserId       String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  contentVariant ContentVariant @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([brandId])
}

model PublishingWindow {
  id             String         @id @default(cuid())
  organisationId String
  brandId        String
  provider       SocialProvider
  timezone       String
  weekdays       Int[]          @default([])
  startMinute    Int
  endMinute      Int
  createdAt      DateTime       @default(now())

  @@index([organisationId])
}

model PublishingJob {
  id                String                @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  contentScheduleId String
  idempotencyKey    String
  status            ContentScheduleStatus @default(QUEUED)
  attemptCount      Int                   @default(0)
  maxAttempts       Int                   @default(3)

  providerContainerId String?
  providerStatus      String?
  pollingAttemptCount Int       @default(0)
  nextPollAt          DateTime?
  lastProviderError   String?
  publishedMediaId    String?   @unique
  permalink           String?
  refreshAttemptCount Int       @default(0)
  providerSettings    Json?
  providerUploadState Json?

  directPublishAvailable  Boolean   @default(true)
  manualPublicUrl         String?
  manualConfirmedAt       DateTime?
  manualConfirmedByUserId String?

  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  schedule  ContentSchedule     @relation(fields: [contentScheduleId], references: [id], onDelete: Cascade)
  attempts  PublishingAttempt[]

  @@unique([contentScheduleId, idempotencyKey])
}

model PublishingAttempt {
  id               String        @id @default(cuid())
  publishingJobId  String
  attemptNumber    Int
  status           String
  providerResponse Json?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  job              PublishingJob @relation(fields: [publishingJobId], references: [id], onDelete: Cascade)

  @@unique([publishingJobId, attemptNumber])
}

model SchedulingConflict {
  id                String          @id @default(cuid())
  contentScheduleId String
  conflictType      String
  message           String
  createdAt         DateTime        @default(now())
  schedule          ContentSchedule @relation(fields: [contentScheduleId], references: [id], onDelete: Cascade)
}

model CalendarNote {
  id              String   @id @default(cuid())
  organisationId  String
  projectId       String?
  brandId         String?
  noteDate        DateTime
  timezone        String
  body            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organisationId])
  @@index([noteDate])
}

enum ContentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContentRevisionSource {
  USER
  AI
  IMPORT
  PLATFORM_ADAPTATION
  COMPLIANCE_FIX
}

enum ContentApprovalMode {
  NO_APPROVAL_REQUIRED
  ONE_APPROVER
  TWO_APPROVERS
  COMPLIANCE_APPROVAL_REQUIRED
}

enum ContentApprovalDecision {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ContentCommentStatus {
  OPEN
  RESOLVED
}

enum ContentComplianceCheckType {
  MISSING_DISCLAIMER
  PROHIBITED_CLAIM
  MISSING_DESTINATION_URL
  MISSING_ALT_TEXT
  UNAPPROVED_ASSET
  EXPIRED_ASSET_LICENCE
  UNSUPPORTED_PLATFORM_FORMAT
  EXCESSIVE_TEXT_LENGTH
  UNAPPROVED_MUSIC
  MISSING_CONSENT
}

enum ContentComplianceResult {
  PASS
  FAIL
  WARNING
}

model OrganisationContentSettings {
  id                        String              @id @default(cuid())
  organisationId            String              @unique
  approvalMode              ContentApprovalMode @default(ONE_APPROVER)
  separationOfDutiesEnabled Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id               String          @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  title            String
  objectiveId      String?
  campaignName     String?
  contentPillar    String?
  contentType      ContentType
  primaryMessage   String?
  targetAudienceId String?
  primaryCTA       String?
  destinationUrl   String?
  status           ContentStatus   @default(IDEA)
  priority         ContentPriority @default(NORMAL)
  ownerUserId      String
  createdByUserId  String
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  archivedAt       DateTime?

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  objective        MarketingObjective?      @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  targetAudience   BrandAudience?           @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  owner            UserProfile              @relation("ContentItemOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy        UserProfile              @relation("ContentItemCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       UserProfile?             @relation("ContentItemApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  variants         ContentVariant[]
  assets           ContentAsset[]
  revisions        ContentRevision[]
  approvals        ContentApproval[]
  comments         ContentComment[]
  provenance       ContentProvenance?
  complianceChecks ContentComplianceCheck[]
  statusHistory    ContentStatusHistory[]
  schedules        ContentSchedule[]

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([status])
  @@index([ownerUserId])
  @@index([createdByUserId])
  @@index([archivedAt])
  @@index([createdAt])
}

model ContentVariant {
  id               String         @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  contentItemId    String
  provider         SocialProvider
  socialAccountId  String?
  format           ContentType
  caption          String?
  headline         String?
  description      String?
  hashtags         String[]       @default([])
  mentions         String[]       @default([])
  destinationUrl   String?
  firstComment     String?
  altText          String?
  thumbnailAssetId String?
  durationSeconds  Int?
  aspectRatio      String?
  status           ContentStatus  @default(DRAFT)
  validationErrors Json?
  providerMetadata Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organisation     Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem      ContentItem              @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  socialAccount    SocialAccount?           @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  thumbnailAsset   MarketingAsset?          @relation("ContentVariantThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  comments         ContentComment[]
  complianceChecks ContentComplianceCheck[]
  visualAssets     ContentVariantAsset[]
  schedules        ContentSchedule[]
  tikTokSetting    TikTokPublishSetting?

  @@index([organisationId])
  @@index([projectId])
  @@index([brandId])
  @@index([contentItemId])
  @@index([provider])
  @@index([status])
}

model ContentAsset {
  id               String   @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  contentItemId    String
  marketingAssetId String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem    ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  marketingAsset MarketingAsset @relation(fields: [marketingAssetId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, marketingAssetId])
  @@index([organisationId])
  @@index([brandId])
}

model ContentRevision {
  id             String                @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  contentItemId  String
  revisionNumber Int
  changedFields  Json
  snapshot       Json
  editorUserId   String
  source         ContentRevisionSource @default(USER)
  changeNote     String?
  createdAt      DateTime              @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  editor       UserProfile  @relation("ContentRevisionEditor", fields: [editorUserId], references: [id], onDelete: Restrict)

  @@unique([contentItemId, revisionNumber])
  @@index([organisationId])
  @@index([contentItemId])
  @@index([createdAt])
}

model ContentApproval {
  id                String                  @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  contentItemId     String
  approvalMode      ContentApprovalMode
  decision          ContentApprovalDecision @default(PENDING)
  requestedByUserId String
  approverUserId    String?
  decisionNote      String?
  decidedAt         DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  requestedBy  UserProfile  @relation("ContentApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approver     UserProfile? @relation("ContentApprovalDecider", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([contentItemId])
  @@index([decision])
}

model ContentComment {
  id               String               @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  contentItemId    String
  contentVariantId String?
  authorUserId     String
  body             String
  status           ContentCommentStatus @default(OPEN)
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem    ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant? @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  author         UserProfile     @relation("ContentCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  resolvedBy     UserProfile?    @relation("ContentCommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([contentItemId])
  @@index([contentVariantId])
  @@index([status])
}

model ContentProvenance {
  id                      String    @id @default(cuid())
  organisationId          String
  projectId               String
  brandId                 String
  contentItemId           String    @unique
  createdManually         Boolean   @default(true)
  aiProvider              String?
  aiModel                 String?
  promptTemplateVersionId String?
  sourceAssetIds          String[]  @default([])
  sourceDocumentIds       String[]  @default([])
  musicLicence            String?
  imageLicence            String?
  voiceConsent            Boolean   @default(false)
  faceConsent             Boolean   @default(false)
  commercialUsePermission Boolean   @default(false)
  requiredAttribution     String?
  generatedAt             DateTime?
  metadata                Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([brandId])
}

model ContentComplianceCheck {
  id               String                     @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  contentItemId    String
  contentVariantId String?
  checkType        ContentComplianceCheckType
  result           ContentComplianceResult
  message          String
  blocking         Boolean                    @default(false)
  checkedAt        DateTime                   @default(now())
  metadata         Json?

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand          Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem    ContentItem     @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant? @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([contentItemId])
  @@index([checkType])
  @@index([result])
}

model ContentStatusHistory {
  id              String         @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  contentItemId   String
  fromStatus      ContentStatus?
  toStatus        ContentStatus
  changedByUserId String
  reason          String?
  createdAt       DateTime       @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem  ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  changedBy    UserProfile  @relation("ContentStatusChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([contentItemId])
  @@index([createdAt])
}
