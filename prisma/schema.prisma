/// Unified outbound publication record — all provider write operations flow through this model.
model Publication {
  id                    String                   @id @default(cuid())
  organisationId        String
  projectId             String
  brandId               String
  campaignId            String?
  contentItemId         String
  contentVariantId      String?
  connectionId          String
  providerKey           String
  externalAccountId     String
  destinationType       String
  destinationId         String
  operationType         PublicationOperationType
  status                PublicationStatus        @default(DRAFT)
  scheduledFor          DateTime?
  timezone              String                   @default("UTC")
  idempotencyKey        String
  externalPublicationId String?
  dryRun                Boolean                  @default(false)
  validationResult      Json?
  providerPayload       Json?
  approvedByUserId      String?
  approvedAt            DateTime?
  requestedByUserId     String
  lastErrorCode         String?
  lastErrorMessage      String?
  providerPermalink     String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  cancelledAt           DateTime?
  publishedAt           DateTime?

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentItem  ContentItem         @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  connection   ProviderConnection  @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  approvedBy   UserProfile?        @relation("PublicationApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  requestedBy  UserProfile         @relation("PublicationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  attempts     PublicationAttempt[]
  budgetChanges PublicationBudgetChange[]

  @@unique([organisationId, brandId, idempotencyKey])
  @@index([organisationId, brandId, status, updatedAt])
  @@index([connectionId, status])
  @@index([contentItemId])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
}

model PublicationAttempt {
  id                    String                   @id @default(cuid())
  publicationId         String
  attemptNumber         Int
  status                PublicationAttemptStatus @default(PENDING)
  dryRun                Boolean                  @default(false)
  providerResponse      Json?
  errorCode             String?
  errorMessageSafe      String?
  requestId             String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, attemptNumber])
  @@index([publicationId, createdAt])
}

/// Immutable record of provider-side budget changes linked to a publication operation.
model PublicationBudgetChange {
  id                 String   @id @default(cuid())
  publicationId      String
  organisationId     String
  brandId            String
  providerKey        String
  externalCampaignId String
  currency           String
  currentBudget      Decimal  @db.Decimal(18, 4)
  proposedBudget     Decimal  @db.Decimal(18, 4)
  percentageChange   Decimal  @db.Decimal(8, 4)
  requiresApproval   Boolean  @default(false)
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime @default(now())

  publication Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  approvedBy  UserProfile? @relation("PublicationBudgetApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([publicationId])
  @@index([organisationId, brandId])
}

