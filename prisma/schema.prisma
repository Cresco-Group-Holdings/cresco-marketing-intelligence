model SeoRankTrackingProject {
  id              String                       @id @default(cuid())
  organisationId  String
  projectId       String
  brandId         String
  seoSiteId       String
  name            String
  status          SeoRankTrackingProjectStatus @default(ACTIVE)
  keywordQuota    Int                          @default(100)
  keywordCount    Int                          @default(0)
  lastSyncAt      DateTime?
  lastSyncSource  SeoRankDataSource?
  lastSyncStatus  String?
  alertSettings   Json?
  createdByUserId String
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  organisation      Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project           Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand             Brand                        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite           SeoSite                      @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  createdBy         UserProfile                  @relation("SeoRankProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  trackedKeywords   SeoTrackedKeyword[]
  rankChanges       SeoRankChange[]
  refreshCandidates SeoContentRefreshCandidate[]

  @@index([organisationId, brandId, status])
  @@index([seoSiteId])
}

model SeoTrackedKeyword {
  id                String                  @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  trackingProjectId String
  keywordId         String?
  keyword           String
  targetPageId      String?
  country           String                  @default("US")
  language          String                  @default("en")
  device            SeoRankDevice           @default(ALL)
  schedule          SeoRankTrackingSchedule @default(WEEKLY)
  priority          Int                     @default(50)
  tags              String[]                @default([])
  status            SeoTrackedKeywordStatus @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand            Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trackingProject  SeoRankTrackingProject @relation(fields: [trackingProjectId], references: [id], onDelete: Cascade)
  seoKeyword       SeoKeyword?            @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  targetPage       SeoCrawlPage?          @relation(fields: [targetPageId], references: [id], onDelete: SetNull)
  observations     SeoRankObservation[]
  serpObservations SeoSerpObservation[]
  rankingUrls      SeoRankingUrl[]
  rankChanges      SeoRankChange[]

  @@unique([trackingProjectId, keyword, country, language, device])
  @@index([organisationId, brandId, status])
  @@index([trackingProjectId, priority])
}

model SeoRankObservation {
  id               String            @id @default(cuid())
  organisationId   String
  trackedKeywordId String
  source           SeoRankDataSource
  keyword          String
  location         String
  language         String
  device           SeoRankDevice
  observedDate     DateTime          @db.Date
  rank             Int?
  resultType       SeoRankResultType @default(ORGANIC)
  rankingUrlId     String?
  impressions      Int?
  clicks           Int?
  ctr              Float?
  providerMetadata Json?
  idempotencyKey   String?
  createdAt        DateTime          @default(now())

  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackedKeyword   SeoTrackedKeyword    @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  rankingUrl       SeoRankingUrl?       @relation(fields: [rankingUrlId], references: [id], onDelete: SetNull)
  serpObservations SeoSerpObservation[]

  @@unique([trackedKeywordId, source, observedDate, device, resultType])
  @@index([trackedKeywordId, observedDate])
  @@index([organisationId, observedDate])
}

model SeoSerpObservation {
  id               String   @id @default(cuid())
  organisationId   String
  trackedKeywordId String
  observationId    String?
  featureType      String
  position         Int?
  observedDate     DateTime @db.Date
  providerMetadata Json?
  createdAt        DateTime @default(now())

  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackedKeyword SeoTrackedKeyword   @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  observation    SeoRankObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)

  @@index([trackedKeywordId, observedDate])
}

model SeoRankingUrl {
  id               String   @id @default(cuid())
  organisationId   String
  trackedKeywordId String
  crawlPageId      String?
  url              String
  isTarget         Boolean  @default(false)
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackedKeyword SeoTrackedKeyword    @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  crawlPage      SeoCrawlPage?        @relation(fields: [crawlPageId], references: [id], onDelete: SetNull)
  observations   SeoRankObservation[]

  @@unique([trackedKeywordId, url])
  @@index([trackedKeywordId, isTarget])
}

model SeoRankChange {
  id                String            @id @default(cuid())
  organisationId    String
  trackingProjectId String
  trackedKeywordId  String
  changeType        SeoRankChangeType
  severity          String            @default("MEDIUM")
  previousRank      Int?
  currentRank       Int?
  previousUrl       String?
  currentUrl        String?
  evidence          Json
  isAlert           Boolean           @default(false)
  alertSentAt       DateTime?
  detectedAt        DateTime          @default(now())

  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trackingProject SeoRankTrackingProject @relation(fields: [trackingProjectId], references: [id], onDelete: Cascade)
  trackedKeyword  SeoTrackedKeyword      @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)

  @@index([trackingProjectId, isAlert, detectedAt])
  @@index([trackedKeywordId, changeType])
}

model SeoContentRefreshCandidate {
  id                String                           @id @default(cuid())
  organisationId    String
  projectId         String
  brandId           String
  trackingProjectId String?
  crawlPageId       String?
  url               String
  title             String?
  decayScore        Float
  signals           Json
  evidence          Json
  dateRangeStart    DateTime                         @db.Date
  dateRangeEnd      DateTime                         @db.Date
  status            SeoContentRefreshCandidateStatus @default(PENDING)
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  organisation    Organisation                      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project         Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand           Brand                             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trackingProject SeoRankTrackingProject?           @relation(fields: [trackingProjectId], references: [id], onDelete: SetNull)
  crawlPage       SeoCrawlPage?                     @relation(fields: [crawlPageId], references: [id], onDelete: SetNull)
  recommendations SeoContentRefreshRecommendation[]
  outcomes        SeoContentRefreshOutcome[]

  @@index([organisationId, brandId, status])
  @@index([trackingProjectId, decayScore])
}

model SeoContentRefreshRecommendation {
  id                 String                                @id @default(cuid())
  organisationId     String
  candidateId        String
  recommendationType SeoContentRefreshRecommendationType
  evidence           Json
  dateRangeStart     DateTime                              @db.Date
  dateRangeEnd       DateTime                              @db.Date
  confidence         Float
  expectedHypothesis String
  measurementPlan    String
  status             SeoContentRefreshRecommendationStatus @default(PENDING)
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  candidate    SeoContentRefreshCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  outcomes     SeoContentRefreshOutcome[]

  @@index([candidateId, status])
  @@index([organisationId, recommendationType])
}

model SeoContentRefreshOutcome {
  id               String                         @id @default(cuid())
  organisationId   String
  candidateId      String
  recommendationId String?
  workflowType     SeoContentRefreshWorkflowType
  workflowRefId    String?
  status           SeoContentRefreshOutcomeStatus @default(CREATED)
  outcomeData      Json?
  implementedAt    DateTime?
  measuredAt       DateTime?
  createdByUserId  String
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  organisation   Organisation                     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  candidate      SeoContentRefreshCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recommendation SeoContentRefreshRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  createdBy      UserProfile                      @relation("SeoRefreshOutcomeCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([candidateId, workflowType])
  @@index([organisationId, status])
}

