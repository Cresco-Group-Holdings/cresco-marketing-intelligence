  contentHash     String?
  title           String?
  description     String?
  canonicalUrl    String?
  robotsDirective String?
  lang            String?
  wordCount       Int?
  headings        Json?
  openGraph       Json?
  twitterCard     Json?
  redirectChain   Json?
  extractedAt     DateTime @default(now())
  parserVersion   String   @default("1.0")
  rawReference    String?
  createdAt       DateTime @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  crawlRun     SeoCrawlRun         @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  page         SeoCrawlPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  links        SeoCrawlLink[]
  structuredData SeoStructuredDataItem[]
  issues       SeoCrawlIssue[]

  @@index([crawlRunId])
  @@index([pageId, createdAt])
}

model SeoCrawlLink {
  id                String      @id @default(cuid())
  organisationId    String
  seoSiteId         String
  crawlRunId        String
  snapshotId        String?
  sourcePageId      String
  destinationPageId String?
  sourceUrl         String
  destinationUrl    String
  linkType          SeoLinkType
  anchorText        String?
  rel               String?
  isFollowed        Boolean     @default(true)
  isImageLink       Boolean     @default(false)
  statusCode        Int?
  firstSeenAt       DateTime    @default(now())
  lastSeenAt        DateTime    @default(now())

  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  crawlRun        SeoCrawlRun    @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)
  snapshot        SeoPageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  sourcePage      SeoCrawlPage   @relation("SourcePage", fields: [sourcePageId], references: [id], onDelete: Cascade)
  destinationPage SeoCrawlPage?  @relation("DestinationPage", fields: [destinationPageId], references: [id], onDelete: SetNull)

  @@index([crawlRunId, linkType])
  @@index([sourcePageId])
