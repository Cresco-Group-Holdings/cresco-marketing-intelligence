model SeoSite {
  id                 String        @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  trackingPropertyId String?
  name               String
  primaryDomain      String
  preferredProtocol  String        @default("https")
  defaultLocale      String?
  defaultTimezone    String?
  status             SeoSiteStatus @default(VERIFICATION_REQUIRED)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation       Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand              Brand                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  trackingProperty   TrackingProperty?     @relation(fields: [trackingPropertyId], references: [id], onDelete: SetNull)
  domains            SeoSiteDomain[]
  crawlConfiguration SeoCrawlConfiguration?
  crawlRuns          SeoCrawlRun[]
  crawlPages         SeoCrawlPage[]
  crawlIssues        SeoCrawlIssue[]
  robotsSnapshots    SeoRobotsSnapshot[]
  sitemaps           SeoSitemap[]
  keywords           SeoKeyword[]

  @@unique([brandId, primaryDomain])
  @@index([organisationId, brandId])
  @@index([status])
}

model SeoSiteDomain {
  id                 String                      @id @default(cuid())
