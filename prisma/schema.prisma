model SeoCrawlRun {
  id               String            @id @default(cuid())
  organisationId   String
  projectId        String
  brandId          String
  seoSiteId        String
  status           SeoCrawlRunStatus @default(QUEUED)
  idempotencyKey   String            @unique
  pagesDiscovered  Int               @default(0)
  pagesCrawled     Int               @default(0)
  pagesBlocked     Int               @default(0)
  issuesFound      Int               @default(0)
  attemptCount     Int               @default(0)
  maxAttempts      Int               @default(3)
  nextRetryAt      DateTime?
  startedAt        DateTime?
  heartbeatAt      DateTime?
  leaseExpiresAt   DateTime?
  workerId         String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  lastError        String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  seoSite      SeoSite              @relation(fields: [seoSiteId], references: [id], onDelete: Cascade)
  createdBy    UserProfile?         @relation("SeoCrawlRunCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
