// ---------------------------------------------------------------------------
// Source registry
// ---------------------------------------------------------------------------

model MarketingDataSource {
  id               String                    @id @default(cuid())
  provider         MarketingDataProvider
  key              String                    @unique
  displayName      String
  description      String?
  category         String?
  isConnected      Boolean                   @default(false)
  documentationUrl String?
  status           MarketingDataSourceStatus @default(ACTIVE)
  metadata         Json?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  accounts     MarketingDataSourceAccount[]
  capabilities MarketingDataSourceCapability[]
  fields       MarketingDataSourceField[]
  schemaVersions RawMarketingSchemaVersion[]

  @@index([provider])
  @@index([status])
}

model MarketingDataSourceAccount {
  id                    String                    @id @default(cuid())
  organisationId        String
  projectId             String
  brandId               String
  marketingDataSourceId String
  connectorAccountId    String?
  externalAccountId     String?
  displayName           String?
  currency              String?
  timezone              String?
  status                MarketingDataSourceStatus @default(ACTIVE)
  lastSyncAt            DateTime?
  lastSyncStatus        RawMarketingBatchStatus?
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  organisation         Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                Brand                     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSource  MarketingDataSource       @relation(fields: [marketingDataSourceId], references: [id], onDelete: Restrict)
  connectorAccount     ConnectorAccount?         @relation(fields: [connectorAccountId], references: [id], onDelete: SetNull)
  healthRecords        MarketingDataSourceHealth[]
  rawBatches           RawMarketingBatch[]
  rawRecords           RawMarketingRecord[]
  channels             MarketingChannel[]
  accounts             MarketingAccount[]
  campaigns            MarketingCampaign[]
  adGroups             MarketingAdGroup[]
  ads                  MarketingAd[]
  creatives            MarketingCreative[]
  contentItems         MarketingContentItem[]
  audiences            MarketingAudience[]
  metricObservations   MarketingMetricObservation[]
  metricCorrections    MarketingMetricCorrection[]
  events               MarketingEvent[]
  sessions             MarketingSession[]
  revenueRecords       MarketingRevenueRecord[]
  costRecords          MarketingCostRecord[]
  manualImportJobs     ManualImportJob[]
  marketingSearchQueries MarketingSearchQuery[]
  marketingLandingPages  MarketingLandingPage[]
  marketingGeographies   MarketingGeography[]
  marketingDevices       MarketingDevice[]

  @@unique([brandId, marketingDataSourceId, externalAccountId])
  @@index([organisationId, brandId])
  @@index([projectId])
  @@index([connectorAccountId])
  @@index([status])
}

model MarketingDataSourceCapability {
  id                    String                            @id @default(cuid())
  marketingDataSourceId String
  capabilityType        MarketingDataSourceCapabilityType
  enabled               Boolean                           @default(true)
  description           String?
  metadata              Json?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt

  marketingDataSource MarketingDataSource @relation(fields: [marketingDataSourceId], references: [id], onDelete: Cascade)

  @@unique([marketingDataSourceId, capabilityType])
  @@index([marketingDataSourceId])
}

model MarketingDataSourceField {
  id                    String              @id @default(cuid())
  marketingDataSourceId String
  fieldKey              String
  displayName           String
  dataType              String
  isRequired            Boolean             @default(false)
  isDimension           Boolean             @default(false)
  isMetric              Boolean             @default(false)
  description           String?
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  marketingDataSource MarketingDataSource @relation(fields: [marketingDataSourceId], references: [id], onDelete: Cascade)

  @@unique([marketingDataSourceId, fieldKey])
  @@index([marketingDataSourceId])
}

model MarketingDataSourceHealth {
  id                           String                        @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String
  status                       MarketingDataSourceHealthStatus @default(UNKNOWN)
  freshnessLagMinutes          Int?
  lastSuccessfulSyncAt         DateTime?
  lastCheckedAt                DateTime                      @default(now())
  errorMessage                 String?
  metadata                     Json?
  createdAt                    DateTime                      @default(now())

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: Cascade)

  @@index([organisationId, brandId, lastCheckedAt])
  @@index([marketingDataSourceAccountId, lastCheckedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Raw ingestion layer
// ---------------------------------------------------------------------------

model RawMarketingSchemaVersion {
  id                    String              @id @default(cuid())
  marketingDataSourceId String
  version               String
  schemaHash            String?
  schemaDefinition      Json
  isActive              Boolean             @default(true)
  effectiveFrom         DateTime            @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime            @default(now())

  marketingDataSource MarketingDataSource @relation(fields: [marketingDataSourceId], references: [id], onDelete: Cascade)
  rawRecords          RawMarketingRecord[]

  @@unique([marketingDataSourceId, version])
  @@index([marketingDataSourceId, isActive])
}

model RawMarketingBatch {
  id                           String                    @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String
  provider                     MarketingDataProvider
  status                       RawMarketingBatchStatus   @default(QUEUED)
  syncType                     RawMarketingBatchSyncType
  idempotencyKey               String                    @unique
  cursor                       Json?
  attemptCount                 Int                       @default(0)
  maxAttempts                  Int                       @default(3)
  scheduledFor                 DateTime?
  nextRetryAt                  DateTime?
  startedAt                    DateTime?
  heartbeatAt                  DateTime?
  leaseExpiresAt               DateTime?
  workerId                     String?
  completedAt                  DateTime?
  backfillFrom                 DateTime?
  backfillTo                   DateTime?
  recordsReceived              Int                       @default(0)
  recordsProcessed             Int                       @default(0)
  recordsFailed                Int                       @default(0)
  lastError                    String?
  metadata                     Json?
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: Cascade)
  rawRecords                 RawMarketingRecord[]
  transformationRuns         DataTransformationRun[]
  dataQualityChecks          DataQualityCheck[]

  @@index([organisationId, brandId])
  @@index([marketingDataSourceAccountId, status])
  @@index([scheduledFor])
  @@index([status, leaseExpiresAt])
  @@index([status, nextRetryAt])
}

model RawMarketingRecord {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String
  rawMarketingBatchId          String?
  schemaVersionId              String?
  provider                     MarketingDataProvider
  providerRecordId             String
  recordType                   String
  status                       RawMarketingRecordStatus @default(RECEIVED)
  receivedAt                   DateTime                 @default(now())
  eventTime                    DateTime?
  idempotencyKey               String                   @unique
  checksum                     String?
  inlinePayload                Json?
  payloadReferenceId           String?
  metadata                     Json?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount  @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: Cascade)
  rawMarketingBatch          RawMarketingBatch?          @relation(fields: [rawMarketingBatchId], references: [id], onDelete: SetNull)
  schemaVersion              RawMarketingSchemaVersion?  @relation(fields: [schemaVersionId], references: [id], onDelete: SetNull)
  payloadReference           RawMarketingPayloadReference? @relation(fields: [payloadReferenceId], references: [id], onDelete: SetNull)
  lineageRecords             DataLineageRecord[]

  @@unique([marketingDataSourceAccountId, providerRecordId, recordType])
  @@index([organisationId, brandId, receivedAt])
  @@index([rawMarketingBatchId])
  @@index([provider, recordType])
  @@index([status])
  @@index([eventTime])
}

model RawMarketingPayloadReference {
  id             String                         @id @default(cuid())
  organisationId String
  projectId      String
  brandId        String
  storageType    RawMarketingPayloadStorageType @default(OBJECT_STORAGE)
  storagePath    String
  byteSize       Int?
  contentType    String?
  checksum       String?
  metadata       Json?
  createdAt      DateTime                       @default(now())

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand        Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  rawRecords   RawMarketingRecord[]

  @@index([organisationId, brandId])
  @@index([storagePath])
}

// ---------------------------------------------------------------------------
// Dimension models
// ---------------------------------------------------------------------------

model MarketingChannel {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  provider                     MarketingDataProvider
  providerChannelId            String
  name                         String
  channelType                  String?
  status                       MarketingDimensionStatus @default(ACTIVE)
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  campaigns                  MarketingCampaign[]
  contentItems               MarketingContentItem[]
  classifications            MarketingChannelClassification[]
  metricObservations         MarketingMetricObservation[]
  costRecords                MarketingCostRecord[]

  @@unique([brandId, provider, providerChannelId])
  @@index([organisationId, brandId])
  @@index([marketingDataSourceAccountId])
  @@index([status])
  @@map("WarehouseMarketingChannel")
}

model MarketingAccount {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  provider                     MarketingDataProvider
  providerAccountId            String
  name                         String
  currency                     String?
  timezone                     String?
  status                       MarketingDimensionStatus @default(ACTIVE)
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  campaigns                  MarketingCampaign[]
  metricObservations         MarketingMetricObservation[]
  costRecords                MarketingCostRecord[]
  revenueRecords             MarketingRevenueRecord[]

  @@unique([brandId, provider, providerAccountId])
  @@index([organisationId, brandId])
  @@index([marketingDataSourceAccountId])
  @@index([status])
}

model MarketingCampaign {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  marketingAccountId           String?
  marketingChannelId           String?
  provider                     MarketingDataProvider
  providerCampaignId           String
  name                         String
  status                       MarketingDimensionStatus @default(ACTIVE)
  campaignType                 String?
  startDate                    DateTime?
  endDate                      DateTime?
  budgetAmount                 Decimal?                 @db.Decimal(24, 6)
  budgetCurrency               String?
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  marketingAccount           MarketingAccount?          @relation(fields: [marketingAccountId], references: [id], onDelete: SetNull)
  marketingChannel           MarketingChannel?          @relation(fields: [marketingChannelId], references: [id], onDelete: SetNull)
  adGroups                   MarketingAdGroup[]
  metricObservations         MarketingMetricObservation[]
  costRecords                MarketingCostRecord[]

  @@unique([brandId, provider, providerCampaignId])
  @@index([organisationId, brandId])
  @@index([marketingAccountId])
  @@index([marketingChannelId])
  @@index([status])
  @@index([startDate, endDate])
}

model MarketingAdGroup {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  marketingCampaignId          String?
  provider                     MarketingDataProvider
  providerAdGroupId            String
  name                         String
  status                       MarketingDimensionStatus @default(ACTIVE)
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  marketingCampaign          MarketingCampaign?         @relation(fields: [marketingCampaignId], references: [id], onDelete: SetNull)
  ads                        MarketingAd[]
  metricObservations         MarketingMetricObservation[]
  costRecords                MarketingCostRecord[]

  @@unique([brandId, provider, providerAdGroupId])
  @@index([organisationId, brandId])
  @@index([marketingCampaignId])
  @@index([status])
}

model MarketingAd {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  marketingAdGroupId           String?
  contentItemId                String?
  contentVariantId             String?
  marketingAssetId             String?
  provider                     MarketingDataProvider
  providerAdId                 String
  name                         String?
  status                       MarketingDimensionStatus @default(ACTIVE)
  adType                       String?
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  marketingAdGroup           MarketingAdGroup?          @relation(fields: [marketingAdGroupId], references: [id], onDelete: SetNull)
  contentItem                ContentItem?               @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  contentVariant             ContentVariant?            @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  marketingAsset             MarketingAsset?            @relation(fields: [marketingAssetId], references: [id], onDelete: SetNull)
  metricObservations         MarketingMetricObservation[]
  costRecords                MarketingCostRecord[]
  creatives                  MarketingCreative[]

  @@unique([brandId, provider, providerAdId])
