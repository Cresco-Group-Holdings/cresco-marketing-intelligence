  crawlRun        SeoCrawlRun?                 @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)
  nodes           InternalLinkNode[]
  edges           InternalLinkEdge[]
  snapshots       InternalLinkSnapshot[]
  recommendations InternalLinkRecommendation[]
  anchors         InternalLinkAnchor[]
  issues          InternalLinkIssue[]
  changeProposals InternalLinkChangeProposal[]

  @@index([organisationId, brandId, status])
  @@index([seoSiteId])
}

model InternalLinkNode {
  id                 String   @id @default(cuid())
  organisationId     String
  graphId            String
  crawlPageId        String?
  url                String
  title              String?
  pageType           String?
  isIndexable        Boolean  @default(true)
  crawlDepth         Int?
  incomingCount      Int      @default(0)
  outgoingCount      Int      @default(0)
  isOrphan           Boolean  @default(false)
  isNearOrphan       Boolean  @default(false)
  clusterId          String?
  topicalConnections Int      @default(0)
  metrics            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organisation          Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph                 InternalLinkGraph            @relation(fields: [graphId], references: [id], onDelete: Cascade)
  crawlPage             SeoCrawlPage?                @relation(fields: [crawlPageId], references: [id], onDelete: SetNull)
  cluster               SeoTopicCluster?             @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  outgoingEdges         InternalLinkEdge[]           @relation("EdgeSource")
  incomingEdges         InternalLinkEdge[]           @relation("EdgeTarget")
  anchors               InternalLinkAnchor[]
  sourceRecommendations InternalLinkRecommendation[] @relation("RecSource")
  targetRecommendations InternalLinkRecommendation[] @relation("RecTarget")
  issues                InternalLinkIssue[]

  @@unique([graphId, url])
  @@index([graphId, isOrphan])
  @@index([graphId, crawlDepth])
}

model InternalLinkEdge {
  id              String                  @id @default(cuid())
  organisationId  String
  graphId         String
  sourceNodeId    String
  targetNodeId    String?
  targetUrl       String
  anchorText      String?
  anchorType      InternalLinkAnchorType?
  isFollowed      Boolean                 @default(true)
  statusCode      Int?
  isBroken        Boolean                 @default(false)
  isRedirect      Boolean                 @default(false)
  isNoindexTarget Boolean                 @default(false)
  isObsolete      Boolean                 @default(false)
  createdAt       DateTime                @default(now())

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph        InternalLinkGraph   @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode   InternalLinkNode    @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   InternalLinkNode?   @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: SetNull)
  issues       InternalLinkIssue[]

  @@index([graphId, sourceNodeId])
  @@index([graphId, targetNodeId])
}

model InternalLinkSnapshot {
  id             String   @id @default(cuid())
  organisationId String
  graphId        String
  versionNumber  Int
  nodeCount      Int
  edgeCount      Int
  metrics        Json?
  createdAt      DateTime @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph        InternalLinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)

  @@unique([graphId, versionNumber])
  @@index([graphId, createdAt])
}

model InternalLinkRecommendation {
  id                     String                           @id @default(cuid())
  organisationId         String
  graphId                String
  sourceNodeId           String
  targetNodeId           String
  suggestedAnchorConcept String
  contextualReason       String
  confidence             Float
  evidence               Json
  potentialConflict      String?
  status                 InternalLinkRecommendationStatus @default(PENDING)
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt

  organisation    Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph           InternalLinkGraph            @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode      InternalLinkNode             @relation("RecSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      InternalLinkNode             @relation("RecTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  changeProposals InternalLinkChangeProposal[]

  @@index([graphId, status])
  @@index([graphId, confidence])
}

model InternalLinkAnchor {
  id              String                 @id @default(cuid())
  organisationId  String
  graphId         String
  nodeId          String?
  anchorText      String
  classification  InternalLinkAnchorType
  occurrenceCount Int                    @default(1)
  isRepetitive    Boolean                @default(false)
  createdAt       DateTime               @default(now())

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph        InternalLinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  node         InternalLinkNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([graphId, classification])
  @@index([graphId, isRepetitive])
}

model InternalLinkIssue {
  id             String                  @id @default(cuid())
  organisationId String
  graphId        String
  issueType      InternalLinkIssueType
  severity       String                  @default("MEDIUM")
  title          String
  description    String
  evidence       Json
  status         InternalLinkIssueStatus @default(OPEN)
  sourceNodeId   String?
  targetNodeId   String?
  edgeId         String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph        InternalLinkGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode   InternalLinkNode? @relation(fields: [sourceNodeId], references: [id], onDelete: SetNull)
  edge         InternalLinkEdge? @relation(fields: [edgeId], references: [id], onDelete: SetNull)

  @@index([graphId, issueType, status])
}

model InternalLinkChangeProposal {
  id                  String                           @id @default(cuid())
  organisationId      String
  graphId             String
  recommendationId    String?
  status              InternalLinkChangeProposalStatus @default(DRAFT)
  editedAnchorConcept String?
  assignedToUserId    String?
  exportPayload       Json?
  implementedAt       DateTime?
  verifiedAt          DateTime?
  createdByUserId     String
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  organisation   Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  graph          InternalLinkGraph           @relation(fields: [graphId], references: [id], onDelete: Cascade)
  recommendation InternalLinkRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  assignedTo     UserProfile?                @relation("InternalLinkProposalAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy      UserProfile                 @relation("InternalLinkProposalCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([graphId, status])
