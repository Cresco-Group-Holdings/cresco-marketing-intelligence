model MarketingCreative {
  id                           String                   @id @default(cuid())
  organisationId               String
  projectId                    String
  brandId                      String
  marketingDataSourceAccountId String?
  marketingAdId                String?
  provider                     MarketingDataProvider
  providerCreativeId           String
  name                         String?
  creativeType                 String?
  status                       MarketingDimensionStatus @default(ACTIVE)
  providerMetadata             Json?
  firstSeenAt                  DateTime?
  lastSeenAt                   DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  organisation               Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand                      Brand                      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingDataSourceAccount MarketingDataSourceAccount? @relation(fields: [marketingDataSourceAccountId], references: [id], onDelete: SetNull)
  marketingAd                MarketingAd?               @relation(fields: [marketingAdId], references: [id], onDelete: SetNull)
  metricObservations         MarketingMetricObservation[]
  creativeMappings           PaidAdsCreativeMapping[]

  @@unique([brandId, provider, providerCreativeId])
  @@index([organisationId, brandId])
  @@index([marketingAdId])
  @@index([status])
}

model PaidAdsCreativeMapping {
  id                 String                    @id @default(cuid())
  organisationId     String
  projectId          String
  brandId            String
  provider           MarketingDataProvider
  providerCreativeId String
  providerAdId       String?
  marketingCreativeId String?
  contentItemId      String?
  contentVariantId   String?
  marketingAssetId   String?
  mappingSource      PaidAdsCreativeMappingSource
  mappingKey         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  marketingCreative MarketingCreative? @relation(fields: [marketingCreativeId], references: [id], onDelete: SetNull)
  contentItem       ContentItem?       @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  contentVariant    ContentVariant?    @relation(fields: [contentVariantId], references: [id], onDelete: SetNull)
  marketingAsset    MarketingAsset?    @relation(fields: [marketingAssetId], references: [id], onDelete: SetNull)

  @@unique([brandId, provider, providerCreativeId])
  @@index([organisationId, brandId])
  @@index([contentItemId])
  @@index([contentVariantId])
  @@index([marketingAssetId])
}

