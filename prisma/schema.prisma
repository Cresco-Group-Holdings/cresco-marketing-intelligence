  status           CrmDuplicateCandidateStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                    @default(now())

  reviewedBy UserProfile? @relation("CrmDuplicateReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([sourceRecordId, targetRecordId])
}

model CrmMergeOperation {
  id                    String                  @id @default(cuid())
  organisationId        String
  sourceRecordType      String
  sourceRecordId        String
  destinationRecordType String
  destinationRecordId   String
  fieldConflicts        Json?
  status                CrmMergeOperationStatus @default(PENDING)
