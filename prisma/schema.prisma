  PENDING
  VERIFIED
  FAILED
}

enum SeoDomainVerificationMethod {
  DNS_TXT
  HTML_FILE
  META_TAG
  TRACKING_PROPERTY
  SEARCH_CONSOLE
}

enum SeoCrawlRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum SeoCrawlQueueItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

