  FINANCIAL
  GRANTS
  PRIVACY
  COPYRIGHT
  LICENSING
  PLATFORM
  ACCESSIBILITY
  ADVERTISING
  AI_DISCLOSURE
}

enum ComplianceRiskLevel {
  INFO
  LOW
  MEDIUM
  HIGH
  BLOCKING
}

enum ComplianceEvaluationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ComplianceFindingSource {
  DETERMINISTIC
  AI
}

enum ComplianceFindingStatus {
  OPEN
  OVERRIDDEN
  DISMISSED
  RESOLVED
}

enum ComplianceEvaluationSource {
  DETERMINISTIC
  AI
  COMBINED
}

model CompliancePolicy {
  id                    String                   @id @default(cuid())
  organisationId        String
  projectId             String?
  brandId               String?
  name                  String
  slug                  String
  category              CompliancePolicyCategory
  version               Int                      @default(1)
  isTemplate            Boolean                  @default(false)
  templateKey           String?
  isActive              Boolean                  @default(true)
  description           String?
  effectiveFrom         DateTime                 @default(now())
  effectiveTo           DateTime?
  supersededByPolicyId  String?
  createdByUserId       String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brand              Brand?                 @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy          UserProfile            @relation("CompliancePolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  rules              ComplianceRule[]
  requiredDisclaimers RequiredDisclaimer[]
  evaluations        ComplianceEvaluation[]
  overrides          ComplianceOverride[]

  @@unique([organisationId, slug, version])
  @@index([organisationId, brandId, isActive])
  @@index([templateKey])
}

model ComplianceRule {
  id             String                  @id @default(cuid())
  policyId       String
  ruleKey        String
  category       CompliancePolicyCategory
  title          String
  description    String?
  riskLevel      ComplianceRiskLevel       @default(MEDIUM)
  isBlocking     Boolean                   @default(false)
  canOverride    Boolean                   @default(true)
  matchPattern   String?
  ruleConfig     Json?
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  policy   CompliancePolicy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  findings ComplianceFinding[]

  @@unique([policyId, ruleKey])
  @@index([policyId, category])
}

model RequiredDisclaimer {
  id                    String   @id @default(cuid())
  policyId              String
  disclaimerText        String
  appliesToCategories   String[] @default([])
  appliesToContentTypes String[] @default([])
  isBlocking            Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  policy CompliancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model ComplianceEvaluation {
  id                String                     @id @default(cuid())
